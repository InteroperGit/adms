{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@shared": ["../shared"],
      "@shared/*": ["../shared/*"],
      "@data/*": ["data/config/*"],
      "@src/*": ["src/*"]
    }
  },
  "include": ["src", "../shared", "data/config"]
}
