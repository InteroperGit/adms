{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@shared": ["../shared/src"],
      "@shared/*": ["../shared/src/*"],
      "@data/*": ["data/config/*"],
      "@src/*": ["src/*"]
    }
  },
  "references": [
    { "path": "../shared" }
  ],
  "include": ["src"],
  "exclude": ["**/*.test.ts", "**/*.test.js", "**/__tests__"]
}
