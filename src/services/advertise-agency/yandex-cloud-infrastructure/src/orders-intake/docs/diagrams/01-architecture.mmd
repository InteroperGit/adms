flowchart LR
    Browser["Browser\n(POST /order)"]
    APG["Yandex API Gateway"]
    Lambda["Lambda: orders-intake\n(index.ts)"]
    Captcha["Yandex SmartCaptcha\nsmartcaptcha.cloud.yandex.ru"]
    SQS["Yandex Message Queue\n(SQS-compatible)"]
    Consumer["Lambda: dispatch-queue-messages\n(SQS consumer)"]
    Shared["../../shared/\nlogger, response, types"]

    Browser -->|"POST {captchaToken, order}"| APG
    APG -->|"API Gateway Event"| Lambda
    Lambda -->|"POST {secret, token, ip}"| Captcha
    Captcha -->|"{status: ok or fail}"| Lambda
    Lambda -->|"SendMessageCommand"| SQS
    SQS -->|"poll"| Consumer
    Lambda -.->|"imports"| Shared

    classDef service fill:#e1f5fe,stroke:#0288d1,stroke-width:2px
