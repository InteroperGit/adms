{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "outDir": "dist",
    "paths": {
      "@shared": ["../shared/src"],
      "@shared/*": ["../shared/src/*"],
      "@src/*": ["src/*"]
    },
  },
  "references": [
    { "path": "../shared" }  // ссылка на shared проект
  ],
  "include": ["src"],
  "exclude": ["**/*.test.ts", "**/*.test.js", "**/__tests__"]
}
