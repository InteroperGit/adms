{
  "kind": "collectionType",
  "collectionName": "project_articles",
  "info": {
    "singularName": "project-article",
    "pluralName": "project-articles",
    "displayName": "ProjectArticle",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "slug": {
      "type": "uid"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "author": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::author.author"
    },
    "category": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::service-category.service-category"
    },
    "publishDate": {
      "type": "date"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "shared.video",
        "shared.slider",
        "shared.rich-text",
        "shared.quote",
        "shared.media",
        "shared.form",
        "shared.embed",
        "shared.divider",
        "shared.project-articles-ref"
      ]
    }
  }
}
