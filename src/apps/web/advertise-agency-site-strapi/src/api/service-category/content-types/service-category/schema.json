{
  "kind": "collectionType",
  "collectionName": "service_categories",
  "info": {
    "singularName": "service-category",
    "pluralName": "service-categories",
    "displayName": "ServiceCategory",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "uid"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "href": {
      "type": "string"
    },
    "order": {
      "type": "integer"
    },
    "isHeader": {
      "type": "boolean"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::service-category.service-category",
      "mappedBy": "parent"
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::service-category.service-category",
      "inversedBy": "items"
    }
  }
