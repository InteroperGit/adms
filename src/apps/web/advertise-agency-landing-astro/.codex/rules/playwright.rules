# Allow Playwright tooling for this trusted project.
prefix_rule(
    pattern = [
        ["npx", "npx.cmd"],
        "--yes",
        "--package",
        "@playwright/cli",
        "playwright-cli",
    ],
    decision = "allow",
    match = [
        "npx.cmd --yes --package @playwright/cli playwright-cli --help",
    ],
    not_match = [
        "npx.cmd --yes --package other-package playwright-cli --help",
    ],
)

prefix_rule(
    pattern = [["npx", "npx.cmd"], "playwright"],
    decision = "allow",
    match = ["npx playwright --help", "npx.cmd playwright --help"],
    not_match = ["npx other-package", "npx.cmd other-package"],
)

prefix_rule(
    pattern = [["npx", "npx.cmd"], "--yes", "playwright"],
    decision = "allow",
    match = ["npx --yes playwright --help"],
    not_match = ["npx --yes other-package"],
)
