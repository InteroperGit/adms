{
  "name": "advertise-agency-landing-astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && node scripts/check-code-style.mjs",
    "check:style": "node scripts/check-code-style.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit src/scripts src/server",
    "test:components": "vitest run tests/components src/components",
    "verify:component-tests": "node scripts/check-component-tests.mjs",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:types": "tsc --noEmit --project tsconfig.type-contracts.json",
    "test:coverage": "vitest run --coverage",
    "verify:coverage": "node scripts/verify-coverage-thresholds.mjs",
    "verify:content": "node scripts/verify-content-invariants.mjs",
    "verify:boundaries": "node scripts/verify-content-boundaries.mjs",
    "generate:content": "node scripts/generate-content-catalog.mjs",
    "test:content-catalog": "node scripts/test-content-catalog.mjs",
    "test:content-blocks": "node scripts/test-content-block-fixtures.mjs",
    "test:service-articles": "node scripts/test-service-articles.mjs",
    "test:project-articles": "node scripts/test-project-articles.mjs",
    "test:publication-policy": "node scripts/test-publication-policy.mjs",
    "verify:quality": "node scripts/verify-built-quality.mjs",
    "build": "astro build",
    "verify:external": "node scripts/verify-external-assets.mjs",
    "verify:release": "node scripts/verify-release-metadata.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/mdx": "^8.0.3",
    "astro": "^7.3.5",
    "echarts": "^6.1.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "4.0.18",
    "daisyui": "^5.7.25",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.6.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "4.0.18"
  }
}
