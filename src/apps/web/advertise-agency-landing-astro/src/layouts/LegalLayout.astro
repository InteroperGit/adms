---
// Render a validated legal document inside the shared site layout.
// The optional title overrides metadata only, not the visible heading.
// Document sections retain their supplied order, dates and list content.

import Layout from '@/layouts/Layout.astro';
import type { LegalDocument } from '@/types';

// Caller-supplied data and presentation options for this component.
export interface Props {
  document: LegalDocument;
  title?: string;
  // Opt in to a mobile return link; other legal documents keep their layout.
  showMobileBackLink?: boolean;
}

const { document, title, showMobileBackLink = false } = Astro.props;
---

{/* Document sections retain their supplied order, dates and list content. */}
<Layout title={title || document.title} description={document.description}>
  <div class="site-container site-section">
    <article class="legal-document">
      {/* The native home fallback also works without browser scripts. */}
      {showMobileBackLink && (
        <a class="legal-back" href="/" data-legal-back>
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M19 12H5m7-7-7 7 7 7" />
          </svg>
          Назад
        </a>
      )}
      <h1>{document.title}</h1>
      {document.effectiveDate && (
        <p class="legal-date">
          <strong>Дата вступления в силу:</strong> {document.effectiveDate}
        </p>
      )}

      {/* Keep supplied legal topics and optional lists in document order. */}
      {document.sections.map((section) => {
        return (
          <section>
            <h2>{section.heading}</h2>
            {section.content && <p>{section.content}</p>}
            {section.list && (
              <ul>
                {section.list.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </section>
        );
      })}
    </article>
  </div>
</Layout>

<script>
  // Only same-site arrivals use history, preserving the previous page/anchor.
  // Direct/external visits retain the native home link, including without JS.
  const back = document.querySelector<HTMLAnchorElement>('[data-legal-back]');
  if (back) {
    back.addEventListener('click', (event) => {
      // Preserve opening the fallback link in another tab/window.
      if (event.button !== 0 || event.ctrlKey || event.metaKey ||
        event.shiftKey || event.altKey) return;
      if (!document.referrer || window.history.length < 2) return;
      try {
        if (new URL(document.referrer).origin !== window.location.origin) {
          return;
        }
        event.preventDefault();
        window.history.back();
      } catch {
        // An unusable referrer must not prevent normal link navigation.
      }
    });
  }
</script>

<style>
  /* Wide navigation already provides a home route without an extra link. */
  .legal-back {
    display: none;
  }

  /* Offer a clear return target where primary navigation is in the drawer. */
  @media (max-width: 63.999rem) {
    /* Align the arrow with a readable, generously sized native link. */
    .legal-back {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 2.75rem;
      margin-bottom: 1.5rem;
    }

    /* Keep the directional icon intact alongside enlarged link text. */
    .legal-back svg {
      flex: 0 0 auto;
    }
  }

  /* Constrain legal copy to the shared reading measure. */
  .legal-document {
    max-width: var(--site-reading-width);
    margin-inline: auto;
    overflow-wrap: anywhere;
  }

  /* Maintain the primary document heading and readable responsive scale. */
  h1 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    margin-bottom: 1.5rem;
    line-height: 1.2;
  }

  /* Separate document sections with a clear secondary heading hierarchy. */
  h2 {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 650;
    line-height: 1.35;
    margin-bottom: 1rem;
  }

  /* Separate document topics with a consistent reading rhythm. */
  section {
    margin-top: 2.5rem;
  }

  /* Give longer document paragraphs comfortable reading line spacing. */
  p {
    line-height: 1.75;
  }

  /* Distinguish the effective date without reducing readability. */
  .legal-date {
    color: var(--site-muted);
  }

  /* Preserve visible list markers and indentation for parallel points. */
  ul {
    list-style: disc;
    padding-inline-start: 1.5rem;
    margin-top: 1rem;
  }

  /* Indent legal list items without crowding their readable line spacing. */
  li {
    padding-inline-start: 0.25rem;
    line-height: 1.75;
  }

  /* Separate list entries for easier scanning of legal copy. */
  li + li {
    margin-top: 0.75rem;
  }

  /* Retain a persistent underline and room to target native links. */
  a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
