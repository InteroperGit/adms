---
// Compose the homepage in editorial order inside the shared site layout.
// Alternate surfaces by rendered section order, including optional offers.
// Each section owns its content and any narrowly scoped browser behavior.

import Layout from '@/layouts/Layout.astro';
import About from '@/components/sections/About.astro';
import Services from '@/components/sections/Services.astro';
import Introduction from '@/components/sections/Introduction.astro';
import OffersCarousel from '@/components/sections/OffersCarousel.astro';
import Projects from '@/components/sections/Projects.astro';
import PricingExamples from '@/components/sections/PricingExamples.astro';
import OrderingProcess from '@/components/sections/OrderingProcess.astro';
import ProductionAndGuarantees
  from '@/components/sections/ProductionAndGuarantees.astro';
import Reviews from '@/components/sections/Reviews.astro';
import Faq from '@/components/sections/Faq.astro';
import BusinessSolutions from '@/components/sections/BusinessSolutions.astro';
import Contacts from '@/components/sections/Contacts.astro';
import OrderInquiry from '@/components/sections/OrderInquiry.astro';
---

{/* Each section owns its content and any narrowly scoped browser behavior. */}
<Layout title="Главная">
  <div class="homepage-sections">
    {/* Optional offers precede the primary service heading. */}
    <OffersCarousel />
    <Introduction />
    {/* Follow the opening with agency, services and supplied proof. */}
    <About />
    <Services />
    <Projects />
    {/* Compare complete example scopes before the supplied reviews. */}
    <PricingExamples />
    {/* Explain the ordering sequence immediately before testimonials. */}
    <OrderingProcess />
    {/* Publish approved production evidence before testimonials. */}
    <ProductionAndGuarantees />
    <Reviews />
    {/* FAQ answers precede contact paths and project inquiries. */}
    <Faq />
    {/* Match visitors with a relevant business solution before contacts. */}
    <BusinessSolutions />
    {/* End page content with contact paths and the inquiry form. */}
    <Contacts />
    <OrderInquiry />
  </div>
</Layout>

<script>
  import { initializeHomepageReveal } from '../scripts/homepage-reveal';

  // Keep browser-only behavior outside the page composition markup.
  initializeHomepageReveal();
</script>

<style>
  /* Alternate rendered section surfaces with the active theme palette. */
  .homepage-sections > :global(section:nth-of-type(odd)) {
    background: var(--color-base-100);
  }

  /* Give every second section a distinct surface after any reordering. */
  .homepage-sections > :global(section:nth-of-type(even)) {
    background: var(--color-base-200);
  }

  /* Reserve a stacking context for the decorative transition layer. */
  .homepage-sections
    > :global(section:not(.offers-section) + section:not(.offers-section)) {
    position: relative;
    isolation: isolate;
  }

  /* Draw one sinusoidal crest and lower bend well above the next section. */
  .homepage-sections
    > :global(section:not(.offers-section) +
      section:not(.offers-section))::before {
    content: '';
    position: absolute;
    z-index: 0;
    top: -1rem;
    left: -5%;
    width: 110%;
    height: 2rem;
    background: inherit;
    border-radius: 50% / 100% 100% 15% 15%;
    pointer-events: none;
  }

  /* Keep section content and focusable controls above the transition layer. */
  .homepage-sections > :global(section + section:not(.offers-section) > *) {
    position: relative;
    z-index: 1;
  }

  /* Fade contents only; preserve section backgrounds and layout geometry. */
  .homepage-sections > :global(section[data-reveal-state='pending'] > *) {
    opacity: 0;
  }

  /* Revealed content stays visible without transforms affecting controls. */
  .homepage-sections > :global(section[data-reveal-state='revealed'] > *) {
    transition: opacity 360ms ease-out;
  }

  /* Focus and fragment targets also bypass a fade already in progress. */
  .homepage-sections > :global(section:focus-within > *),
  .homepage-sections > :global(section:target > *),
  .homepage-sections > :global(section:has(:target) > *) {
    opacity: 1;
    transition: none;
  }

  /* Preference changes show content before the browser handler runs. */
  @media (prefers-reduced-motion: reduce) {
    /* Keep every section readable immediately when motion is disabled. */
    .homepage-sections > :global(section[data-reveal-state] > *) {
      opacity: 1;
      transition: none;
    }
  }

  /* Remove decorative overlap from printed documents. */
  @media print {
    .homepage-sections
      > :global(section:not(.offers-section) +
        section:not(.offers-section))::before {
      display: none;
    }
  }
</style>
