---
// Compose the homepage in editorial order inside the shared site layout.
// Alternate surfaces by rendered section order, including optional offers.
// Each section owns its content and any narrowly scoped browser behavior.

import Layout from '@/layouts/Layout.astro';
import About from '@/components/sections/About.astro';
import Services from '@/components/sections/Services.astro';
import Introduction from '@/components/sections/Introduction.astro';
import OffersCarousel from '@/components/sections/OffersCarousel.astro';
import Projects from '@/components/sections/Projects.astro';
import PricingExamples from '@/components/sections/PricingExamples.astro';
import OrderingProcess from '@/components/sections/OrderingProcess.astro';
import ProductionAndGuarantees
  from '@/components/sections/ProductionAndGuarantees.astro';
import Reviews from '@/components/sections/Reviews.astro';
import Faq from '@/components/sections/Faq.astro';
import Contacts from '@/components/sections/Contacts.astro';
import OrderInquiry from '@/components/sections/OrderInquiry.astro';
---

{/* Each section owns its content and any narrowly scoped browser behavior. */}
<Layout title="Главная">
  <div class="homepage-sections">
    {/* Optional offers precede the primary service heading. */}
    <OffersCarousel />
    <Introduction />
    {/* Follow the opening with agency, services and supplied proof. */}
    <About />
    <Services />
    <Projects />
    {/* Compare complete example scopes before the supplied reviews. */}
    <PricingExamples />
    {/* Explain the ordering sequence immediately before testimonials. */}
    <OrderingProcess />
    {/* Publish approved production evidence before testimonials. */}
    <ProductionAndGuarantees />
    <Reviews />
    {/* FAQ answers precede contact paths and project inquiries. */}
    <Faq />
    {/* End page content with contact paths and the inquiry form. */}
    <Contacts />
    <OrderInquiry />
  </div>
</Layout>

<style>
  /* Alternate rendered section surfaces with the active theme palette. */
  .homepage-sections > :global(section:nth-of-type(odd)) {
    background: var(--color-base-100);
  }

  /* Give every second section a distinct surface after any reordering. */
  .homepage-sections > :global(section:nth-of-type(even)) {
    background: var(--color-base-200);
  }
</style>
