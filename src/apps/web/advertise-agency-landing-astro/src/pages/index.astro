---
// Compose the homepage in editorial order inside the shared site layout.
// Alternate surfaces by rendered section order, including optional offers.
// Each section owns its content and any narrowly scoped browser behavior.

import Layout from '@/layouts/Layout.astro';
import About from '@/components/sections/About.astro';
import Services from '@/components/sections/Services.astro';
import Introduction from '@/components/sections/Introduction.astro';
import OffersCarousel from '@/components/sections/OffersCarousel.astro';
import Projects from '@/components/sections/Projects.astro';
import PricingExamples from '@/components/sections/PricingExamples.astro';
import OrderingProcess from '@/components/sections/OrderingProcess.astro';
import ProductionAndGuarantees
  from '@/components/sections/ProductionAndGuarantees.astro';
import Reviews from '@/components/sections/Reviews.astro';
import Faq from '@/components/sections/Faq.astro';
import BusinessSolutions from '@/components/sections/BusinessSolutions.astro';
import Contacts from '@/components/sections/Contacts.astro';
import OrderInquiry from '@/components/sections/OrderInquiry.astro';
---

{/* Each section owns its content and any narrowly scoped browser behavior. */}
<Layout title="Главная">
  <div class="homepage-sections">
    {/* Optional offers precede the primary service heading. */}
    <OffersCarousel />
    <Introduction />
    {/* Follow the opening with agency, services and supplied proof. */}
    <About />
    <Services />
    <Projects />
    {/* Compare complete example scopes before the supplied reviews. */}
    <PricingExamples />
    {/* Explain the ordering sequence immediately before testimonials. */}
    <OrderingProcess />
    {/* Publish approved production evidence before testimonials. */}
    <ProductionAndGuarantees />
    <Reviews />
    {/* FAQ answers precede contact paths and project inquiries. */}
    <Faq />
    {/* Match visitors with a relevant business solution before contacts. */}
    <BusinessSolutions />
    {/* End page content with contact paths and the inquiry form. */}
    <Contacts />
    <OrderInquiry />
  </div>
</Layout>

<script>
  // Enhance only this homepage's direct sections after its HTML is parsed.
  // Server markup stays visible if JavaScript or observation is unavailable.
  const container = document.querySelector('.homepage-sections');
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (container && 'IntersectionObserver' in window && !motion.matches) {
    const sections = [...container.querySelectorAll<HTMLElement>(
      ':scope > section',
    )];
    const pending = new Set<HTMLElement>();

    // Release both observation and navigation hooks when nothing is hidden.
    const cleanup = () => {
      observer.disconnect();
      document.removeEventListener('focusin', onFocus, true);
      document.removeEventListener('click', onClick, true);
      window.removeEventListener('hashchange', onHash);
      window.removeEventListener('pageshow', onPageShow);
      motion.removeEventListener('change', onMotion);
    };

    // Navigation and focus bypass the fade so targets are immediately usable.
    const reveal = (section: HTMLElement, immediate = false) => {
      if (immediate) {
        section.removeAttribute('data-reveal-state');
      }
      if (!pending.delete(section)) return;
      if (!immediate) {
        section.dataset.revealState = 'revealed';
      }
      observer.unobserve(section);
      if (!pending.size) cleanup();
    };

    // Find the owning top-level section without modifying nested sections.
    const revealTarget = (target: EventTarget | null) => {
      if (!(target instanceof Node)) return;
      const section = sections.find(item => item.contains(target));
      if (section) reveal(section, true);
    };

    // Decode IDs rather than treating arbitrary fragments as CSS selectors.
    const hashTarget = (hash: string) => {
      try {
        return document.getElementById(decodeURIComponent(hash.slice(1)));
      } catch {
        return null;
      }
    };
    const onHash = () => revealTarget(hashTarget(window.location.hash));
    const onFocus = (event: FocusEvent) => revealTarget(event.target);
    const onClick = (event: MouseEvent) => {
      if (!(event.target instanceof Element)) return;
      const link = event.target.closest<HTMLAnchorElement>('a[href]');
      if (!link) return;
      const url = new URL(link.href, window.location.href);
      if (
        url.origin === window.location.origin &&
        url.pathname === window.location.pathname &&
        url.search === window.location.search
      ) {
        revealTarget(hashTarget(url.hash));
      }
    };

    // Checking edges instead of a visible fraction also supports tall bands.
    const inViewport = (section: HTMLElement) => {
      const bounds = section.getBoundingClientRect();
      return bounds.top <= window.innerHeight && bounds.bottom >= 0;
    };
    const onPageShow = () => {
      for (const section of pending) {
        if (inViewport(section)) reveal(section, true);
      }
    };
    const onMotion = () => {
      if (!motion.matches) return;
      for (const section of pending) reveal(section, true);
    };

    // One observer reveals just before entry, then stops watching each band.
    // A zero threshold avoids waiting for a large fraction of tall content.
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) {
        if (entry.isIntersecting) reveal(entry.target as HTMLElement);
      }
    }, { threshold: 0, rootMargin: '0px 0px 80px 0px' });

    // Only hide offscreen sections; initial content and direct hash/focus
    // targets never acquire a hidden state or flash during initialization.
    const initialTarget = hashTarget(window.location.hash);
    for (const section of sections) {
      if (
        inViewport(section) ||
        (initialTarget && section.contains(initialTarget)) ||
        section.contains(document.activeElement)
      ) continue;
      pending.add(section);
      section.dataset.revealState = 'pending';
      observer.observe(section);
    }

    if (pending.size) {
      document.addEventListener('focusin', onFocus, true);
      document.addEventListener('click', onClick, true);
      window.addEventListener('hashchange', onHash);
      window.addEventListener('pageshow', onPageShow);
      motion.addEventListener('change', onMotion);
    } else {
      cleanup();
    }
  }
</script>

<style>
  /* Alternate rendered section surfaces with the active theme palette. */
  .homepage-sections > :global(section:nth-of-type(odd)) {
    background: var(--color-base-100);
  }

  /* Give every second section a distinct surface after any reordering. */
  .homepage-sections > :global(section:nth-of-type(even)) {
    background: var(--color-base-200);
  }

  /* Fade contents only; preserve section backgrounds and layout geometry. */
  .homepage-sections > :global(section[data-reveal-state='pending'] > *) {
    opacity: 0;
  }

  /* Revealed content stays visible without transforms affecting controls. */
  .homepage-sections > :global(section[data-reveal-state='revealed'] > *) {
    transition: opacity 360ms ease-out;
  }

  /* Focus and fragment targets also bypass a fade already in progress. */
  .homepage-sections > :global(section:focus-within > *),
  .homepage-sections > :global(section:target > *),
  .homepage-sections > :global(section:has(:target) > *) {
    opacity: 1;
    transition: none;
  }

  /* Preference changes show content before the browser handler runs. */
  @media (prefers-reduced-motion: reduce) {
    /* Keep every section readable immediately when motion is disabled. */
    .homepage-sections > :global(section[data-reveal-state] > *) {
      opacity: 1;
      transition: none;
    }
  }
</style>
