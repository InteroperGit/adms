---
// src/pages/index.astro
import Layout from '@/layouts/Layout.astro';
import About from '@/components/sections/About.astro';
import Projects from '@/components/sections/Projects.astro';
import Reviews from '@/components/sections/Reviews.astro';
import Contacts from '@/components/sections/Contacts.astro';

import projects from '@/data/content/projects.json';
import reviews from '@/data/content/reviews.json';
import type { Project, Review } from '@/types';

const typedProjects = projects as Project[];
const typedReviews = reviews as Review[];
---

<Layout title="Главная | Рекламастер">
	<About />
  	<Projects projects={typedProjects} />
  	<Reviews reviews={typedReviews} />
  	<Contacts />
</Layout>