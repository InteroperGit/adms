---
import Layout from '@/layouts/Layout.astro';
import About from '@/components/sections/About.astro';
import Services from '@/components/sections/Services.astro';
import Introduction from '@/components/sections/Introduction.astro';
import OffersCarousel from '@/components/sections/OffersCarousel.astro';
import Projects from '@/components/sections/Projects.astro';
import Reviews from '@/components/sections/Reviews.astro';
import Contacts from '@/components/sections/Contacts.astro';
import OrderInquiry from '@/components/sections/OrderInquiry.astro';
---

<Layout title="Главная">
  <div class="homepage-sections">
    <OffersCarousel />
    <Introduction />
    <About />
    <Services />
    <Projects />
    <Reviews />
    <Contacts />
    <OrderInquiry />
  </div>
</Layout>

<style>
  /* Alternate rendered section surfaces with the active theme palette. */
  .homepage-sections > :global(section:nth-of-type(odd)) {
    background: var(--color-base-100);
  }

  /* Give every second section a distinct surface after any reordering. */
  .homepage-sections > :global(section:nth-of-type(even)) {
    background: var(--color-base-200);
  }
</style>
