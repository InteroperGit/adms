---
// Generate one static detail page per supplied project identifier.
// getStaticPaths supplies the required project prop at build time.
// Breadcrumbs and actions return to configured homepage sections.

import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import { projects } from '@/content/projects';
import { site } from '@/content/site';
import type { Project } from '@/types';

// Build each validated project route without request-time rendering.
export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { id: String(project.id) },
    props: { project },
  }));
}

// Static path generation supplies this required project contract.
const { project } = Astro.props as { project: Project };
const projectsHref =
  site.menu.find((item) => item.href === '/#projects')?.href ??
  '/#projects';
const contactsHref =
  site.menu.find((item) => item.href === '/#contacts')?.href ??
  '/#contacts';
---

{/* Breadcrumbs and actions return to configured homepage sections. */}
<Layout title={project.title} description={project.shortDescription}>
  <article class="site-container project-detail">
    {/* Хлебные крошки */}
    <Breadcrumbs
      items={[
        { label: 'Главная', href: '/' },
        { label: site.sections.projects.title, href: projectsHref },
      ]}
      current={project.title}
    />

    {/* Заголовок */}
    <header class="project-heading">
      <h1>{project.title}</h1>
      <p>Клиент: {project.client}</p>
    </header>

    {/* Основное изображение */}
    <figure class="project-visual">
      <img
        src={project.image}
        alt={project.imageAlt}
        width={project.imageWidth}
        height={project.imageHeight}
        fetchpriority="high"
        decoding="async"
      />
    </figure>

    {/* Описание */}
    <div class="project-reading">
      <section aria-labelledby="project-task">
        <h2 id="project-task">Задача</h2>
        <p>{project.fullDescription}</p>
      </section>
      <section aria-labelledby="project-result">
        <h2 id="project-result">Результат</h2>
        <p>{project.result}</p>
      </section>
      <nav aria-label="Действия проекта" class="project-actions">
        <a class="project-return" href={projectsHref}>
          Вернуться к проектам
        </a>
        <a class="btn btn-primary site-button" href={contactsHref}>
          {site.sections.contacts.panelTitle}
        </a>
      </nav>
    </div>
  </article>
</Layout>

<style>
  /* Align project detail content with shared page gutters. */
  .project-detail {
    padding-block: clamp(2rem, 5vw, 4rem);
    overflow-wrap: anywhere;
  }

  /* Retain the native return link and its visible affordance. */
  .project-return {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  /* Bound the project title before its reserved image frame. */
  .project-heading {
    max-width: 50rem;
    margin-bottom: 2rem;
  }

  /* Maintain the primary document heading and readable responsive scale. */
  h1 {
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.2;
    font-weight: 700;
  }

  /* Separate client metadata beneath the project heading. */
  .project-heading p {
    margin-top: 1rem;
    color: var(--color-muted);
  }

  /* Reserve the project image frame before remote media loads. */
  .project-visual {
    margin: 0 0 clamp(2rem, 5vw, 3rem);
    aspect-ratio: 3 / 2;
    max-width: 56rem;
    background: var(--color-base-200);
    border-radius: var(--radius-field);
    overflow: hidden;
  }

  /* Show the full project image inside its existing frame. */
  .project-visual img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Constrain task and result copy to a comfortable measure. */
  .project-reading {
    max-width: 68ch;
  }

  /* Separate project task and result text. */
  .project-reading section + section {
    margin-top: 2rem;
  }

  /* Separate document sections with a clear secondary heading hierarchy. */
  h2 {
    margin-bottom: 0.75rem;
    font-size: 1.5rem;
    line-height: 1.3;
    font-weight: 700;
  }

  /* Keep explanatory project copy comfortably readable. */
  .project-reading p {
    line-height: 1.7;
  }

  /* Separate native project actions and let labels wrap. */
  .project-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-base-300);
  }

  /* Retain the native return link and its visible affordance. */
  .project-return {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-block: 0.5rem;
    color: var(--color-primary);
    font-weight: 600;
  }

  /* Let the contact action grow with enlarged text. */
  .project-actions .btn {
    height: auto;
    min-height: 44px;
    max-width: 100%;
    white-space: normal;
    padding-block: 0.75rem;
  }
</style>
