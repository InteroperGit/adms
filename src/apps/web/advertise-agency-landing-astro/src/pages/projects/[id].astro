---
// Generate static case pages from the same eligible collection as cards.
// Structured sections omit unknown details and dates are never inferred.
// All photo and inquiry navigation works without browser JavaScript.
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Button from '@/components/ui/Button.astro';
import ProjectPhoto from '@/components/ui/ProjectPhoto.astro';
import ProjectProcess from '@/components/ui/ProjectProcess.astro';
import LedLettersForm from '@/components/forms/LedLettersForm.astro';
import { projects } from '@/content/projects';
import { site } from '@/content/site';
import type { Project } from '@/types';

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { id: String(project.id) },
    props: { project },
  }));
}

// The loader validates approval/visibility before generating these props.
const { project } = Astro.props as { project: Project };
const details = project.details ?? {};
const projectsHref = '/#projects';
const contactsHref = '/#contacts';
// Only lettering has a dedicated form; other types retain contact access.
const hasLedLettersForm = project.projectType === 'led-letters';
const number = new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 20 });
const units = { mm: 'мм', cm: 'см', m: 'м' };
const production = details.timing?.production;
// Intl supplies Russian plural forms for numeric durations.
const productionDuration = production
  ? new Intl.NumberFormat('ru-RU', {
    style: 'unit',
    unit: production.unit === 'hours' ? 'hour' : 'day',
    unitDisplay: 'long',
    maximumFractionDigits: 20,
  }).format(production.value)
  : null;
const hasSpecifications = Boolean(details.materials?.length
  || details.dimensions?.length || details.includedWork?.length);
const hasTask = Boolean(details.customerTask || project.fullDescription
  || project.story?.length);
const hasReading = Boolean(hasTask || details.installationContext
  || details.constraints?.length || project.expectedBenefits?.length);
const hasTiming = Boolean(production || details.timing?.design
  || details.timing?.installation || details.timing?.totalDelivery);
const hasFacts = hasSpecifications || hasTiming;
---

<Layout title={project.title} description={project.shortDescription}>
  <article class="site-container project-detail">
    {/* Breadcrumbs preserve the existing homepage project destination. */}
    <Breadcrumbs
      items={[
        { label: 'Главная', href: '/' },
        { label: site.sections.projects.title, href: projectsHref },
      ]}
      current={project.title}
    />

    {/* Quiet attribution keeps the title and lead image as the main focus. */}
    <header class="project-heading">
      <h1>{project.title}</h1>
      <dl class="project-meta">
        <div>
          <dt>Заказчик</dt>
          <dd>{project.client}</dd>
        </div>
        <div>
          <dt>Год</dt>
          <dd>
            {project.year
              ? <time datetime={String(project.year)}>{project.year}</time>
              : 'Уточняется'}
          </dd>
        </div>
      </dl>
    </header>

    {/* Full photos and their captions remain visible in a static gallery. */}
    {project.photos.length > 0 && (
      <div class="project-gallery">
        <div class="project-photo-list">
          {project.photos.map((photo, index) => (
            <ProjectPhoto photo={photo} priority={index === 0} />
          ))}
        </div>
      </div>
    )}

    {/* Reading copy and measured specifications share an aligned layout. */}
    {(hasReading || hasFacts) && (
      <div class:list={['project-body', {
        'has-columns': hasReading && hasFacts,
      }]}>
        {hasReading && (
          <div class="project-reading">
            {hasTask && (
              <section aria-labelledby="project-task">
                <h2 id="project-task">
                  {details.customerTask ? 'Задача заказчика' : 'О проекте'}
                </h2>
                {details.customerTask && <p>{details.customerTask}</p>}
                {project.fullDescription && <p>{project.fullDescription}</p>}
                {/* Narrative explains choices before specifications. */}
                {project.story?.map((paragraph) => <p>{paragraph}</p>)}
              </section>
            )}

            {/* Unknown installation details create no empty section. */}
            {(details.installationContext || details.constraints?.length) && (
              <section aria-labelledby="project-context">
                <h2 id="project-context">Условия установки</h2>
                {details.installationContext && (
                  <p>{details.installationContext}</p>
                )}
                {details.constraints && details.constraints.length > 0 && (
                  <ul>
                    {details.constraints.map((constraint) => (
                      <li>{constraint}</li>
                    ))}
                  </ul>
                )}
              </section>
            )}

            {/* Benefits describe intent, separately from verified results. */}
            {Boolean(project.expectedBenefits?.length) && (
              <section aria-labelledby="project-benefits">
                <h2 id="project-benefits">Что получает заказчик</h2>
                <ul>
                  {project.expectedBenefits?.map((benefit) => (
                    <li>{benefit}</li>
                  ))}
                </ul>
              </section>
            )}

          </div>
        )}

        {/* Specifications remain visible without tabs or disclosure UI. */}
        {hasFacts && (
          <div class="project-specifications">
            {hasSpecifications && (
              <section aria-labelledby="project-scope">
                <h2 id="project-scope">Материалы и работы</h2>
                <dl class="project-facts">
                  {Boolean(details.materials?.length) && (
                    <div>
                      <dt>Материалы</dt>
                      <dd>
                        <ul>
                          {details.materials?.map((material) => (
                            <li>{material}</li>
                          ))}
                        </ul>
                      </dd>
                    </div>
                  )}
                  {Boolean(details.dimensions?.length) && (
                    <div>
                      <dt>Размеры</dt>
                      <dd>
                        <ul>
                          {details.dimensions?.map((dimension) => (
                            <li>
                              {dimension.label}:{' '}
                              {number.format(dimension.value)}
                              {' '}{units[dimension.unit]}
                            </li>
                          ))}
                        </ul>
                      </dd>
                    </div>
                  )}
                  {Boolean(details.includedWork?.length) && (
                    <div>
                      <dt>
                        {project.status === 'demo'
                          ? 'Состав проекта' : 'Выполненные работы'}
                      </dt>
                      <dd>
                        <ul>
                          {details.includedWork?.map((work) => <li>{work}</li>)}
                        </ul>
                      </dd>
                    </div>
                  )}
                </dl>
              </section>
            )}

            {/* Production is explicitly separate from total delivery time. */}
            {hasTiming && details.timing && (
              <section aria-labelledby="project-timing">
                <h2 id="project-timing">
                  {project.status === 'demo' ? 'Плановые сроки' : 'Сроки'}
                </h2>
                <dl class="project-facts">
                  {production && <div>
                    <dt>Производство</dt>
                    <dd>
                      {productionDuration}
                      <p class="project-timing-basis">{production?.basis}</p>
                    </dd>
                  </div>}
                  {details.timing.design && (
                    <div>
                      <dt>Дизайн</dt>
                      <dd>{details.timing.design}</dd>
                    </div>
                  )}
                  {details.timing.installation && (
                    <div>
                      <dt>Монтаж</dt>
                      <dd>{details.timing.installation}</dd>
                    </div>
                  )}
                  {details.timing.totalDelivery && (
                    <div>
                      <dt>Общий срок</dt>
                      <dd>{details.timing.totalDelivery}</dd>
                    </div>
                  )}
                </dl>
              </section>
            )}
          </div>
        )}
      </div>
    )}

    {/* Optional process sections follow the overview in production order. */}
    <ProjectProcess
      id="manufacturing"
      title="Производство"
      content={project.manufacturing}
    />
    <ProjectProcess
      id="installation"
      title="Монтаж"
      content={project.installation}
    />

    {/* Final imagery follows the process; empty results add no section. */}
    {(project.result || project.resultPhotos?.length) && (
      <section class="project-result" aria-labelledby="project-result">
        <h2 id="project-result">Итоговый результат</h2>
        {project.result && <p>{project.result}</p>}
        {Boolean(project.resultPhotos?.length) && (
          <div class="project-photo-list">
            {project.resultPhotos?.map((photo) => (
              <ProjectPhoto photo={photo} />
            ))}
          </div>
        )}
      </section>
    )}

    {/* Omit forms entirely when the case type has no matching component. */}
    {hasLedLettersForm && <LedLettersForm projectId={project.id} />}

    {/* Form navigation appears only when its destination is rendered. */}
    <nav aria-label="Действия проекта" class="project-actions">
      {hasLedLettersForm && (
        <Button href="#led-letters" class="project-inquiry">
          Заказать световые буквы
        </Button>
      )}
      <a class="project-link" href={projectsHref}>Вернуться к проектам</a>
      <a class="project-link" href={contactsHref}>
        {site.sections.contacts.panelTitle}
      </a>
    </nav>
  </article>
</Layout>

<style>
  /* Align the case with shared gutters and wrap long approved copy. */
  .project-detail {
    padding-block: clamp(2rem, 5vw, 4rem);
    overflow-wrap: anywhere;
  }

  /* Keep the title and attribution together above the lead image. */
  .project-heading {
    max-width: 50rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  /* Keep one prominent document heading across narrow viewports. */
  h1 {
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.2;
    font-weight: 700;
  }

  /* Compact pairs share one row and wrap together on narrow screens. */
  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 1.25rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* Each label and value forms a single, subtly outlined metadata tag. */
  .project-meta > div {
    display: flex;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
    border: 1px solid var(--color-base-300);
    border-radius: var(--radius-field);
  }

  /* Muted label backgrounds distinguish the two parts without loud color. */
  .project-meta dt {
    flex-shrink: 0;
    margin: 0;
    padding: 0.375rem 0.75rem;
    background: var(--color-base-200);
    color: var(--color-muted);
    font-weight: 500;
  }

  /* Values use the page surface and a divider for clear theme contrast. */
  .project-meta dd {
    min-width: 0;
    margin: 0;
    padding: 0.375rem 0.75rem;
    border-inline-start: 1px solid var(--color-base-300);
    background: var(--color-base-100);
    color: var(--color-base-content);
    font-weight: 600;
  }

  /* Separate photo evidence from the following written explanation. */
  .project-gallery {
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }

  /* Static photos retain their full context in source order. */
  .project-photo-list {
    display: grid;
    gap: 2rem;
    max-width: 71rem;
  }

  /* Final photographs close the case before the inquiry action. */
  .project-result {
    display: block;
    clear: both;
    width: 100%;
    margin-top: clamp(2rem, 5vw, 4rem);
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 1px solid var(--color-base-300);
  }

  /* Outcome copy keeps a readable measure above the finished-work gallery. */
  .project-result p {
    max-width: var(--site-reading-width);
    margin-bottom: 1.5rem;
    line-height: 1.7;
  }

  /* Mobile reading order presents narrative before measured specifications. */
  .project-body {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  /* Narrative paragraphs stay comfortably readable on wide displays. */
  .project-reading {
    min-width: 0;
    max-width: var(--site-reading-width);
  }

  /* Give factual information a quiet shared surface, with no nested cards. */
  .project-specifications {
    min-width: 0;
    padding: clamp(1rem, 3vw, 2rem);
    background: var(--color-base-200);
    border-radius: var(--radius-field);
  }

  /* Clear separation connects sections without ornamental numbering. */
  section + section {
    margin-top: 2rem;
  }

  /* Secondary headings organize the six required case details. */
  h2 {
    margin-bottom: 1rem;
    font-size: 1.5rem;
    line-height: 1.3;
    font-weight: 700;
  }

  /* Paragraphs use the site's established reading rhythm. */
  .project-body p {
    line-height: 1.7;
  }

  /* Separate consecutive narrative paragraphs. */
  .project-reading p + p {
    margin-top: 1rem;
  }

  /* Native lists keep individual constraints and work items scannable. */
  ul {
    padding-inline-start: 1.25rem;
    list-style: disc;
  }

  /* Separate items so enlarged text does not merge adjacent facts. */
  li + li {
    margin-top: 0.5rem;
  }

  /* Label/value groups remain aligned even when values wrap. */
  .project-facts {
    display: grid;
    gap: 1.5rem;
  }

  /* Labels distinguish scope and timing values without tiny text. */
  dt {
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  /* Timing basis clarifies what the production duration actually measures. */
  .project-timing-basis {
    margin-top: 0.5rem;
    color: var(--color-muted);
  }

  /* Wrap actions rather than clipping their Russian labels. */
  .project-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: clamp(2rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-base-300);
  }

  /* Inquiry links can grow with enlarged text and narrow viewports. */
  :global(.project-inquiry) {
    height: auto;
    min-height: 44px;
    max-width: 100%;
    padding-block: 0.75rem;
    white-space: normal;
  }

  /* Secondary actions remain underlined and keyboard reachable. */
  .project-link {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    font-weight: 600;
  }

  /* Wide pages pair readable narrative with measured project facts. */
  @media (min-width: 64rem) {
    /* Two columns use free space without stretching paragraph measures. */
    .project-body.has-columns {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: clamp(2rem, 5vw, 4rem);
    }
  }
</style>
