---
// src/pages/projects/[id].astro
import Layout from '@/layouts/Layout.astro';
import { projects } from '@/content/projects';
import type { Project } from '@/types';

// Генерируем все статические пути (SSG)
export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { id: String(project.id) },
    props: { project },
  }));
}

// Получаем проект из пропсов
const { project } = Astro.props as { project: Project };
---

<Layout title={project.title} description={project.shortDescription}>
  <div class="container mx-auto px-4 py-12">
    <!-- Хлебные крошки -->
    <nav class="text-sm breadcrumbs mb-6">
      <ul>
        <li><a href="/" class="link link-hover">Главная</a></li>
        <li><a href="/#projects" class="link link-hover">Проекты</a></li>
        <li>{project.title}</li>
      </ul>
    </nav>

    <!-- Заголовок -->
    <h1 class="text-4xl font-bold mb-4">{project.title}</h1>
    <p class="text-xl text-gray-600 mb-2">Клиент: {project.client}</p>

    <!-- Основное изображение -->
    <figure class="mb-8">
      <img src={project.image} alt={project.title} class="w-full max-h-[500px] object-cover rounded-xl shadow-lg" />
    </figure>

    <!-- Описание -->
    <div class="prose max-w-none mb-8">
      <h2>Задача</h2>
      <p>{project.fullDescription}</p>
      
      <h2>Результат</h2>
      <div class="alert alert-success">
        <span>✅ {project.result}</span>
      </div>
    </div>

    <!-- Кнопка назад -->
    <a href="/#projects" class="btn btn-outline">← Вернуться к проектам</a>
  </div>
</Layout>
