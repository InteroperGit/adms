---
// Generate static project pages from validated metadata and content blocks.
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import ProjectDetailHeader
  from '@/components/projects/ProjectDetailHeader.astro';
import ContentBlocks from '@/components/content/ContentBlocks.astro';
import ProjectArticleActions
  from '@/components/projects/ProjectArticleActions.astro';
import { projects } from '@/content/projects';
import { site } from '@/content/site';
import type { Project } from '@/types/project';
import { isProjectPublished } from '@/content/project-publication';
import { blockDemoNotice } from '@/content/block-publication';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { id: String(project.id) },
    props: { project },
  }));
}

const { project } = Astro.props as { project: Project };
const projectsHref = '/projects/';
const published = isProjectPublished(project);
const notice = project.notice ?? (!published ? blockDemoNotice : undefined);
---

<Layout
  title={project.title}
  description={project.description}
  noindex={!published}
>
  <article class="site-container project-detail">
    <Breadcrumbs
      items={[
        { label: 'Главная', href: '/' },
        { label: site.sections.projects.title, href: projectsHref },
      ]}
      current={project.title}
    />
    <ProjectDetailHeader project={project} />
    {/* Qualify demo claims before readers encounter the article or media. */}
    {notice && <p class="project-notice">{notice}</p>}
    {/* The page owns category/approval; blocks own reading order. */}
    <ContentBlocks
      blocks={project.content}
      context={{
        kind: 'project', projectId: project.id, category: project.category,
        published,
      }}
    />
    <ProjectArticleActions contactLabel={site.sections.contacts.panelTitle} />
  </article>
</Layout>

<style>
  /* Align the case with shared gutters and wrap long approved copy. */
  .project-detail {
    padding-block: clamp(2rem, 5vw, 4rem);
    overflow-wrap: anywhere;
  }

  /* Let project blocks use the full page area after the sidebar removal. */
  .project-detail :global(.content-blocks) {
    width: 100%;
    max-width: none;
  }

  /* Make the editorial qualification visible beside the project content. */
  .project-notice {
    margin-bottom: 1.5rem;
    padding-left: 1rem;
    border-left: 3px solid var(--color-primary);
    color: var(--color-muted);
  }

</style>
