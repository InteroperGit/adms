---
// Render the project catalog with static routes and progressive enhancement.
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";
import Catalog from "@/components/features/catalog/Catalog.astro";
import ProjectCard from "@/components/features/projects/ProjectCard.astro";
import { getProjectCategory } from "@/content/projectCategories";
import { availableProjectCategories, projects } from "@/content/projects";
import { projectCatalogSettings } from "@/content/projectCatalog";

const basePath = "/projects/";
const pageSize = projectCatalogSettings.pageSize;
const pageCount = Math.max(1, Math.ceil(projects.length / pageSize));
const routePage = Astro.url.pathname.match(/^\/projects\/page\/(\d+)\/?$/)?.[1];
const requestedPage = Number(routePage ?? Astro.url.searchParams.get("page"));
const currentPage =
  Number.isInteger(requestedPage) && requestedPage > 0
    ? Math.min(requestedPage, pageCount)
    : 1;
const items = projects.map((project) => {
  const category = getProjectCategory(project.category);
  return {
    category: project.category ?? "",
    searchText: [
      project.title,
      project.client,
      project.description,
      category?.label,
    ]
      .filter(Boolean)
      .join(" "),
    props: { project },
  };
});
const pageHref = (page: number) => {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.delete("page");
  const path = page > 1 ? `${basePath}page/${page}/` : basePath;
  const query = params.toString();
  return `${path}${query ? `?${query}` : ""}${Astro.url.hash}`;
};
---

<Layout
  title="Проекты"
  description="Каталог проектов наружной рекламы и световых конструкций."
>
  <div class="catalog-page">
    <div class="site-container">
      <h1 class="catalog-title">Проекты</h1>
      <Breadcrumbs
        items={[{ label: "Главная", href: "/" }]}
        current="Проекты"
      />
      <Catalog
        Item={ProjectCard}
        basePath={basePath}
        categories={availableProjectCategories.map(({ slug, label }) => ({
          value: slug,
          label,
        }))}
        currentPage={currentPage}
        id="project-catalog"
        items={items}
        labels={{
          allCategories: "Все проекты",
          category: "Категория",
          count: "Найдено проектов",
          emptyMessage: "Здесь появятся наши реализованные проекты.",
          emptyTitle: "Проекты пока не опубликованы",
          pagination: "Навигация по проектам",
          reset: "Сбросить фильтры",
          results: "Результаты каталога",
          search: "Поиск по проектам",
          searchEmptyMessage: "Измените запрос или сбросьте фильтр категории.",
          searchEmptyTitle: "Проекты не найдены",
          searchPlaceholder: "Название или заказчик",
        }}
        pageCount={pageCount}
        pageHref={pageHref}
        pageSize={pageSize}
        resultsId="catalog-results"
      />
    </div>
  </div>
</Layout>

<script>
  import "@/components/features/catalog/catalogRuntime";
  import "@/components/features/projects/projectCatalogRuntime";
</script>

<style>
  /* Keep the catalog content aligned with the shared page container. */
  .catalog-page {
    padding-block: clamp(2rem, 5vw, 4rem);
    overflow-wrap: anywhere;
  }

  /* Give each catalog route one clear document heading. */
  .catalog-title {
    margin: 0 0 1.5rem;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
  }
</style>
