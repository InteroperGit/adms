---
import Layout from '@/layouts/Layout.astro';
import { termsOfUse } from '@/content/legal';
---

<Layout title={`${termsOfUse.title} | Рекламастер`}>
  <div class="container mx-auto px-4 py-12 prose max-w-3xl">
    <h1>{termsOfUse.title}</h1>
    <p><strong>Дата вступления в силу:</strong> {termsOfUse.effectiveDate}</p>

    {termsOfUse.sections.map((section) => (
      <div class="mt-6">
        <h2>{section.heading}</h2>
        {section.content && <p>{section.content}</p>}
        {section.list && (
          <ul>
            {section.list.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
      </div>
    ))}
  </div>
</Layout>