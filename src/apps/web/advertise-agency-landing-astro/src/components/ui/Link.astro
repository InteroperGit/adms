---
// Render a native anchor with a font-relative underline offset.
import type { HTMLAttributes } from "astro/types";

export type Props = Omit<HTMLAttributes<"a">, "class" | "href"> & {
  href: string | undefined;
  class?: string;
  underline?: boolean;
};

const { href, class: className, underline = true, ...attributes } = Astro.props;
---

<a
  href={href}
  class={className}
  data-link-underline={underline ? "true" : "false"}
  {...attributes}
>
  <slot />
</a>

<style>
  /* Place default text underlines below glyphs at inherited font sizes. */
  a[data-link-underline] {
    text-underline-offset: calc(0.2em + 1px);
    text-decoration-skip-ink: auto;
  }

  /* Keep graphical and control-like links free of browser underlines. */
  a[data-link-underline="false"] {
    text-decoration: none;
  }
</style>
