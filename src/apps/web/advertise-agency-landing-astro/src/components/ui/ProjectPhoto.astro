---
// Render one validated case photo with stable geometry and optional caption.
// Bundled originals use Astro variants; public/remote sources retain their
// supplied dimensions and URL. Cropping is reserved for homepage thumbnails.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ProjectPhoto } from '@/types/project';

export interface Props {
  photo: ProjectPhoto;
  thumbnail?: boolean;
  priority?: boolean;
}

const { photo, thumbnail = false, priority = false } = Astro.props;
const originals = import.meta.glob<ImageMetadata>(
  '/src/assets/**/*.{avif,jpeg,jpg,png,webp}',
  { eager: true, import: 'default' },
);
const original = originals[photo.src];
if (photo.src.startsWith('/src/assets/') && !original) {
  throw new Error(`Project photo missing: ${photo.src}`);
}
// Avoid upscaling small originals; the largest variant supplies the fallback.
const sourceWidth = original?.width ?? photo.width;
const widths = [...new Set([
  ...[320, 640, 960, 1280].filter((width) => width < sourceWidth),
  Math.min(sourceWidth, 1440),
])].sort((a, b) => a - b);
const sizes = thumbnail
  ? '(min-width: 80rem) 368px, (min-width: 48rem) 45vw, 92vw'
  : '(min-width: 80rem) 1136px, 92vw';
const loading = priority ? 'eager' : 'lazy';
---

{/* Detail photos retain full framing; thumbnails use approved focal points. */}
<figure class:list={['case-photo', { 'case-thumbnail': thumbnail }]}>
  <div
    class="case-frame"
    style={{
      '--photo-ratio': `${photo.width} / ${photo.height}`,
      '--photo-position': `${photo.focalPoint.x}% ${photo.focalPoint.y}%`,
    }}
  >
    {original ? (
      <Image
        src={original}
        alt={photo.alt}
        width={photo.width}
        height={photo.height}
        widths={widths}
        sizes={sizes}
        loading={loading}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
        class="case-image"
      />
    ) : (
      <img
        src={photo.src}
        alt={photo.alt}
        width={photo.width}
        height={photo.height}
        loading={loading}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
        class="case-image"
      />
    )}
  </div>
  {/* Captions qualify detail media; card notices qualify demo thumbnails. */}
  {!thumbnail && <figcaption>{photo.caption}</figcaption>}
</figure>

<style>
  /* Keep the figure inside shrinking text and gallery columns. */
  .case-photo {
    min-width: 0;
    margin: 0;
  }

  /* Reserve intrinsic geometry even while an image fails or loads slowly. */
  .case-frame {
    aspect-ratio: var(--photo-ratio);
    overflow: hidden;
    background: var(--color-base-200);
    border-radius: var(--radius-field);
  }

  /* Full installation photos reveal context rather than cropping the work. */
  .case-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Homepage thumbnails match the established portfolio frame. */
  .case-thumbnail .case-frame {
    aspect-ratio: 3 / 2;
    border-radius: var(--radius-field) var(--radius-field) 0 0;
  }

  /* Approved focal coordinates protect the subject in thumbnail crops. */
  .case-thumbnail .case-image {
    object-fit: cover;
    object-position: var(--photo-position);
  }

  /* Captions stay legible and wrap independently of image width. */
  figcaption {
    padding-top: 0.75rem;
    color: var(--color-muted);
    overflow-wrap: anywhere;
  }
</style>
