---
// Render a viewport-bounded settings popup containing native theme radios.
// ThemeInit reveals controls only when their preference handling is ready.
// Keep popup positioning and focus dismissal within the header boundary.
import ThemeToggle from "./ThemeToggle.astro";
---

{/* Keep popup positioning and focus dismissal within the header boundary. */}
<div
  class="theme-settings"
  hidden
  data-theme-control
  data-theme-settings
>
  <button
    type="button"
    class="settings-trigger"
    aria-label="Настройки"
    title="Настройки"
    aria-expanded="false"
    aria-controls="theme-settings-panel"
    data-settings-trigger
  >
    <span class="settings-surface btn btn-sm site-button">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path
          d={
            "m9 3-.5 2.5-2 1.2L4 6l-2 3.5 2 1.7v2.3" +
            "l-2 1.8L4 19l2.5-.7 2 1.2L9 22h4l.5-2.5" +
            " 2-1.2 2.5.7 2-3.7-2-1.8v-2.3l2-1.7L18 6" +
            "l-2.5.7-2-1.2L13 3Z"
          }
          transform="translate(1 -0.5) scale(.95)"
        />
        <circle
          cx="12"
          cy="12"
          r="3"
        />
      </svg>
    </span>
  </button>
  {/* Keep preferences hidden until the trigger expands this bounded popup. */}
  <div
    id="theme-settings-panel"
    class="settings-panel"
    hidden
    data-settings-panel
  >
    <ThemeToggle />
  </div>
</div>
<style>
  /* Reserve settings space beside the navigation controls. */
  .theme-settings {
    flex: none;
    margin-inline: 0.5rem;
  }
  /* Center the compact gear in a generous pointer target. */
  .settings-trigger {
    display: grid;
    place-items: center;
    width: max(2.75rem, 44px);
    height: max(2.75rem, 44px);
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  /* Draw the themed gear surface inside its larger target. */
  .settings-surface {
    display: grid;
    place-items: center;
    width: var(--size);
    min-width: 0;
    padding: 0;
    border: 1px solid var(--site-control-border);
    color: var(--color-base-content);
    background: var(--color-base-100);
    box-shadow: none;
    pointer-events: none;
  }
  /* Keep the gear proportionate to the compact surface. */
  .settings-trigger svg {
    width: 1.25rem;
    height: 1.25rem;
  }
  /* Give the open settings panel a persistent surface cue. */
  .settings-trigger:hover .settings-surface,
  .settings-trigger[aria-expanded="true"] .settings-surface {
    background: var(--color-base-200);
  }
  /* Use primary contrast for pointer feedback on the compact gear. */
  .settings-trigger:hover .settings-surface {
    background: var(--color-primary);
    color: var(--color-primary-content);
    border-color: var(--color-primary);
  }
  /* Preserve the requested black hover surface in explicit light mode. */
  :global([data-theme="light"]) .settings-trigger:hover .settings-surface {
    background: #000;
    color: #fff;
    border-color: #000;
  }
  /* Keep keyboard focus visible above adjacent controls and surfaces. */
  .settings-trigger:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: var(--radius-field);
  }
  /* Bound the popup to the visible viewport above page content. */
  .settings-panel {
    position: fixed;
    z-index: 50;
    width: max-content;
    max-width: calc(100vw - 32px);
    padding: clamp(12px, 0.75rem, 16px);
    overflow: auto;
    border: 1px solid var(--site-control-border);
    border-radius: var(--radius-field);
    background: var(--color-base-100);
    color: var(--color-base-content);
    box-shadow: var(--shadow-elevated);
  }
  /* Reduce outer spacing to fit settings beside the narrow-screen brand. */
  @media (max-width: 374px) {
    /* Keep room for the mobile opener on the smallest viewport. */
    .theme-settings {
      margin-inline: 0.25rem;
    }
  }
</style>
<script>
  const settings = document.querySelector<HTMLElement>("[data-theme-settings]");
  const trigger = settings?.querySelector<HTMLButtonElement>(
    "[data-settings-trigger]",
  );
  const panel = settings?.querySelector<HTMLElement>("[data-settings-panel]");
  if (settings && trigger && panel) {
    // Read visual viewport values so zoom and on-screen offsets stay in view.
    const readViewport = () => {
      const viewport = window.visualViewport;
      return {
        width: viewport?.width ?? window.innerWidth,
        height: viewport?.height ?? window.innerHeight,
        offsetLeft: viewport?.offsetLeft ?? 0,
        offsetTop: viewport?.offsetTop ?? 0,
      };
    };
    // Measure the anchor and constrain the popup before calculating its spot.
    const calculatePanelPosition = () => {
      const viewport = readViewport();
      const anchor = trigger.getBoundingClientRect();
      const maxWidth = Math.max(0, viewport.width - 32);
      panel.style.maxWidth = String(maxWidth) + "px";
      const panelWidth = Math.min(
        panel.getBoundingClientRect().width,
        viewport.width - 32,
      );
      const top = Math.min(
        anchor.bottom + 8,
        viewport.offsetTop + viewport.height - 60,
      );
      const left = Math.max(
        viewport.offsetLeft + 16,
        Math.min(
          anchor.right - panelWidth,
          viewport.offsetLeft + viewport.width - panelWidth - 16,
        ),
      );
      // The header filter makes it a fixed-position containing block.
      const headerBounds = settings.closest("header")?.getBoundingClientRect();
      return {
        left: left - (headerBounds?.left ?? 0),
        top: top - (headerBounds?.top ?? 0),
        maxHeight: Math.max(
          44,
          viewport.offsetTop + viewport.height - top - 16,
        ),
      };
    };
    // Apply the measured coordinates after the viewport and anchor are read.
    const applyPanelPosition = (
      position: ReturnType<typeof calculatePanelPosition>,
    ) => {
      panel.style.left = String(position.left) + "px";
      panel.style.top = String(position.top) + "px";
      panel.style.maxHeight = String(position.maxHeight) + "px";
    };
    // Recalculate only while open; closed popups need no layout work.
    const place = () => {
      if (panel.hidden) {
        return;
      }
      applyPanelPosition(calculatePanelPosition());
    };
    // Keep visibility and accessible state changes in one close action.
    const closeSettings = (restoreFocus = false) => {
      panel.hidden = true;
      settings.removeAttribute("data-settings-open");
      trigger.setAttribute("aria-expanded", "false");
      if (restoreFocus) {
        trigger.focus({ preventScroll: true });
      }
    };
    // Open first, then focus the selected radio for keyboard activation only.
    const openSettings = (focusSelectedRadio: boolean) => {
      panel.hidden = false;
      settings.setAttribute("data-settings-open", "");
      trigger.setAttribute("aria-expanded", "true");
      place();
      if (focusSelectedRadio) {
        panel
          .querySelector<HTMLInputElement>("input:checked")
          ?.focus({ preventScroll: true });
      }
    };
    // Preserve pointer focus; keyboard activation enters the radios.
    const handleTriggerClick = (event: MouseEvent) => {
      if (!panel.hidden) {
        closeSettings();
        return;
      }
      openSettings(event.detail === 0);
    };
    // Restore trigger focus without leaking Escape to header handlers.
    const handleSettingsKeydown = (event: KeyboardEvent) => {
      if (event.key !== "Escape" || panel.hidden) {
        return;
      }
      event.preventDefault();
      event.stopPropagation();
      closeSettings(true);
    };
    // Defer focusout until native label and trigger focus changes have settled.
    const handleSettingsFocusout = () => {
      setTimeout(() => {
        if (!settings.contains(document.activeElement)) {
          closeSettings();
        }
      }, 0);
    };
    // Dismiss outside pointer actions without canceling their native behavior.
    const handleDocumentPointerdown = (event: PointerEvent) => {
      if (event.target instanceof Node && !settings.contains(event.target)) {
        closeSettings();
      }
    };
    const handleMobileMenuOpen = () => {
      closeSettings();
    };
    trigger.addEventListener("click", handleTriggerClick);
    settings.addEventListener("keydown", handleSettingsKeydown);
    settings.addEventListener("focusout", handleSettingsFocusout);
    document.addEventListener("pointerdown", handleDocumentPointerdown);
    document
      .querySelector("#mobile-menu-open")
      ?.addEventListener("click", handleMobileMenuOpen);
    window.addEventListener("resize", place);
    window.visualViewport?.addEventListener("resize", place);
    window.visualViewport?.addEventListener("scroll", place);
    // Font enlargement can change the anchor without resizing the viewport.
    new ResizeObserver(place).observe(trigger);
  }
</script>
