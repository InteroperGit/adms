---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ServiceImage } from '@/types/services';

export interface Props {
  image: ServiceImage;
  eager?: boolean;
}

const { image, eager = false } = Astro.props;
const originals = import.meta.glob<ImageMetadata>(
  '/src/assets/**/*.{avif,jpeg,jpg,png,webp}',
  { eager: true, import: 'default' },
);
const original = originals[image.src];
if (image.src.startsWith('/src/assets/') && !original) {
  throw new Error(`Service image not found: ${image.src}`);
}
const focalPoint = (point: { x: number; y: number }) =>
  `${point.x}% ${point.y}%`;
const sizes = eager
  ? '(min-width: 64rem) 896px, 94vw'
  : '(min-width: 68rem) 380px, (min-width: 42rem) 46vw, 94vw';
---

<div
  class="service-photo"
  style={{
    '--desktop-focal-point': focalPoint(image.desktopFocalPoint),
    '--mobile-focal-point': focalPoint(image.mobileFocalPoint),
  }}
>
  {original ? <Image
    src={original}
    alt={image.alt}
    width={image.width}
    height={image.height}
    widths={eager ? [480, 768, 1200] : [320, 480, 768]}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
    class="service-image"
  /> : <img
    src={image.src}
    alt={image.alt}
    width={image.width}
    height={image.height}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
    class="service-image"
  />}
</div>

<style>
  /* Reserve consistent space for category and demonstration images. */
  .service-photo {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-field);
    background: var(--color-base-300);
  }

  /* Keep the configured desktop subject inside the reserved frame. */
  .service-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--desktop-focal-point);
  }

  /* Apply the separately reviewed crop to narrow layouts. */
  @media (max-width: 41.999rem) {
    /* Preserve the configured mobile subject position. */
    .service-image {
      object-position: var(--mobile-focal-point);
    }
  }
</style>
