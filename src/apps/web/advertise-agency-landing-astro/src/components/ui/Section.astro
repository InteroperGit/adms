---
// src/components/ui/Section.astro

export interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
  background?: 'default' | 'gradient' | 'dark' | 'none';
  class?: string;
}

const { id, title, subtitle, background = 'default', class: className = '' } = Astro.props;

const bgClasses = {
  default: 'bg-base-100',
  gradient: 'bg-gradient-to-b from-base-100 to-base-200/50',
  dark: 'bg-base-200',
  none: '',
};

const sectionClasses = [
  'site-section',
  bgClasses[background],
  className,
].filter(Boolean).join(' ');
---

<section id={id} class={sectionClasses}>
  <div class="site-container">
    {title && (
      <h2 class="site-section-title">{title}</h2>
    )}
    {subtitle && (
      <p class="site-section-subtitle">{subtitle}</p>
    )}
    <slot />
  </div>
</section>
