---
// Render and enhance the native modal navigation drawer on small screens.
// Callers supply menu items and phone; Header supplies the opener element.
// Preserve modal focus, Escape dismissal and same-page anchor navigation.

import NavLinks from "@/components/ui/NavLinks.astro";
import Button from "@/components/ui/Button.astro";
import MaxLogo from "@/components/ui/MaxLogo.astro";
import { icons } from "@/content/icons";
import type { MenuItem } from "@/types";

// Caller-supplied data and presentation options for this component.
export interface Props {
  items: MenuItem[];
  phone: string;
}

const { items, phone } = Astro.props;
const phoneHref = `tel:${phone.replace(/\s/g, "")}`;
---

{/* Preserve modal focus, Escape dismissal and same-page anchor navigation. */}
<dialog
  id="mobile-menu"
  aria-label="Меню сайта"
  class="bg-base-200 text-base-content"
>
  <div class="mobile-menu-close-row">
    <button
      type="button"
      data-menu-close
      class="btn btn-ghost btn-circle mobile-menu-close"
      aria-label="Закрыть меню"
      autofocus
    >
      <span
        class="mobile-menu-close-icon"
        aria-hidden="true"
      >
        ×
      </span>
    </button>
  </div>
  <NavLinks
    items={items}
    variant="mobile"
    phone={phone}
  />
  <hr class="mobile-menu-divider" />
  <div
    class="mobile-menu-actions"
    role="group"
    aria-label="Контакты"
  >
    <Button
      href={phoneHref}
      size="md"
      class="mobile-menu-action"
      aria-label="Позвонить"
    >
      <i
        class:list={["fas", icons.phone]}
        aria-hidden="true"
      ></i>
      <span>Позвонить</span>
    </Button>
    <Button
      variant="secondary"
      size="md"
      href="https://max.ru/"
      class="mobile-menu-action mobile-menu-max"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Написать в Макс"
    >
      <MaxLogo />
      <span>Макс</span>
    </Button>
  </div>
</dialog>

<style>
  /* Bound the modal drawer to the viewport with scrollable content. */
  dialog {
    position: fixed;
    inset: 1rem auto auto 1rem;
    margin: 0;
    padding: 0;
    border: 0;
    width: 18rem;
    max-width: calc(100vw - 2rem);
    height: calc(100dvh - 2rem);
    max-height: calc(100dvh - 2rem);
    overflow: hidden;
    border-radius: 1rem;
    opacity: 0;
    transform: translateX(calc(-100% - 1rem));
    transition:
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 180ms ease;
  }

  /* Show the drawer as a flex column and slide it in from the left. */
  dialog[open] {
    display: flex;
    flex-direction: column;
    opacity: 1;
    transform: translateX(0);
  }

  /* Start each opening outside the left edge for a reliable entrance. */
  @starting-style {
    dialog[open] {
      opacity: 0;
      transform: translateX(calc(-100% - 1rem));
    }
  }

  /* Keep the enlarged close action separate from scrollable navigation. */
  .mobile-menu-close-row {
    display: flex;
    flex: none;
    justify-content: flex-end;
  }

  /* Double the standard three-rem circular menu close target. */
  .mobile-menu-close {
    width: 6rem;
    height: 6rem;
    min-width: 6rem;
    min-height: 6rem;
    padding: 0;
  }

  /* Scale the close glyph with its doubled button target. */
  .mobile-menu-close-icon {
    font-size: 3rem;
    line-height: 1;
  }

  /* Let long navigation scroll without moving the footer actions. */
  dialog > :global(nav[aria-label="Основная навигация"]) {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
  }

  /* Separate the contact row from navigation with a visible rule. */
  .mobile-menu-divider {
    flex: none;
    width: calc(100% - 2rem);
    margin: 0 1rem;
    border: 0;
    border-top: 1px solid var(--color-base-300);
  }

  /* Keep both contact actions aligned in one bottom row. */
  .mobile-menu-actions {
    display: grid;
    flex: none;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    padding: 1rem;
  }

  /* Match text size and alignment on the phone and Max buttons. */
  .mobile-menu-actions :global(.mobile-menu-action) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    min-width: 0;
    min-height: 3rem;
    height: auto;
    padding: 0.5rem;
    font-size: 0.875rem;
    white-space: normal;
  }

  /* Keep the Max contact white with the logo-color outline. */
  .mobile-menu-actions :global(.mobile-menu-max) {
    background-color: #fff;
    border: 1px solid #1688f5;
    color: #1688f5;
    box-shadow: none;
  }

  /* Invert Max colors for pointer hover without adding a shadow. */
  @media (hover: hover) and (pointer: fine) {
    /* Keep the mobile Max action white until the pointer hovers. */
    .mobile-menu-actions :global(.mobile-menu-max:hover) {
      background-color: #1688f5;
      border-color: #fff;
      color: #fff;
      box-shadow: none;
    }
  }

  /* Keep keyboard focus visible without adding a button shadow. */
  .mobile-menu-actions :global(.mobile-menu-max:focus-visible) {
    outline: 2px solid #1688f5;
    outline-offset: 3px;
    box-shadow: none;
  }

  /* Dim background content while modal navigation is open. */
  dialog::backdrop {
    background: rgb(0 0 0 / 40%);
  }

  /* Respect motion preferences for drawer entrance. */
  @media (prefers-reduced-motion: reduce) {
    /* Open the drawer without motion for reduced-motion visitors. */
    dialog {
      transition: none;
    }
  }

  /* Prevent background scrolling while the modal drawer is active. */
  :global(body:has(#mobile-menu[open])) {
    overflow: hidden;
  }
</style>

<script>
  const opener = document.querySelector<HTMLButtonElement>("#mobile-menu-open");
  const menu = document.querySelector<HTMLDialogElement>("#mobile-menu");

  // Enhance only when the shared header and native dialog are both present.
  if (opener && menu) {
    // Open the native modal before exposing its expanded state.
    const openMenu = () => {
      menu.showModal();
      opener.setAttribute("aria-expanded", "true");
    };

    const closeMenu = () => {
      menu.close();
    };

    // Restore opener focus when native close, including Escape, completes.
    const handleMenuClose = () => {
      opener.setAttribute("aria-expanded", "false");
      // Safari does not focus buttons on pointer activation automatically.
      opener.focus({ preventScroll: true });
    };

    // Wrap Tab at the modal boundaries and leave other keys to the dialog.
    const handleMenuKeydown = (event: KeyboardEvent) => {
      if (event.key !== "Tab") {
        return;
      }

      const controls = menu.querySelectorAll<HTMLElement>("button, a[href]");
      const first = controls[0];
      const last = controls[controls.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    };

    // Dismiss clicks on the backdrop without closing for inside clicks.
    const handleBackdropClick = (event: MouseEvent) => {
      if (event.target !== menu) {
        return;
      }

      const bounds = menu.getBoundingClientRect();
      const outsideBounds =
        event.clientX < bounds.left ||
        event.clientX > bounds.right ||
        event.clientY < bounds.top ||
        event.clientY > bounds.bottom;

      if (outsideBounds) {
        closeMenu();
      }
    };

    // Add a temporary focus target only when the section lacks tabindex.
    const makeSectionTemporarilyFocusable = (section: HTMLElement) => {
      if (section.hasAttribute("tabindex")) {
        return;
      }

      section.setAttribute("tabindex", "-1");
      const removeTemporaryTabindex = () => {
        section.removeAttribute("tabindex");
      };
      section.addEventListener("blur", removeTemporaryTabindex, { once: true });
    };

    // Register after handleMenuClose so section focus wins after close.
    const focusSectionAfterClose = (section: HTMLElement) => {
      const handleClosedSectionFocus = () => {
        section.focus({ preventScroll: true });
      };
      menu.addEventListener("close", handleClosedSectionFocus, { once: true });
    };

    // Preserve modifiers and the existing same-page path/hash navigation.
    const handleMenuLinkClick = (
      event: MouseEvent,
      link: HTMLAnchorElement,
    ) => {
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) {
        return;
      }

      const destination = new URL(link.href);
      const isSamePageHash =
        destination.pathname === location.pathname && destination.hash;

      if (!isSamePageHash) {
        closeMenu();
        return;
      }

      event.preventDefault();
      history.pushState(null, "", destination.pathname + destination.hash);

      const sectionId = decodeURIComponent(destination.hash.slice(1));
      const section = document.getElementById(sectionId);

      if (section) {
        makeSectionTemporarilyFocusable(section);
        // The close event restores opener focus before focusing this section.
        focusSectionAfterClose(section);
      }

      closeMenu();
    };

    // Close the drawer when desktop layout hides the opener.
    const closeMenuWhenOpenerDisappears = () => {
      if (menu.open && opener.getClientRects().length === 0) {
        closeMenu();
      }
    };

    opener.addEventListener("click", openMenu);
    menu.addEventListener("close", handleMenuClose);
    menu.addEventListener("keydown", handleMenuKeydown);
    menu
      .querySelector("[data-menu-close]")
      ?.addEventListener("click", closeMenu);
    menu.addEventListener("click", handleBackdropClick);

    menu.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
      link.addEventListener("click", (event) => {
        handleMenuLinkClick(event, link);
      });
    });

    window.addEventListener("resize", closeMenuWhenOpenerDisappears);
  }
</script>
