---
// Render the validated site address as a map-linked header action.
import { MapPin } from "@lucide/astro";

interface Props {
  address: string;
}

const { address } = Astro.props;
---

<a
  class="header-address"
  href="/#contacts"
>
  <MapPin
    size={20}
    aria-hidden="true"
  />
  <span>{address}</span>
</a>

<style>
  /* Reserve the address for layouts with room beside the brand. */
  .header-address {
    display: none;
    min-width: 0;
    margin-inline-start: auto;
    color: var(--color-base-content);
    overflow-wrap: anywhere;
  }

  /* Keep the map mark fixed while the address text wraps. */
  .header-address svg {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
  }

  /* Allow long addresses to wrap inside the available header space. */
  .header-address span {
    min-width: 0;
  }

  /* Show the address beside the brand on tablet and desktop layouts. */
  @media (min-width: 48rem) {
    /* Keep the address group close to the actions that follow it. */
    .header-address {
      display: inline-flex;
      align-items: center;
      justify-content: flex-end;
      flex: 0 1 12rem;
      gap: 0.75rem;
      margin-inline-start: auto;
      margin-inline-end: 1rem;
    }
  }

  /* Give wide desktop layouts more room for the full address. */
  @media (min-width: 64rem) {
    /* Keep the address from competing with the header controls. */
    .header-address {
      flex-basis: 24rem;
    }
  }

  /* Underline the contact destination only for precise pointer devices. */
  @media (min-width: 48rem) and (hover: hover) and (pointer: fine) {
    /* Make the linked address visibly respond to mouse hover. */
    .header-address:hover {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }
</style>
