---
// Render ordered statistic labels and values as a responsive definition list.

import type { Stat } from "@/types/stat";

interface Props {
  items: readonly Stat[];
  class?: string;
}

const { items, class: className, ...attributes } = Astro.props;
---

<dl
  class:list={["stat-list", className]}
  {...attributes}
>
  {items.map((stat) => (
    <div>
      <dt>{stat.label}</dt>
      <dd>{stat.value}</dd>
    </div>
  ))}
</dl>

<style>
  /* Separate supplied statistics in a responsive grid. */
  .stat-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  /* Keep each statistic and its label together. */
  .stat-list div {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* Wrap long statistic labels using muted text. */
  .stat-list dt {
    color: var(--site-muted);
    overflow-wrap: anywhere;
  }

  /* Lead each statistic with its supplied brand-colored value. */
  .stat-list dd {
    order: -1;
    font-size: 2rem;
    line-height: 1.2;
    font-weight: 700;
    color: var(--color-brand);
    margin-bottom: 0.5rem;
    overflow-wrap: anywhere;
  }

  /* Stack statistics when three readable columns no longer fit. */
  @media (max-width: 35rem) {
    /* Give each statistic the complete narrow-screen width. */
    .stat-list {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    /* Pair each value and label on one wrapping row. */
    .stat-list div {
      flex-direction: row;
      align-items: baseline;
      gap: 1rem;
    }

    /* Align values with a shared minimum measure. */
    .stat-list dd {
      margin-bottom: 0;
      min-width: 5ch;
    }
  }
</style>
