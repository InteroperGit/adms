---
// Render supplied navigation items and a native telephone action.
// The required variant selects desktop links or the mobile list.
// Layout breakpoints hide desktop navigation until there is enough room.

import type { MenuItem } from '@/types';
import Button from '@/components/ui/Button.astro';
import MaxLogo from '@/components/ui/MaxLogo.astro';

// Caller-supplied data and presentation options for this component.
export interface Props {
  items: MenuItem[];
  variant: 'desktop' | 'mobile';
  phone: string;
}

const { items, variant, phone } = Astro.props;
---

{/* Layout breakpoints hide desktop navigation until there is enough room. */}
{variant === 'desktop' ? (
  <nav aria-label="Основная навигация" class="desktop-nav">
    {items.map((item) => (
      <a href={item.href} class="section-link link link-hover">
        {item.label}
      </a>
    ))}
    <Button
      variant="outline"
      size="sm"
      href={`tel:${phone.replace(/\s/g, '')}`}
      class="header-phone"
    >
      {phone}
    </Button>
    {/* Keep the Макс contact action directly beside the phone action. */}
    <a
      href="https://max.ru/"
      class="max-contact btn btn-sm"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Написать в Макс"
    >
      <MaxLogo />
      <span>Написать в Макс</span>
    </a>
  </nav>
) : (
  <nav aria-label="Основная навигация">
    <ul class="mobile-links menu p-4 bg-base-200 text-base-content gap-3">
      {items.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
        </li>
      ))}
      <li>
        {/* The telephone action uses its native protocol destination. */}
        <Button
          variant="primary"
          size="md"
          href={`tel:${phone.replace(/\s/g, '')}`}
          class="btn-block mt-4"
        >
          Позвонить
        </Button>
      </li>
      <li>
        {/* Keep messenger contact available in the mobile drawer. */}
        <a
          href="https://max.ru/"
          class="max-contact btn btn-secondary btn-block mt-2"
          target="_blank"
          rel="noopener noreferrer"
        >
          <MaxLogo />
          <span>Написать в Макс</span>
        </a>
      </li>
    </ul>
  </nav>
)}

<style>
  /* Show the wide navigation only when its breakpoint permits. */
  .desktop-nav {
    display: none;
  }

  /* Show wide navigation when header space can accommodate its links. */
  @media (min-width: 64rem) {
    /* Wrap wide links and align the contact action at the row end. */
    .desktop-nav {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 0.5rem 1.25rem;
      flex: 0 1 auto;
      max-width: 100%;
    }
  }

  /* Keep section links wrappable with generous native targets. */
  .section-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    overflow-wrap: anywhere;
  }

  /* Allow the telephone button label to wrap without clipping. */
  .desktop-nav :global(.header-phone) {
    white-space: normal;
    height: auto;
    min-height: var(--size);
    padding-block: 0.25rem;
  }

  /* Align the Макс mark and label as a single compact contact action. */
  .max-contact {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: normal;
    height: auto;
    min-height: var(--size);
    padding-block: 0.25rem;
  }

  /* Fill the drawer width with the supplied navigation list. */
  .mobile-links {
    width: 100%;
  }

  /* Wrap long mobile labels while preserving target height. */
  .mobile-links a {
    white-space: normal;
    overflow-wrap: anywhere;
    min-height: 2.75rem;
  }
</style>
