---
// Render supplied navigation items and contact actions in one semantic list.
// The variant changes presentation and phone copy, while links stay native.
// Layout breakpoints hide desktop navigation until there is enough room.

import type { MenuItem } from '@/types';
import Button from '@/components/ui/Button.astro';
import MaxLogo from '@/components/ui/MaxLogo.astro';

// Caller-supplied data and presentation options for this component.
export interface Props {
  items: MenuItem[];
  variant: 'desktop' | 'mobile';
  phone: string;
}

const { items, variant, phone } = Astro.props;
const isDesktop = variant === 'desktop';
const phoneHref = `tel:${phone.replace(/\s/g, '')}`;
---

{/* One list keeps desktop and mobile navigation order identical. */}
<nav
  aria-label="Основная навигация"
  class:list={['nav-shell', { 'desktop-nav': isDesktop }]}
>
  <ul
    class:list={[
      'nav-list',
      {
        'mobile-links menu p-4 bg-base-200 text-base-content gap-3':
          !isDesktop,
      },
    ]}
  >
    {items.map((item) => (
      <li class="nav-item">
        <a
          href={item.href}
          class:list={[
            { 'section-link link link-hover': isDesktop },
          ]}
        >
          {item.label}
        </a>
      </li>
    ))}
    {/* The phone label and button treatment follow the active variant. */}
    <li class="nav-item">
      <Button
        variant={isDesktop ? 'outline' : 'primary'}
        size={isDesktop ? 'sm' : 'md'}
        href={phoneHref}
        class={isDesktop ? 'header-phone' : 'btn-block mt-4'}
      >
        {isDesktop ? phone : 'Позвонить'}
      </Button>
    </li>
    {/* Keep the Макс action after the phone action in both modes. */}
    <li class="nav-item">
      <a
        href="https://max.ru/"
        class:list={[
          'max-contact',
          isDesktop ? 'btn btn-sm' : 'btn btn-secondary btn-block mt-2',
        ]}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Написать в Макс"
      >
        <MaxLogo />
        <span>Написать в Макс</span>
      </a>
    </li>
  </ul>
</nav>

<style>
  /* Show the wide navigation only when its breakpoint permits. */
  .desktop-nav {
    display: none;
  }

  /* Show wide navigation when header space can accommodate its links. */
  @media (min-width: 64rem) {
    /* Wrap wide links and align the contact action at the row end. */
    .desktop-nav {
      display: block;
      flex: 0 1 auto;
      max-width: 100%;
    }

    /* Arrange wide links and contact actions in one wrapping row. */
    .desktop-nav .nav-list {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 0.5rem 1.25rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
  }

  /* Keep each desktop list item aligned without changing list semantics. */
  .desktop-nav .nav-item {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
  }

  /* Keep section links wrappable with generous native targets. */
  .section-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    overflow-wrap: anywhere;
  }

  /* Allow the telephone button label to wrap without clipping. */
  .desktop-nav :global(.header-phone) {
    white-space: normal;
    height: auto;
    min-height: var(--size);
    padding-block: 0.25rem;
  }

  /* Align the Макс mark and label as a single compact contact action. */
  .max-contact {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: normal;
    height: auto;
    min-height: var(--size);
    padding-block: 0.25rem;
  }

  /* Fill the drawer width with the supplied navigation list. */
  .mobile-links {
    width: 100%;
  }

  /* Keep the mobile list semantics while removing browser list markers. */
  .mobile-links .nav-item {
    list-style: none;
  }

  /* Wrap long mobile labels while preserving target height. */
  .mobile-links a {
    white-space: normal;
    overflow-wrap: anywhere;
    min-height: 2.75rem;
  }
</style>
