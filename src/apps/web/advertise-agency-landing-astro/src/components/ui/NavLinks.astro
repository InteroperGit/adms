---
// src/components/ui/NavLinks.astro
import type { MenuItem } from '@/types';
import Button from '@/components/ui/Button.astro';

export interface Props {
  items: MenuItem[];
  variant: 'desktop' | 'mobile';
  phone: string;
}

const { items, variant, phone } = Astro.props;
---

{
  variant === 'desktop' ? (
    <nav aria-label="Основная навигация" class="desktop-nav">
      {items.map((item) => (
        <a href={item.href} class="section-link link link-hover">{item.label}</a>
      ))}
      <Button variant="outline" size="sm" href={`tel:${phone.replace(/\s/g, '')}`} class="header-phone">
        {phone}
      </Button>
    </nav>
  ) : (
    <nav aria-label="Основная навигация">
    <ul class="mobile-links menu p-4 bg-base-200 text-base-content gap-3">
      {items.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
      <li>
        <Button variant="primary" size="md" href={`tel:${phone.replace(/\s/g, '')}`} class="btn-block mt-4">
          Позвонить
        </Button>
      </li>
    </ul>
    </nav>
  )
}

<style>
  .desktop-nav { display: none; }
  @media (min-width: 64rem) {
    .desktop-nav { display: flex; align-items: center; flex-wrap: wrap; justify-content: flex-end; gap: 0.5rem 1.25rem; flex: 0 1 auto; max-width: 100%; }
  }
  .section-link { display: inline-flex; align-items: center; min-height: 2.75rem; overflow-wrap: anywhere; }
  .desktop-nav :global(.header-phone) { white-space: normal; height: auto; min-height: var(--size); padding-block: 0.25rem; }
  .mobile-links { width: 100%; }
  .mobile-links a { white-space: normal; overflow-wrap: anywhere; min-height: 2.75rem; }
</style>
