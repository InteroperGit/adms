---
// src/components/ui/NavLinks.astro
import type { MenuItem } from '@/types';
import Button from '@/components/ui/Button.astro';

export interface Props {
  items: MenuItem[];
  variant: 'desktop' | 'mobile';
  phone: string;
}

const { items, variant, phone } = Astro.props;
---

{
  variant === 'desktop' ? (
    <div class="hidden md:flex items-center gap-6">
      {items.map((item) => (
        <a href={item.href} class="link link-hover">{item.label}</a>
      ))}
      <Button variant="outline" size="sm" href={`tel:${phone.replace(/\s/g, '')}`}>
        {phone}
      </Button>
    </div>
  ) : (
    <ul data-mobile-nav class="menu p-4 w-72 min-h-full bg-base-200 text-base-content gap-3">
      {items.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
      <li>
        <Button variant="primary" size="md" href={`tel:${phone.replace(/\s/g, '')}`} class="btn-block mt-4">
          Позвонить
        </Button>
      </li>
    </ul>
  )
}

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-mobile-nav] a').forEach((link) => {
    link.addEventListener('click', () => {
      const drawer = document.querySelector<HTMLInputElement>('#mobile-drawer');
      if (drawer) drawer.checked = false;
    });
  });
</script>
