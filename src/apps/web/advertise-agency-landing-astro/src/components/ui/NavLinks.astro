---
// src/components/ui/NavLinks.astro
import type { MenuItem } from '@/types';

export interface Props {
  items: MenuItem[];
  variant: 'desktop' | 'mobile';
  phone: string;
}

const { items, variant, phone } = Astro.props;
---

{
  variant === 'desktop' ? (
    <div class="hidden md:flex items-center gap-6">
      {items.map((item) => (
        <a href={item.href} class="link link-hover">{item.label}</a>
      ))}
      <a href={`tel:${phone.replace(/\s/g, '')}`} class="btn btn-outline btn-sm">{phone}</a>
    </div>
  ) : (
    <ul class="menu p-4 w-72 min-h-full bg-base-200 text-base-content gap-3">
      {items.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
      <li>
        <a href={`tel:${phone.replace(/\s/g, '')}`} class="btn btn-primary btn-block mt-4">Позвонить</a>
      </li>
    </ul>
  )
}