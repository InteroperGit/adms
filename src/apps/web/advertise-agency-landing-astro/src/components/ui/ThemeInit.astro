---
// Apply stored or system theme synchronously before page styles can paint.
// Keep this script inline in the head; delayed enhancement would flash.
// Blocked storage falls back to an in-memory system preference.
---

{/*
  Blocking head script: apply the preference before styles/content can paint.
*/}
<script is:inline>
  (() => {
    const key = 'site-theme';
    const valid = (value) => ['light', 'dark', 'system'].includes(value);
    const media = window.matchMedia('(prefers-color-scheme: dark)');
    let preference = 'system';
    try {
      const stored = localStorage.getItem(key);
      if (valid(stored)) preference = stored;
    } catch {
      /* Storage can be disabled; keep an in-memory preference. */
    }
    // Resolve system preference and synchronize existing native radio controls.
    const apply = () => {
      const effective =
        preference === 'system'
          ? media.matches
            ? 'dark'
            : 'light'
          : preference;
      document.documentElement.dataset.theme = effective;
      document.documentElement.style.colorScheme = effective;
      document.querySelectorAll('[data-theme-radio]').forEach((control) => {
        control.checked = control.value === preference;
      });
    };
    // Run synchronously in the head, before DOM-ready control enhancement.
    apply();
    // System changes affect only visitors who chose the system preference.
    media.addEventListener('change', () => {
      if (preference === 'system') apply();
    });
    // Synchronize other tabs while ignoring unrelated or inaccessible storage.
    window.addEventListener('storage', (event) => {
      try {
        if (event.storageArea !== localStorage) return;
      } catch {
        return;
      }
      if (event.key !== key && event.key !== null) return;
      preference = valid(event.newValue) ? event.newValue : 'system';
      apply();
    });
    // Reveal controls only after their radio handlers can apply preferences.
    document.addEventListener('DOMContentLoaded', () => {
      apply();
      document
        .querySelectorAll('[data-theme-control]')
        .forEach((control) => {
          control.hidden = false;
        });
      document.querySelectorAll('[data-theme-radio]').forEach((control) => {
        control.addEventListener('change', () => {
          if (!valid(control.value)) return;
          preference = control.value;
          apply();
          try {
            localStorage.setItem(key, preference);
          } catch {
            /* The current page remains usable. */
          }
        });
      });
    });
  })();
</script>
