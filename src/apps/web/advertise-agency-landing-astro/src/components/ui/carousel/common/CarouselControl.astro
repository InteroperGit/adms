---
// Render one accessible control contract for carousel and gallery consumers.
interface CommonProps {
  label: string;
  className?: string;
  dataCylinder?: "previous" | "next";
}

type Props = CommonProps &
  (
    | {
        variant?: "arrow";
        direction: "previous" | "next";
        dataDirection?: "-1" | "1";
        dataGallery?: "previous" | "next";
        appearance?: "default" | "circle";
      }
    | {
        variant: "close";
        direction?: never;
        dataDirection?: never;
        dataGallery?: "close";
        appearance?: never;
      }
  );

const props = Astro.props as Props;
const variant = props.variant ?? "arrow";
const direction = variant === "arrow" ? props.direction : undefined;
const isClose = variant === "close";
const appearance =
  props.variant === "close" ? "default" : (props.appearance ?? "default");
const controlVariant = isClose
  ? "carousel-control-close"
  : "carousel-control-arrow";
const iconPath = isClose
  ? "M6 6l12 12M18 6L6 18"
  : direction === "previous"
    ? "m15 5-7 7 7 7"
    : "m9 5 7 7-7 7";
const directionMarker = isClose ? undefined : props.dataDirection;
const galleryMarker = isClose
  ? props.dataGallery === "close"
    ? "close"
    : undefined
  : props.dataGallery;
---

<button
  type="button"
  class:list={[
    "carousel-control",
    controlVariant,
    appearance === "circle" && "carousel-control-circle",
    props.className,
  ]}
  aria-label={props.label}
  data-direction={directionMarker}
  data-gallery-close={galleryMarker === "close" ? true : undefined}
  data-gallery-previous={galleryMarker === "previous" ? true : undefined}
  data-gallery-next={galleryMarker === "next" ? true : undefined}
  data-cylinder-prev={props.dataCylinder === "previous" ? true : undefined}
  data-cylinder-next={props.dataCylinder === "next" ? true : undefined}
>
  <svg
    viewBox="0 0 24 24"
    aria-hidden="true"
    focusable="false"
  >
    <path d={iconPath} />
  </svg>
</button>

<style>
  /* Keep every control large enough for touch and keyboard activation. */
  .carousel-control {
    display: grid;
    place-items: center;
    box-sizing: border-box;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  /* Center the vector glyph independently of font metrics. */
  .carousel-control svg {
    display: block;
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  /* Give card carousel arrows a distinct surface without changing defaults. */
  .carousel-control-circle {
    border: 1px solid var(--site-control-border);
    border-radius: 50%;
    color: var(--color-base-content);
    background: var(--color-base-100);
  }

  /* Keep circular arrows visible against either theme on hover. */
  .carousel-control.carousel-control-circle:hover {
    color: var(--color-base-content);
    background: var(--color-base-200);
  }

  /* Double the V glyph while keeping gallery arrows at their base size. */
  .carousel-control-arrow.carousel-arrow svg {
    width: 2.7rem;
    height: 2.7rem;
  }

  /* Touch taps must not retain the mouse hover appearance. */
  @media (hover: hover) and (pointer: fine) {
    /* Invert the control colors when a mouse points at the button. */
    .carousel-control:hover {
      color: #111827;
      background: #fff;
    }
  }

  /* Keep keyboard focus as visible as mouse hover. */
  .carousel-control:focus-visible {
    outline: 3px solid white;
    outline-offset: 3px;
    box-shadow: 0 0 0 8px rgb(0 0 0 / 80%);
  }

  /* Remove control transitions for visitors who request less motion. */
  @media (prefers-reduced-motion: reduce) {
    /* Keep state changes immediate while preserving control feedback. */
    .carousel-control {
      transition: none;
    }
  }
</style>
