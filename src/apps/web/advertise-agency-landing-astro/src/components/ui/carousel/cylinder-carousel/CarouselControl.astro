---
interface Props {
  direction: "previous" | "next";
  label: string;
  className?: string;
  dataCylinder?: "previous" | "next";
}

const { direction, label, className, dataCylinder } = Astro.props;
const path = direction === "previous" ? "m15 5-7 7 7 7" : "m9 5 7 7-7 7";
---

<button
  type="button"
  class:list={["carousel-control", "cylinder-arrow", className]}
  aria-label={label}
  data-cylinder-prev={dataCylinder === "previous" ? true : undefined}
  data-cylinder-next={dataCylinder === "next" ? true : undefined}
>
  <svg
    viewBox="0 0 24 24"
    aria-hidden="true"
    focusable="false"
  >
    <path d={path} />
  </svg>
</button>

<style>
  .carousel-control {
    display: grid;
    place-items: center;
    box-sizing: border-box;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    border: 0;
    color: #fff;
    background: transparent;
    cursor: pointer;
    pointer-events: auto;
  }

  .carousel-control svg {
    display: block;
    width: 2.7rem;
    height: 2.7rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .carousel-control:hover,
  .carousel-control:active {
    color: #fff;
    background: transparent;
  }

  .carousel-control:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
    background: transparent;
    box-shadow: none;
  }
</style>
