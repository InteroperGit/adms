---
// Render caller-provided cards in a manually controlled scroll-snap region.
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import { z } from "astro/zod";
import CarouselControl from "./CarouselControl.astro";

interface Props {
  Item: AstroComponentFactory;
  items: Record<string, unknown>[];
  label: string;
  ordered?: boolean;
}

const {
  Item,
  items: suppliedItems,
  label: suppliedLabel,
  ordered,
} = Astro.props;
if (Astro.slots.has("default")) {
  throw new Error("CardCarousel accepts items and Item props, not slot cards");
}
if (typeof Item !== "function") {
  throw new Error("CardCarousel needs an Astro Item component");
}
const props = z
  .object({
    items: z
      .array(z.record(z.string(), z.unknown()))
      .min(1, "CardCarousel needs at least one item"),
    label: z.string().trim().min(1, "CardCarousel needs an accessible label"),
    ordered: z.boolean().default(false),
  })
  .parse({ items: suppliedItems, label: suppliedLabel, ordered });
const { items, label, ordered: isOrdered } = props;
---

<section
  class="card-carousel"
  role="region"
  aria-label={label}
  aria-roledescription="карусель"
>
  <div
    class="card-carousel-viewport"
    tabindex="0"
  >
    {isOrdered ? (
      <ol class="card-carousel-track card-carousel-list">
        {items.map((item) => (
          <li>
            <Item {...item} />
          </li>
        ))}
      </ol>
    ) : (
      <div class="card-carousel-track">
        {items.map((item) => (
          <Item {...item} />
        ))}
      </div>
    )}
  </div>
  <div
    class="card-carousel-controls"
    hidden
  >
    <CarouselControl
      direction="previous"
      dataDirection="-1"
      className="card-carousel-arrow"
      appearance="circle"
      label={`Предыдущие карточки: ${label}`}
    />
    <CarouselControl
      direction="next"
      dataDirection="1"
      className="card-carousel-arrow"
      appearance="circle"
      label={`Следующие карточки: ${label}`}
    />
  </div>
</section>

<script>
  import { initializeCardCarousels } from "./cardCarouselRuntime";

  initializeCardCarousels();
</script>

<style>
  /* Anchor the overlay arrows to the visible scrolling region. */
  .card-carousel {
    min-width: 0;
    position: relative;
  }

  /* Center arrows at the viewport edges without changing its layout. */
  .card-carousel-controls {
    align-items: center;
    display: flex;
    inset-inline: 0.75rem;
    justify-content: space-between;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1;
  }

  /* Hide the panel and let wheel gestures pass between the arrows. */
  .card-carousel-controls {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  /* Reveal arrows on hover or while keyboard-visible focus is inside. */
  .card-carousel:hover .card-carousel-controls,
  .card-carousel:has(:focus-visible) .card-carousel-controls {
    opacity: 1;
    visibility: visible;
  }

  /* Keep controls absent when every card fits or scripting is unavailable. */
  .card-carousel-controls[hidden] {
    display: none;
  }

  /* Preserve card space and swipe scrolling on mobile. */
  @media (max-width: 47.999rem) {
    /* Keep mobile swipe unobstructed and leave buttons out of the layout. */
    .card-carousel-controls {
      display: none;
    }
  }

  /* Keep each arrow targetable without blocking gestures across the panel. */
  .card-carousel :global(.card-carousel-arrow) {
    flex: 0 0 44px;
    pointer-events: auto;
    width: 44px;
    height: 44px;
  }

  /* Keep unavailable directions distinct while preserving their hit area. */
  .card-carousel :global(.card-carousel-arrow:disabled) {
    cursor: not-allowed;
    opacity: 0.5;
  }

  /* Contain touch scrolling and preserve a keyboard focus destination. */
  .card-carousel-viewport {
    cursor: grab;
    min-width: 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  /* Prevent card text selection while the mouse button is held. */
  .card-carousel-viewport.is-mouse-pressed,
  .card-carousel-viewport.is-mouse-pressed :global(*) {
    cursor: grabbing;
    user-select: none;
  }

  /* Hide only decorative scrollbar chrome, not scroll affordance or content. */
  .card-carousel-viewport::-webkit-scrollbar {
    display: none;
  }

  /* Keep keyboard focus visible on the horizontal scrolling surface. */
  .card-carousel-viewport:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
  }

  /* Preserve card order and let the viewport clip only offscreen neighbors. */
  .card-carousel-track {
    display: flex;
    align-items: stretch;
    gap: 1rem;
    min-width: 100%;
  }

  /* Reset native list spacing when the track carries ordered semantics. */
  .card-carousel-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Snap caller cards consistently while retaining their intrinsic height. */
  .card-carousel-track :global(> *) {
    box-sizing: border-box;
    flex: 0 0 min(86vw, 17rem);
    min-width: 0;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  /* Finish at the final card's right edge instead of leaving trailing space. */
  .card-carousel-track :global(> :last-child) {
    scroll-snap-align: end;
  }

  /* Let a single card use the whole region without an empty preview area. */
  .card-carousel-track:has(:global(> :only-child)) :global(> *) {
    flex-basis: 100%;
  }

  /* Remove programmatic and touch-scroll animation for reduced motion. */
  @media (prefers-reduced-motion: reduce) {
    /* Keep swipe and button movement immediate for this scrolling region. */
    .card-carousel-viewport {
      scroll-behavior: auto;
    }
  }
</style>
