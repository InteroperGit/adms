---
// Shared image carousel: static HTML first, instance-local enhancement later.
// Callers own content/section layout; options only control optional features.
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import CarouselControl from "./CarouselControl.astro";
import CarouselDots from "../common/CarouselDots.astro";
import type {
  CarouselItem,
  CarouselOptions,
  CarouselPresentation,
} from "@/types/imageCarousel";
import {
  carouselItemsSchema,
  carouselOptionsSchema,
} from "@/validation/imageCarousel";

interface Props {
  Item: AstroComponentFactory;
  // IDs must be unique on the page; they namespace slides and controls.
  id: string;
  label: string;
  itemLabel?: string;
  slideIdPrefix?: string;
  items: Array<
    Omit<CarouselItem, "enabled" | "presentation"> & {
      enabled?: boolean;
      presentation?: Partial<CarouselPresentation>;
    }
  >;
  options?: Partial<CarouselOptions>;
}

const {
  Item,
  id,
  label,
  itemLabel = "Изображение",
  slideIdPrefix = `${id}-slide`,
  items: suppliedItems,
  options: suppliedOptions = {},
} = Astro.props;
if (Astro.slots.has("default")) {
  throw new Error(
    "ImageCarousel accepts items and Item props, not slide slots",
  );
}
if (typeof Item !== "function") {
  throw new Error("ImageCarousel needs an Astro Item component");
}
if (!/^[a-zA-Z][\w-]*$/.test(id) || !label.trim()) {
  throw new Error("ImageCarousel needs a unique HTML id and a label");
}
const options = (() => {
  try {
    return carouselOptionsSchema.parse(suppliedOptions);
  } catch (error) {
    throw new Error(`ImageCarousel options are invalid: ${String(error)}`);
  }
})();
const parsedItems = (() => {
  try {
    return carouselItemsSchema.parse(suppliedItems);
  } catch (error) {
    throw new Error(`ImageCarousel items are invalid: ${String(error)}`);
  }
})();
// Add ten percent to the existing one-third panel height increase.
const panelRatio = options.aspectRatio * (0.75 / 1.1);
const items = parsedItems.filter((item) => item.enabled);
const itemName = itemLabel.toLowerCase();
const multiple = items.length > 1;
const arrows = multiple && options.manualNavigation && options.arrows;
const circles = multiple && options.circles;
---

{/* The first slide renders immediately; optional controls start hidden. */}
{options.enabled && items.length > 0 && (
  <image-carousel
    id={id}
    class="image-carousel"
    role="region"
    aria-label={label}
    data-item-label={itemLabel}
    data-autoplay={options.autoplay}
    data-interval={options.intervalMs}
    data-manual={options.manualNavigation}
    data-layout={options.layout}
    data-arrows={arrows}
    data-circles={circles}
    data-animation={options.animation}
    style={{
      "--panel-ratio": panelRatio,
      "--image-fit": options.imageFit,
    }}
  >
    {/* Arrows and interactive/passive circles are independently optional. */}
    {(arrows || circles) && (
      <div
        class="carousel-controls"
        hidden
      >
        {arrows && (
          <CarouselControl
            direction="previous"
            className="carousel-arrow"
            dataDirection="-1"
            label={`Предыдущее: ${itemName}`}
          />
        )}
        {circles && (
          <CarouselDots
            items={items}
            itemName={itemName}
            slideIdPrefix={slideIdPrefix}
            manualNavigation={options.manualNavigation}
          />
        )}
        {arrows && (
          <CarouselControl
            direction="next"
            className="carousel-arrow"
            dataDirection="1"
            label={`Следующее: ${itemName}`}
          />
        )}
      </div>
    )}
    {/* All slides remain in editorial order in the static fallback. */}
    <div class="carousel-list">
      {items.map((item, index) => (
        <Item
          id={`${slideIdPrefix}-${item.id}`}
          item={item}
          index={index}
          total={items.length}
          itemLabel={itemLabel}
          options={options}
        />
      ))}
    </div>
    {/* Only manual changes need a polite announcement. */}
    {options.manualNavigation && (arrows || circles) && (
      <span
        class="sr-only"
        role="status"
        aria-atomic="true"
      ></span>
    )}
  </image-carousel>
)}

<script>
  // Astro bundles this browser-only module once for all carousel instances.
  import "./imageCarouselRuntime";
</script>

<style>
  /* Anchor overlaid controls and share their spacing with slide content. */
  .image-carousel {
    display: block;
    width: 100%;
    min-width: 0;
    position: relative;
    --arrow-size: clamp(112px, 10vw, 144px);
    --dot-size: 2.75rem;
    --control-inset: clamp(0.5rem, 1vw, 0.75rem);
    --arrow-inset: clamp(0.5rem, 1vw, 0.75rem);
    --arrow-icon-shift: 0px;
    --control-gap: clamp(12px, 1rem, 20px);
  }

  /* Keep mobile controls inset while bringing them near the edges. */
  @media (max-width: 63.999rem) {
    /* Preserve a small gap for the hit area and align its glyph outward. */
    .image-carousel {
      --arrow-inset: clamp(0.5rem, 1.25vw, 0.75rem);
      --arrow-icon-shift: clamp(2.25rem, 9.5vw, 2.375rem);
    }

    /* Place the left chevron a few pixels inside the carousel edge. */
    .image-carousel :global(.carousel-arrow[data-direction="-1"] svg) {
      transform: translateX(calc(-1 * var(--arrow-icon-shift)));
    }

    /* Place the right chevron a few pixels inside the carousel edge. */
    .image-carousel :global(.carousel-arrow[data-direction="1"] svg) {
      transform: translateX(var(--arrow-icon-shift));
    }
  }

  /* Give tablet controls more breathing room than phone controls. */
  @media (min-width: 30.01rem) and (max-width: 63.999rem) {
    /* Use a medium inset between the phone and desktop sizes. */
    .image-carousel {
      --arrow-inset: clamp(1rem, 2vw, 1.25rem);
    }
  }

  /* Stack enabled slides in editorial order. */
  .carousel-list {
    display: grid;
  }

  /* Hide inactive server-rendered slides before the client script runs. */
  .image-carousel:not([data-ready])
    :global(.carousel-slide[aria-hidden="true"]) {
    grid-area: 1 / 1;
    visibility: hidden;
    pointer-events: none;
  }

  /* Overlay navigation without blocking pointer access to the slide. */
  .carousel-controls {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    color: var(--color-base-content);
  }

  /* Reveal navigation only when the script has initialized all slides. */
  .carousel-controls[hidden] {
    display: none;
  }

  /* Make arrows and dots comfortably reachable with pointer or touch. */
  .image-carousel :global(.carousel-arrow) {
    display: grid;
    place-items: center;
    width: var(--arrow-size);
    height: var(--arrow-size);
    flex: 0 0 auto;
    border-radius: 50%;
    color: inherit;
    cursor: pointer;
  }

  /* Keep arrow targets open while giving the controls a larger hit area. */
  .image-carousel :global(.carousel-arrow) {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    color: #e5e7eb;
    background: transparent;
    border: 0;
    border-radius: 0;
    filter: drop-shadow(0 0 2px #000);
    pointer-events: auto;
    transition:
      color 160ms ease,
      filter 160ms ease;
  }

  /* Brighten and lift the arrow on hover without adding a button fill. */
  .image-carousel :global(.carousel-arrow:hover) {
    color: #fff;
    background: transparent;
    border: 0;
    filter: drop-shadow(0 0 2px #000)
      drop-shadow(0 0 6px rgb(255 255 255 / 75%));
  }

  /* Place previous navigation inside the left image edge. */
  .image-carousel :global(.carousel-arrow)[data-direction="-1"] {
    left: var(--arrow-inset);
  }

  /* Place next navigation inside the right image edge. */
  .image-carousel :global(.carousel-arrow)[data-direction="1"] {
    right: var(--arrow-inset);
  }

  /* Hide mouse arrows without removing their keyboard destinations. */
  @media (hover: hover) and (pointer: fine) {
    /* Fade hidden arrows while preventing invisible pointer activation. */
    .image-carousel :global(.carousel-arrow) {
      opacity: 0;
      pointer-events: none;
      transition:
        opacity 280ms cubic-bezier(0.22, 1, 0.36, 1),
        color 160ms ease,
        filter 160ms ease;
    }

    /* Reveal controls for pointer presence and native keyboard focus. */
    .image-carousel:hover :global(.carousel-arrow),
    .image-carousel:focus-within :global(.carousel-arrow) {
      opacity: 1;
      pointer-events: auto;
    }
  }

  /* Remove hover reveal motion when the visitor requests reduced motion. */
  @media (prefers-reduced-motion: reduce) {
    /* Switch arrow visibility immediately while preserving navigation. */
    .image-carousel :global(.carousel-arrow) {
      transition: none;
    }
  }

  /* Static galleries separate images when no navigation is available. */
  .image-carousel[data-layout="panel"]:not([data-ready]) .carousel-list {
    gap: 1rem;
  }

  /* Disabled animation also disables hover fades without hiding controls. */
  .image-carousel[data-animation="false"] :global(.carousel-arrow) {
    transition: none;
  }
</style>
