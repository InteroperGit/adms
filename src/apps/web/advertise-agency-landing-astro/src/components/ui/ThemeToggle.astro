---
// Render accessible native radios for light, dark and system preferences.
// ThemeInit owns persistence and synchronizes selection after DOM readiness.
// System is the markup default; icon-only controls retain hidden names.

// Local decorative symbols accompany the accessible Russian radio names.
const themes = [
  {
    value: 'light',
    label: 'Светлая',
    path:
      'M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6 7 7' +
      'm10 10 1.4 1.4M5.6 18.4 7 17m10-10 1.4-1.4',
  },
  {
    value: 'dark',
    label: 'Тёмная',
    path: 'M20 13a8 8 0 1 1-9-9 6 6 0 0 0 9 9Z',
  },
  {
    value: 'system',
    label: 'Системная',
    path: 'M4 4h16v12H4ZM8 20h8m-4-4v4',
  },
];
---

{/* System is the markup default; icon-only controls retain hidden names. */}
<fieldset>
  <legend class="sr-only">Тема оформления</legend>
  <span class="theme-label" aria-hidden="true">
    Тема
  </span>
  <div class="theme-options">
    {themes.map((theme) => (
      <label class="theme-option" title={theme.label}>
        <input
          type="radio"
          name="site-theme"
          value={theme.value}
          checked={theme.value === 'system'}
          data-theme-radio
        />
        <span class="theme-icon">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d={theme.path} />
            {theme.value === 'light' && <circle cx="12" cy="12" r="4" />}
          </svg>
          <span class="sr-only">{theme.label}</span>
        </span>
      </label>
    ))}
  </div>
</fieldset>
<style>
  /* Align the preference label and radio group without a frame. */
  fieldset {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0;
    margin: 0;
    border: 0;
    min-width: 0;
  }

  /* Keep the preference label legible beside compact icons. */
  .theme-label {
    font-size: 0.875rem;
    font-weight: 600;
  }

  /* Join the three native preference targets into one group. */
  .theme-options {
    display: flex;
  }

  /* Reserve a generous target around each native radio. */
  .theme-option {
    position: relative;
    display: grid;
    align-items: center;
    flex: none;
    min-height: 44px;
    cursor: pointer;
  }

  /* Let the transparent native radio cover its visible icon target. */
  input {
    position: absolute;
    inset: 0;
    opacity: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }

  /* Draw a compact themed surface inside each full-height target. */
  .theme-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 32px;
    border: 1px solid var(--site-control-border);
    color: var(--color-base-content);
    background: var(--color-base-100);
  }

  /* Avoid doubled boundaries between adjacent preference surfaces. */
  .theme-option + .theme-option .theme-icon {
    border-left-width: 0;
  }

  /* Round only the outside edge of the first preference surface. */
  .theme-option:first-child .theme-icon {
    border-radius: var(--radius-field) 0 0 var(--radius-field);
  }

  /* Round only the outside edge of the last preference surface. */
  .theme-option:last-child .theme-icon {
    border-radius: 0 var(--radius-field) var(--radius-field) 0;
  }

  /* Keep local theme symbols consistent within compact surfaces. */
  svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  /* Distinguish the selected preference without disabling its semantics. */
  input:checked + .theme-icon {
    border-color: var(--color-primary);
    box-shadow: inset 0 0 0 1px var(--color-primary);
    color: var(--color-primary);
    background: var(--color-base-200);
  }

  /* Use primary contrast for unselected preference hover feedback. */
  input:not(:checked):hover + .theme-icon {
    background: var(--color-primary);
    color: var(--color-primary-content);
    border-color: var(--color-primary);
  }

  /* Preserve the requested black hover treatment in explicit light mode. */
  :global([data-theme='light']) input:not(:checked):hover + .theme-icon {
    background: #000;
    color: #fff;
    border-color: #000;
  }

  /* Avoid implying a different selection when hovering the current choice. */
  input:checked,
  .theme-option:has(input:checked) {
    cursor: default;
  }

  /* Keep keyboard focus visible above adjacent controls and surfaces. */
  input:focus-visible + .theme-icon {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  /* Raise the focused target so neighboring surfaces do not cover its ring. */
  .theme-option:focus-within {
    z-index: 1;
  }
</style>
