---
// Keep direct contact and page navigation available during long visits.
// Email and phone destinations come from the validated site configuration.

import { site } from "@/content/site";
import { actionRail } from "@/content/actionRail";
import Link from "@/components/ui/Link.astro";
import { MessageCircle } from "@lucide/astro";

const reminderInterval = actionRail.callReminderIntervalSeconds + "s";
---

{/* Keep persistent actions in a named navigation landmark. */}
<nav
  class="action-rail-host"
  aria-label="Быстрые действия"
  style={`--action-rail-reminder-interval: ${reminderInterval}`}
  data-action-rail-host
>
  {/* Group contact controls above the separated return-to-top action. */}
  <div
    id="quick-actions"
    class="action-rail"
    data-action-rail
  >
    <div class="action-rail-group">
      {/* Collapse actions without moving keyboard focus to hidden controls. */}
      <button
        class="action-rail-button action-rail-button-collapse"
        type="button"
        aria-label="Свернуть панель действий"
        data-tooltip="Свернуть меню"
        aria-controls="quick-actions"
        aria-expanded="true"
        data-action-rail-collapse
      >
        <i
          class="fas fa-chevron-right"
          aria-hidden="true"
        ></i>
      </button>
      {/* Let visitors start a callback by calling the configured phone. */}
      <Link
        class="action-rail-button action-rail-button-call"
        underline={false}
        href={`tel:${site.phone.replace(/\s/g, "")}`}
        aria-label="Позвонить нам"
        data-tooltip="Позвонить нам"
      >
        {/* Expand paired rings around the phone on each reminder cycle. */}
        <span
          class="action-rail-call-wave action-rail-call-wave-first"
          aria-hidden="true"
        ></span>
        <span
          class="action-rail-call-wave action-rail-call-wave-second"
          aria-hidden="true"
        ></span>
        <i
          class="fas fa-phone action-rail-call-icon"
          aria-hidden="true"
        ></i>
      </Link>
    </div>
    {/* Separate page navigation from direct contact actions. */}
    <div class="action-rail-bottom">
      <button
        class="action-rail-button action-rail-button-top"
        type="button"
        aria-label="Вернуться наверх"
        data-tooltip="Вернуться наверх"
        data-action-rail-top
      >
        <i
          class="fas fa-arrow-up"
          aria-hidden="true"
        ></i>
      </button>
    </div>
  </div>
  {/* Keep a separate, reachable control when the main rail is collapsed. */}
  <button
    class="action-rail-button action-rail-restore"
    type="button"
    aria-label="Развернуть панель действий"
    data-tooltip="Развернуть меню"
    aria-controls="quick-actions"
    aria-expanded="false"
    data-action-rail-restore
  >
    <i
      class="fas fa-chevron-left"
      aria-hidden="true"
    ></i>
  </button>
</nav>
{/* Keep chat reachable independently from rail visibility and collapse. */}
<button
  class="action-rail-button action-rail-button-chat action-rail-chat-fixed"
  type="button"
  aria-label="Чат"
  data-tooltip="Чат"
  data-action-rail-chat
>
  <MessageCircle
    class="action-rail-chat-icon"
    size={32}
    stroke-width="2.5"
    aria-hidden="true"
  />
  <span
    class="action-rail-chat-typing"
    aria-hidden="true"
  >
    <span></span>
    <span></span>
    <span></span>
  </span>
</button>

<script>
  const host = document.querySelector<HTMLElement>("[data-action-rail-host]");
  const header = document.querySelector<HTMLElement>("[data-auto-hide-header]");
  const actionGroup = document.querySelector<HTMLElement>(
    "[data-action-rail] .action-rail-group",
  );
  const collapse = document.querySelector<HTMLButtonElement>(
    "[data-action-rail-collapse]",
  );
  const restore = document.querySelector<HTMLButtonElement>(
    "[data-action-rail-restore]",
  );
  const scrollTop = document.querySelector<HTMLButtonElement>(
    "[data-action-rail-top]",
  );

  if (host && actionGroup && collapse && restore && scrollTop) {
    const updatePosition = () => {
      const headerHidden = header?.dataset.hidden === "true";
      host.style.setProperty(
        "--action-rail-header-offset",
        headerHidden ? "0px" : "var(--site-header-clearance, 5rem)",
      );
    };

    const setCollapsed = (collapsed: boolean) => {
      host.dataset.collapsed = String(collapsed);
      actionGroup.inert = collapsed;
      collapse.setAttribute("aria-expanded", String(!collapsed));
      restore.setAttribute("aria-expanded", String(collapsed));
    };

    collapse.addEventListener("click", () => {
      setCollapsed(true);
      restore.focus();
    });
    restore.addEventListener("click", () => {
      setCollapsed(false);
      collapse.focus();
    });
    scrollTop.addEventListener("click", () => {
      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      window.scrollTo({
        top: 0,
        behavior: reducedMotion ? "instant" : "smooth",
      });
    });

    header?.addEventListener("transitionend", updatePosition);
    if (header) {
      new MutationObserver(updatePosition).observe(header, {
        attributes: true,
        attributeFilter: ["data-hidden"],
      });
    }
    updatePosition();
  }
</script>

<style>
  /* Stretch the rail between safe screen insets for separated action groups. */
  .action-rail-host {
    position: fixed;
    z-index: 40;
    top: calc(
      var(--action-rail-header-offset, var(--site-header-clearance, 5rem)) +
        max(0.75rem, env(safe-area-inset-top))
    );
    bottom: calc(max(0.75rem, env(safe-area-inset-bottom)) + 4.25rem);
    right: max(0.75rem, env(safe-area-inset-right));
    width: 3.25rem;
    pointer-events: none;
    transition: top 180ms ease;
  }

  /* Hide contact actions while leaving return-to-top in its fixed position. */
  .action-rail-host[data-collapsed="true"] .action-rail-group {
    visibility: hidden;
  }

  /* Keep the rail compact and themed without covering a large content area. */
  .action-rail {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    width: 3.25rem;
    pointer-events: auto;
  }

  /* Keep chat fixed at the viewport edge outside rail visibility rules. */
  .action-rail-chat-fixed {
    position: fixed;
    z-index: 40;
    right: max(0.75rem, env(safe-area-inset-right));
    bottom: max(0.75rem, env(safe-area-inset-bottom));
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 50%;
    pointer-events: auto;
  }

  /* Stack contact actions with consistent button dimensions. */
  .action-rail-group {
    display: grid;
    gap: 0.5rem;
    transition: visibility 180ms ease;
  }

  /* Anchor return-to-top separately at the lower edge of the viewport. */
  .action-rail-bottom {
    display: grid;
  }

  /* Make every icon control a stable, generously sized target. */
  :global(.action-rail-button) {
    --action-color: var(--color-base-content);
    --action-content: var(--color-base-100);
    position: relative;
    display: grid;
    place-items: center;
    justify-self: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--action-color);
    border-radius: var(--radius-field);
    background: var(--color-base-100);
    color: var(--color-base-content);
    cursor: pointer;
    text-decoration: none;
    box-shadow: var(--shadow-panel);
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  /* Use a lighter green accent for the outlined chat control. */
  :global(.action-rail-button-chat) {
    --action-color: #0f766e;
    --action-content: #fff;
    --chat-typing-interval: 3.6s;
  }

  /* Keep the fixed chat button visually distinct from the compact rail. */
  :global(.action-rail-button.action-rail-chat-fixed) {
    --action-color: #0f766e;
    --action-content: #fff;
  }

  /* Keep the collapse action black against the page. */
  :global(.action-rail-button-collapse) {
    --action-color: #000;
    --action-content: #fff;
  }

  /* Mark the phone action with a contrasting green fill. */
  :global(.action-rail-button-call) {
    --action-color: #166534;
    --action-content: #fff;
    --call-reminder-interval: var(--action-rail-reminder-interval);
  }

  /* Give return-to-top a separate dark orange fill. */
  :global(.action-rail-button-top) {
    --action-color: #9a3412;
    --action-content: #fff;
  }

  /* Increase green contrast against the dark page surface. */
  :global([data-theme="dark"] .action-rail-button-chat) {
    --action-color: #0d9488;
    --action-content: #fff;
  }

  :global([data-theme="dark"] .action-rail-button-call) {
    --action-color: #4ade80;
    --action-content: #18212b;
  }

  :global([data-theme="dark"] .action-rail-button-top) {
    --action-color: #fb923c;
    --action-content: #18212b;
  }

  /* Keep phone rings visible beyond the button surface during a pulse. */
  .action-rail-call-wave {
    position: absolute;
    z-index: 0;
    inset: 0;
    border: 2px solid var(--action-color);
    border-radius: 50%;
    animation: action-rail-call-wave var(--call-reminder-interval) ease-out
      infinite;
    opacity: 0;
    pointer-events: none;
  }

  /* Offset the second ring to make each call reminder look like a wave. */
  .action-rail-call-wave-second {
    animation-delay: 150ms;
  }

  /* Overlay three typing dots inside the chat bubble. */
  .action-rail-chat-icon {
    display: block;
    width: 2rem;
    height: 2rem;
  }

  /* Place the typing cue over the outlined Lucide chat mark. */
  .action-rail-chat-typing {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    gap: 1px;
    transform: translate(-50%, -50%);
  }

  /* Keep the persistent chat colors inverted in its default state. */
  :global(.action-rail-button.action-rail-chat-fixed) {
    background: var(--action-color);
    color: var(--action-content);
  }

  /* Highlight the persistent chat action with a color spray only. */
  :global(.action-rail-chat-fixed:hover) {
    box-shadow:
      0 0 0 0.375rem color-mix(in srgb, var(--action-color) 24%, transparent),
      var(--shadow-panel);
  }

  .action-rail-chat-typing span {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #fff;
    animation: action-rail-chat-type-first var(--chat-typing-interval)
      ease-in-out infinite;
    opacity: 0;
  }

  /* Reveal each dot in sequence during the configured reminder cycle. */
  .action-rail-chat-typing span:nth-child(2) {
    animation-name: action-rail-chat-type-second;
    animation-delay: 120ms;
  }

  .action-rail-chat-typing span:nth-child(3) {
    animation-name: action-rail-chat-type-third;
    animation-delay: 240ms;
  }

  /* Keep the phone icon above its expanding reminder rings. */
  .action-rail-call-icon {
    z-index: 1;
    animation: action-rail-call-shake var(--call-reminder-interval) ease-in-out
      infinite;
  }

  /* Pause reminder motion while the caller control is actively targeted. */
  :global(.action-rail-button-call:hover) .action-rail-call-wave {
    animation: none;
    opacity: 0;
  }

  /* Stop the icon shake while the phone action is hovered. */
  :global(.action-rail-button-call:hover) .action-rail-call-icon {
    animation: none;
  }

  /* Match each action icon to its assigned hover fill before interaction. */
  :global(.action-rail-button-chat),
  :global(.action-rail-button-collapse),
  :global(.action-rail-button-call),
  :global(.action-rail-button-top) {
    color: var(--action-color);
  }

  /* Keep collapse and restore icons white against dark-theme surfaces. */
  :global([data-theme="dark"] .action-rail-button-collapse),
  :global([data-theme="dark"] .action-rail-restore) {
    color: #fff;
    border-color: #fff;
  }

  /* Apply the assigned action color only while the pointer hovers. */
  :global(.action-rail-button:hover) {
    border-color: var(--action-color);
    background: var(--action-color);
    color: var(--action-content);
  }

  /* Preserve the white edge of collapse controls during dark-theme hover. */
  :global([data-theme="dark"] .action-rail-button-collapse:hover),
  :global([data-theme="dark"] .action-rail-restore:hover) {
    border-color: #fff;
  }

  /* Keep each button's label hidden until pointer or keyboard interaction. */
  :global(.action-rail-button[data-tooltip]::after) {
    position: absolute;
    top: 50%;
    right: calc(100% + 0.5rem);
    z-index: 2;
    width: max-content;
    max-width: calc(100vw - 5rem);
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--color-base-300);
    border-radius: var(--radius-field);
    background: var(--color-base-100);
    color: var(--color-base-content);
    content: attr(data-tooltip);
    font-size: 0.75rem;
    line-height: 1.3;
    text-align: right;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-50%);
    visibility: hidden;
  }

  /* Show the action name beside its hovered or keyboard-focused control. */
  :global(.action-rail-button[data-tooltip]:hover::after),
  :global(.action-rail-button[data-tooltip]:focus-visible::after) {
    opacity: 1;
    visibility: visible;
  }

  /* Keep hover and focus labels off compact mobile and tablet screens. */
  @media (max-width: 63.999rem) {
    /* Avoid sticky touch hover states and extra labels on narrow screens. */
    :global(.action-rail-button[data-tooltip]::after) {
      display: none;
    }
  }

  /* Match the caption to its assigned button color during hover. */
  :global(.action-rail-button[data-tooltip]:hover::after) {
    border-color: var(--action-color);
    background: var(--action-color);
    color: var(--action-content);
  }

  /* Keep a clear focus ring visible beyond each compact control. */
  :global(.action-rail-button:focus-visible) {
    z-index: 1;
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  /* Place the reopen target beside the rail only while it is collapsed. */
  .action-rail-restore {
    position: absolute;
    top: 0;
    right: 0.375rem;
    --action-color: #000;
    --action-content: #fff;
    border: 1px solid var(--action-color);
    background: var(--color-base-100);
    box-shadow: var(--shadow-panel);
    opacity: 0;
    pointer-events: none;
  }

  /* Keep the reopen border visible on dark surfaces after base styling. */
  :global([data-theme="dark"] .action-rail-restore) {
    color: #fff;
    border-color: #fff;
  }

  /* Keep the restore target interactive while the main rail moves away. */
  .action-rail-host[data-collapsed="true"] .action-rail-restore {
    pointer-events: auto;
  }

  /* Keep the reopen control reachable after the main rail leaves the screen. */
  .action-rail-host[data-collapsed="true"] .action-rail-restore {
    opacity: 1;
    pointer-events: auto;
  }

  /* Hide the phone action when desktop navigation takes over. */
  @media (min-width: 64rem) {
    /* Remove the hidden link from the visual and keyboard focus order. */
    :global(.action-rail-button-call) {
      display: none;
    }

    /* Avoid a collapse-only upper group when desktop has no contact action. */
    :global(.action-rail-button-collapse) {
      display: none;
    }
  }

  /* Keep all controls inside narrow viewports with smaller edge spacing. */
  @media (max-width: 30rem) {
    /* Keep the tall rail inside compact and notched screen edges. */
    .action-rail-host {
      right: max(0.5rem, env(safe-area-inset-right));
    }

    /* Keep chat aligned with the rail on compact and notched screens. */
    .action-rail-chat-fixed {
      right: max(0.5rem, env(safe-area-inset-right));
    }
  }

  /* Remove rail motion when visitors request reduced animation. */
  @media (prefers-reduced-motion: reduce) {
    /* Make collapse and restore immediate under reduced-motion settings. */
    .action-rail-restore,
    :global(.action-rail-button[data-tooltip]::after),
    .action-rail-chat-typing span,
    .action-rail-call-wave,
    .action-rail-call-icon,
    :global(.action-rail-button) {
      transition: none;
      animation: none;
    }

    /* Keep rail movement immediate when reduced motion is requested. */
    .action-rail-host {
      transition: none;
    }

    /* Leave a still typing indicator when motion is reduced. */
    .action-rail-chat-typing span {
      opacity: 1;
    }
  }

  /* Ring outward and fade during a short portion of each configured cycle. */
  @keyframes action-rail-call-wave {
    0%,
    0.5%,
    100% {
      opacity: 0;
      transform: scale(0.85);
    }

    1% {
      opacity: 0.7;
    }

    3% {
      opacity: 0;
      transform: scale(1.55);
    }
  }

  /* Give the phone a brief shake, then leave it still until the next cycle. */
  @keyframes action-rail-call-shake {
    0%,
    1.5%,
    100% {
      transform: rotate(0);
    }

    0.25%,
    0.75% {
      transform: rotate(-14deg);
    }

    0.5%,
    1% {
      transform: rotate(14deg);
    }
  }

  @keyframes action-rail-chat-type-first {
    0%,
    12%,
    36%,
    100% {
      opacity: 0;
      transform: translateY(0);
    }

    18%,
    30% {
      opacity: 1;
      transform: translateY(-2px);
    }
  }

  @keyframes action-rail-chat-type-second {
    0%,
    12%,
    36%,
    100% {
      opacity: 0;
      transform: translateY(0);
    }

    18%,
    30% {
      opacity: 1;
      transform: translateY(-2px);
    }
  }

  @keyframes action-rail-chat-type-third {
    0%,
    12%,
    36%,
    100% {
      opacity: 0;
      transform: translateY(0);
    }

    18%,
    30% {
      opacity: 1;
      transform: translateY(-2px);
    }
  }
</style>
