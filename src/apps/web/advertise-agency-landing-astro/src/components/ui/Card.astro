---
// Render a shared card surface around caller-provided markup.
import type { HTMLAttributes } from "astro/types";

export type Props = HTMLAttributes<"div"> & {
  as?: "div" | "article";
};

const { as: Tag = "div", class: className, ...attributes } = Astro.props;
---

{/* The caller owns the card's content and semantic attributes. */}
<Tag
  class:list={["card-surface", className]}
  {...attributes}
>
  <slot />
</Tag>

<style>
  /* Define the shared surface using the active theme. */
  .card-surface {
    background: color-mix(
      in srgb,
      var(--color-base-100) 90%,
      var(--color-primary)
    );
    border: 1px solid var(--color-base-300);
    border-radius: var(--radius-field);
    box-shadow: var(--shadow-panel);
  }
</style>
