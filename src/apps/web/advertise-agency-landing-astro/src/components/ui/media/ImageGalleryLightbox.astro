---
// Render the modal viewer and thumbnail rail for a nonempty parent gallery.
import type { GalleryImage } from "./types";
import CarouselControl from "@/components/ui/carousel/CarouselControl.astro";

interface Props {
  images: GalleryImage[];
  layout?: "tiles" | "single";
}

const { images, layout = "tiles" } = Astro.props;
const firstImage = images[0]?.image;
---

<dialog
  class="gallery-lightbox"
  data-gallery-dialog
  aria-label="Галерея изображений"
>
  {/* The close control remains independent of the selected image size. */}
  <CarouselControl
    className="gallery-close"
    variant="close"
    label="Закрыть галерею"
    dataGallery="close"
  />

  {/* Overlay navigation and captions within the uncropped image frame. */}
  <figure class="gallery-view">
    {layout === "tiles" && (
      <CarouselControl
        className="gallery-navigation gallery-previous"
        direction="previous"
        label="Предыдущее изображение"
        dataGallery="previous"
      />
    )}
    <img
      class="gallery-image"
      data-gallery-image
      alt={firstImage?.alt ?? ""}
      width={firstImage?.width}
      height={firstImage?.height}
      loading="lazy"
      decoding="async"
    />
    <figcaption
      class="gallery-caption"
      data-gallery-caption
    ></figcaption>
    {layout === "tiles" && (
      <CarouselControl
        className="gallery-navigation gallery-next"
        direction="next"
        label="Следующее изображение"
        dataGallery="next"
      />
    )}
  </figure>

  {/* Keep the live region available even when a gallery has one image. */}
  <span
    class="gallery-announcement sr-only"
    data-gallery-announcement
    aria-live="polite"
  ></span>

  {/* Provide a horizontally scrollable rail for multi-image galleries. */}
  {layout === "tiles" && (
    <div class="gallery-position">
      <div class="gallery-lightbox-thumbnails">
        {images.map(({ image, src }, index) => (
          <button
            class="gallery-lightbox-thumbnail"
            type="button"
            aria-label={`Показать изображение ${index + 1}`}
            aria-current={index === 0 ? "true" : undefined}
            data-gallery-lightbox-thumb={index}
          >
            <img
              src={src}
              alt=""
              width={image.width}
              height={image.height}
              loading="lazy"
              decoding="async"
            />
          </button>
        ))}
      </div>
    </div>
  )}
</dialog>

<style>
  /* Cover the viewport while the selected image is being inspected. */
  .gallery-lightbox {
    --gallery-controls-height: 11.75rem;
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr auto;
    row-gap: 1rem;
    align-items: center;
    width: 100%;
    height: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    overflow: hidden;
    padding: 3.5rem 0.75rem 2rem;
    border: 0;
    color: white;
    background: transparent;
  }

  /* Hide the native dialog until the user opens the gallery. */
  .gallery-lightbox:not([open]) {
    display: none;
  }

  /* Dim the document beneath the native modal dialog. */
  .gallery-lightbox::backdrop {
    background: rgb(0 0 0 / 55%);
  }

  /* Reserve the same space for controls in both the image and its frame. */
  .gallery-view,
  .gallery-image {
    max-height: calc(100vh - var(--gallery-controls-height));
    max-height: max(0px, calc(100dvh - var(--gallery-controls-height)));
  }

  /* Keep the selected image within the visible viewport. */
  .gallery-view {
    grid-column: 1;
    grid-row: 1;
    justify-self: center;
    width: 100%;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    position: relative;
    margin: 0;
    text-align: center;
  }

  /* Show the image without cropping its source content. */
  .gallery-image {
    display: block;
    width: 100%;
    max-width: calc(100vw - 1.5rem);
    height: auto;
    margin: 0 auto;
    object-fit: contain;
  }

  /* Slide a newly selected image in from the right. */
  .gallery-image-slide-left {
    animation: gallery-slide-left 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Slide back in from the left when moving to the previous image. */
  .gallery-image-slide-right {
    animation: gallery-slide-right 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes gallery-slide-left {
    from {
      opacity: 0.35;
      transform: translateX(1.5rem);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes gallery-slide-right {
    from {
      opacity: 0.35;
      transform: translateX(-1.5rem);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Overlay the selected image caption at its lower edge. */
  .gallery-caption {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    margin: 0;
    padding: 2.5rem 1rem 0.75rem;
    color: white;
    text-align: left;
    background: linear-gradient(transparent, rgb(0 0 0 / 78%));
    pointer-events: none;
  }

  /* Keep close and image navigation controls easy to locate. */
  :global(.gallery-close),
  :global(.gallery-navigation) {
    width: 2.75rem;
    height: 2.75rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    border: 1px solid rgb(255 255 255 / 45%);
    border-radius: 50%;
    color: white;
    background: rgb(20 20 24 / 72%);
    cursor: pointer;
    aspect-ratio: 1;
    box-shadow: 0 0.35rem 1rem rgb(0 0 0 / 25%);
  }

  /* Give pointer and keyboard users a clear, polished control response. */
  :global(.gallery-close):focus-visible,
  :global(.gallery-navigation):focus-visible {
    background: white;
    color: #111827;
  }

  /* Keep the thumbnail focus ring visible against the modal backdrop. */
  .gallery-lightbox-thumbnail:focus-visible {
    outline: 2px solid white;
    outline-offset: 3px;
  }

  /* Place the close action in the upper-right corner. */
  :global(.gallery-close) {
    position: absolute;
    top: 1rem;
    right: 1rem;
  }

  /* Hide side navigation until hover or keyboard focus reveals it. */
  :global(.gallery-navigation) {
    position: absolute;
    top: 50%;
    z-index: 2;
    transform: translateY(-50%);
    opacity: 0;
    transition: opacity 160ms ease;
  }

  /* Align the previous control beside the selected image. */
  :global(.gallery-previous) {
    left: 1rem;
  }

  /* Keep the next control opposite the previous control. */
  :global(.gallery-next) {
    right: 1rem;
  }

  /* Keep navigation visible while the pointer or keyboard engages it. */
  .gallery-lightbox:hover :global(.gallery-navigation),
  .gallery-lightbox:focus-within :global(.gallery-navigation) {
    opacity: 1;
  }

  /* Keep the live image count and position controls centered. */
  .gallery-position {
    grid-column: 1;
    grid-row: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: white;
  }

  /* Keep the current image announcement readable. */
  .gallery-announcement {
    text-align: center;
  }

  /* Keep thumbnails centered until they need horizontal touch scrolling. */
  .gallery-lightbox-thumbnails {
    display: flex;
    justify-content: safe center;
    gap: 0.5rem;
    width: min(90vw, 42rem);
    max-width: min(90vw, 42rem);
    overflow-x: auto;
    padding: 0.25rem 0.25rem 0.75rem;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-color: rgb(255 255 255 / 75%) rgb(255 255 255 / 20%);
    scrollbar-width: auto;
    -webkit-overflow-scrolling: touch;
  }

  /* Give the horizontal thumbnail scrollbar a usable visual target. */
  .gallery-lightbox-thumbnails::-webkit-scrollbar {
    height: 0.9rem;
  }

  /* Keep the scrollable range visible against the modal backdrop. */
  .gallery-lightbox-thumbnails::-webkit-scrollbar-track {
    border-radius: 999px;
    background: rgb(255 255 255 / 20%);
  }

  /* Inset the scrollbar thumb while keeping its drag target generous. */
  .gallery-lightbox-thumbnails::-webkit-scrollbar-thumb {
    border: 2px solid transparent;
    border-radius: 999px;
    background: rgb(255 255 255 / 75%);
    background-clip: padding-box;
  }

  /* Make each modal thumbnail a compact, keyboard-friendly choice. */
  .gallery-lightbox-thumbnail {
    flex: 0 0 4.5rem;
    width: 4.5rem;
    height: 3rem;
    scroll-snap-align: start;
    padding: 0;
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: 0.2rem;
    background: rgb(20 20 24 / 72%);
    cursor: pointer;
    transition:
      border-color 160ms ease,
      opacity 160ms ease;
  }

  /* Keep modal thumbnails proportional without distorting their subjects. */
  .gallery-lightbox-thumbnail img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Highlight the thumbnail that owns the main viewer image. */
  .gallery-lightbox-thumbnail[aria-current="true"] {
    border-color: white;
    opacity: 1;
  }

  /* Keep inactive thumbnails discoverable without competing with the image. */
  .gallery-lightbox-thumbnail:not([aria-current="true"]) {
    opacity: 0.72;
  }

  /* Restore full contrast while a pointer explores a thumbnail. */
  .gallery-lightbox-thumbnail:hover,
  .gallery-lightbox-thumbnail:focus-visible {
    border-color: white;
    opacity: 1;
  }

  /* Keep side controls visible on touch screens without hover. */
  @media (hover: none) {
    :global(.gallery-navigation) {
      opacity: 1;
    }
  }

  /* Remove fades for people who request reduced motion. */
  @media (prefers-reduced-motion: reduce) {
    :global(.gallery-navigation) {
      transition: none;
    }

    .gallery-image-slide-left,
    .gallery-image-slide-right {
      animation: none;
    }
  }

  /* Keep controls beside the image on narrow screens. */
  @media (max-width: 40rem) {
    .gallery-lightbox {
      padding-right: 0.5rem;
      padding-left: 0.5rem;
    }

    :global(.gallery-previous) {
      left: 0.5rem;
    }

    :global(.gallery-next) {
      right: 0.5rem;
    }
  }
</style>
