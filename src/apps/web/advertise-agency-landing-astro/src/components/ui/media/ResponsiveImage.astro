---
// Render optimized responsive media from caller-provided display data.
import { Image } from "astro:assets";
import type { MediaImage, ImageCrop } from "./types";
import { getImageMetadata } from "./resolveImage";

interface Props extends MediaImage {
  crop?: ImageCrop;
  priority?: boolean;
  sizes?: string;
}

const {
  src,
  alt,
  width,
  height,
  caption,
  focalPoint,
  mobileFocalPoint,
  crop = "contain",
  priority = false,
  sizes: requestedSizes,
} = Astro.props;
const original = getImageMetadata(src);
const sourceWidth = original?.width ?? width;
const widths = [
  ...new Set([
    ...[320, 640, 960, 1280].filter((candidate) => candidate < sourceWidth),
    Math.min(sourceWidth, 1440),
  ]),
].sort((left, right) => left - right);
const sizes =
  requestedSizes ??
  (crop === "cover-3:2"
    ? "(min-width: 80rem) 368px, (min-width: 48rem) 45vw, 92vw"
    : "(min-width: 64rem) 896px, 94vw");
const focal = focalPoint ?? { x: 50, y: 50 };
const mobile = mobileFocalPoint ?? focal;
const attributes = {
  alt,
  width,
  height,
  sizes,
  loading: priority ? ("eager" as const) : ("lazy" as const),
  fetchpriority: priority ? ("high" as const) : ("auto" as const),
  decoding: "async" as const,
  class: "responsive-image",
  "data-caption": caption,
};
---

{/* Reserve image geometry and apply the selected neutral crop mode. */}
<div
  class:list={[
    "responsive-image-frame",
    {
      "responsive-image-cover-3-2": crop === "cover-3:2",
      "responsive-image-cover-4-3": crop === "cover-4:3",
    },
  ]}
  data-image-state="loading"
  style={{
    "--media-ratio": `${width} / ${height}`,
    "--media-position": `${focal.x}% ${focal.y}%`,
    "--mobile-media-position": `${mobile.x}% ${mobile.y}%`,
  }}
>
  {original ? (
    <Image
      src={original}
      widths={widths}
      {...attributes}
    />
  ) : (
    <img
      src={src}
      {...attributes}
    />
  )}
  <p
    class="responsive-image-error"
    role="status"
  >
    Изображение недоступно
  </p>
</div>

<style>
  /* Reserve intrinsic space while the image resource loads. */
  .responsive-image-frame {
    position: relative;
    min-width: 0;
    width: 100%;
    aspect-ratio: var(--media-ratio);
    overflow: hidden;
    background: var(--color-base-200);
    border-radius: var(--radius-field);
  }

  /* Keep failed media readable without collapsing its reserved frame. */
  .responsive-image-error {
    position: absolute;
    inset: 50% 1rem auto;
    display: none;
    margin: 0;
    transform: translateY(-50%);
    color: var(--site-muted);
    text-align: center;
    overflow-wrap: anywhere;
  }

  /* Show the fallback only after the image reports a failed request. */
  .responsive-image-frame[data-image-state="error"] .responsive-image-error {
    display: block;
  }

  /* Keep uncropped media within its intrinsic aspect ratio. */
  .responsive-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Use the shared three-to-two ratio for catalogue thumbnails. */
  .responsive-image-cover-3-2 {
    aspect-ratio: 3 / 2;
    border-radius: var(--radius-field) var(--radius-field) 0 0;
  }

  /* Use the shared four-to-three ratio for service illustrations. */
  .responsive-image-cover-4-3 {
    aspect-ratio: 4 / 3;
  }

  /* Cropped images retain their authored subject coordinates. */
  .responsive-image-cover-3-2 .responsive-image,
  .responsive-image-cover-4-3 .responsive-image {
    object-fit: cover;
    object-position: var(--media-position);
  }

  /* Use the mobile crop where the content author supplied one. */
  @media (max-width: 41.999rem) {
    .responsive-image-cover-3-2 .responsive-image,
    .responsive-image-cover-4-3 .responsive-image {
      object-position: var(--mobile-media-position);
    }
  }
</style>

<script>
  // Reflect native load failures with a visible text fallback.
  const frames = document.querySelectorAll<HTMLElement>("[data-image-state]");

  frames.forEach((frame) => {
    const image = frame.querySelector("img");
    if (!image) return;
    const update = () => {
      frame.dataset.imageState = image.naturalWidth > 0 ? "loaded" : "error";
    };
    image.addEventListener("load", update, { once: true });
    image.addEventListener(
      "error",
      () => {
        frame.dataset.imageState = "error";
      },
      { once: true },
    );
    if (image.complete) update();
  });
</script>
