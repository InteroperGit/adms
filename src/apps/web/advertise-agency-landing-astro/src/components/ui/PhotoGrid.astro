---
// Render captioned photos with intrinsic dimensions and lazy loading.

interface Props {
  photos: readonly {
    src: string;
    alt: string;
    width: number;
    height: number;
    caption?: string;
  }[];
  class?: string;
}

const { photos, class: className, ...attributes } = Astro.props;
---

{photos.length > 0 && (
  <div
    class:list={["photo-grid", className]}
    {...attributes}
  >
    {photos.map((photo) => (
      <figure class="photo-grid-item">
        <img
          src={photo.src}
          alt={photo.alt}
          width={photo.width}
          height={photo.height}
          loading="lazy"
          decoding="async"
        />
        {photo.caption !== undefined && (
          <figcaption>{photo.caption}</figcaption>
        )}
      </figure>
    ))}
  </div>
)}

<style>
  /* Fit as many readable photos per row as the available width permits. */
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1rem;
  }

  /* Keep captions tied to their documentary image. */
  .photo-grid-item {
    margin: 0;
  }

  /* Prevent images from exceeding their layout column. */
  .photo-grid-item img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-panel);
  }

  /* Make image context available to every reader. */
  .photo-grid-item figcaption {
    margin-top: 0.5rem;
    color: var(--site-muted);
  }
</style>
