---
import { site } from "@/content/site";
import Logo from "@/components/ui/Logo.astro";
---

<div class="header-brand-wrap">
  <a
    href="/"
    class="header-brand text-2xl font-bold"
  >
    <Logo />
    <span>{site.logoText}</span>
  </a>
</div>

<style>
  .header-brand-wrap {
    flex: 0 1 auto;
    min-width: 0;
  }

  .header-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 100%;
    color: var(--color-primary);
  }

  .header-brand span {
    min-width: 0;
  }

  @media (max-width: 374px) {
    .header-brand {
      font-size: 1.125rem;
      overflow-wrap: anywhere;
    }
  }
</style>
