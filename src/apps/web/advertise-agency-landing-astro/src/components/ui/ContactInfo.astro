---
// src/components/ui/ContactInfo.astro
import { icons } from '@/content/icons';

export interface Props {
  phone?: string;
  email?: string;
  address?: string;
  workHours?: string;
  workHoursWeekend?: string;
  class?: string;
}

const { phone, email, address, workHours, workHoursWeekend, class: className = '' } = Astro.props;
---

<div class={`space-y-3 ${className}`}>
  {address && (
    <div class="flex items-start gap-3">
      <i class={`fas ${icons.address} text-2xl text-primary w-6 text-center`}></i>
      <span>{address}</span>
    </div>
  )}
  {phone && (
    <div class="flex items-center gap-3">
      <i class={`fas ${icons.phone} text-2xl text-primary w-6 text-center`}></i>
      <a href={`tel:${phone.replace(/\s/g, '')}`} class="link link-hover">{phone}</a>
    </div>
  )}
  {email && (
    <div class="flex items-center gap-3">
      <i class={`fas ${icons.email} text-2xl text-primary w-6 text-center`}></i>
      <a href={`mailto:${email}`} class="link link-hover">{email}</a>
    </div>
  )}
  {workHours && (
    <div class="flex items-start gap-3">
      <i class={`far ${icons.clock} text-2xl text-primary w-6 text-center`}></i>
      <div>
        <p>{workHours}</p>
        {workHoursWeekend && <p>{workHoursWeekend}</p>}
      </div>
    </div>
  )}
</div>