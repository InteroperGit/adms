---
// src/components/ui/ContactInfo.astro
import { icons } from '@/content/icons';

export interface Props {
  phone?: string;
  email?: string;
  address?: string;
  workHours?: string;
  workHoursWeekend?: string;
  class?: string;
}

const { phone, email, address, workHours, workHoursWeekend, class: className = '' } = Astro.props;
---

<div class={`space-y-3 ${className}`}>
  {address && (
    <div class="flex items-center gap-3">
      <i class={`fas ${icons.address} text-2xl text-primary w-6 shrink-0 text-center`} aria-hidden="true"></i>
      <span class="min-w-0 [overflow-wrap:anywhere]">{address}</span>
    </div>
  )}
  {phone && (
    <div class="flex items-center gap-3">
      <i class={`fas ${icons.phone} text-2xl text-primary w-6 shrink-0 text-center`} aria-hidden="true"></i>
      <a href={`tel:${phone.replace(/\s/g, '')}`} class="contact-action link link-hover">{phone}</a>
    </div>
  )}
  {email && (
    <div class="flex items-center gap-3">
      <i class={`fas ${icons.email} text-2xl text-primary w-6 shrink-0 text-center`} aria-hidden="true"></i>
      <a href={`mailto:${email}`} class="contact-action link link-hover">{email}</a>
    </div>
  )}
  {workHours && (
    <div class="flex items-center gap-3">
      <i class={`far ${icons.clock} text-2xl text-primary w-6 shrink-0 text-center`} aria-hidden="true"></i>
      <div class="min-w-0 [overflow-wrap:anywhere]">
        <p>{workHours}</p>
        {workHoursWeekend && <p>{workHoursWeekend}</p>}
      </div>
    </div>
  )}
</div>

<style>
  .contact-action {
    display: flex;
    align-items: center;
    min-width: 0;
    min-height: 44px;
    overflow-wrap: anywhere;
  }

  .contact-action:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }
</style>
