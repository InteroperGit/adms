---
import { orderInquiry } from "@/content/order-inquiry";
import { site } from "@/content/site";
import { MessageCircle, PhoneCall } from "@lucide/astro";

const phoneHref = `tel:${site.phone.replace(/\s/g, "")}`;
---

<div class="contact-menu">
  <button
    type="button"
    class="contact-menu-opener"
    data-contact-menu-opener
    aria-label={site.sections.contacts.panelTitle}
    aria-controls="contact-menu"
    aria-expanded="false"
  >
    <MessageCircle
      size={20}
      aria-hidden="true"
    />
  </button>
  <dialog
    id="contact-menu"
    aria-label={site.sections.contacts.panelTitle}
  >
    <button
      type="button"
      class="contact-handle"
      data-contact-menu-close
      aria-label="Свернуть меню"
    ></button>
    <section data-contact-options>
      <h2>{site.sections.contacts.panelTitle}</h2>
      <button
        type="button"
        data-callback-start
      >
        <PhoneCall
          size={20}
          aria-hidden="true"
        />
        Обратный звонок
      </button>
      <a
        href="https://vk.com/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          src="/icons/social/vk.svg"
          alt=""
          width="24"
          height="24"
          loading="lazy"
        />
        ВКонтакте
      </a>
      <a
        href="https://max.ru/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          src="/icons/social/max.svg"
          alt=""
          width="24"
          height="24"
          loading="lazy"
        />
        MAX
      </a>
      <a
        href="https://t.me/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          src="/icons/social/telegram.svg"
          alt=""
          width="24"
          height="24"
          loading="lazy"
        />
        Telegram
      </a>
    </section>
    <section
      data-callback-form
      hidden
    >
      <button
        type="button"
        data-callback-back
      >
        Назад
      </button>
      <h2>Обратный звонок</h2>
      <p>{orderInquiry.feedback.unavailable}</p>
      <form>
        <fieldset disabled>
          <label for="callback-name">Имя</label>
          <input
            id="callback-name"
            name="name"
            autocomplete="name"
            required
          />
          <label for="callback-phone">Телефон</label>
          <input
            id="callback-phone"
            name="phone"
            type="tel"
            autocomplete="tel"
            required
          />
          <label class="callback-consent">
            <input
              type="checkbox"
              name="consent"
              required
            />
            {orderInquiry.consent.label}
          </label>
        </fieldset>
        <button
          type="submit"
          disabled
        >
          Отправить
        </button>
      </form>
      <a href={phoneHref}>{site.phone}</a>
    </section>
  </dialog>
</div>

<style>
  /* Keep the contact opener square and aligned with the shared controls. */
  .contact-menu-opener {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0;
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-field);
    color: var(--color-primary);
    background: var(--color-base-100);
    cursor: pointer;
  }

  /* Keep the conversation mark compact within the control surface. */
  .contact-menu-opener svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .contact-menu-opener:hover {
    border-color: var(--color-primary);
    color: var(--color-primary-content);
    background: var(--color-primary);
  }

  /* Keep keyboard focus visible across both panel layouts. */
  .contact-menu-opener:focus-visible,
  dialog a:focus-visible,
  dialog button:focus-visible,
  dialog input:focus-visible {
    outline: var(--site-focus-ring);
    outline-offset: 3px;
  }

  /* Position desktop choices as a compact dropdown beside its opener. */
  dialog {
    position: fixed;
    z-index: 50;
    inset: calc(var(--site-header-clearance, 5rem) - 0.5rem) 1rem auto auto;
    width: min(24rem, calc(100vw - 2rem));
    max-width: none;
    max-height: min(80dvh, 42rem);
    margin: 0;
    padding: 1.25rem;
    overflow: auto;
    border: 1px solid var(--color-base-300);
    border-radius: 0.375rem;
    color: var(--color-base-content);
    background: var(--color-base-100);
    box-shadow: var(--shadow-panel);
  }

  /* Keep the centered drag cue available only in the mobile sheet. */
  .contact-handle {
    display: none;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .contact-handle:focus-visible {
    outline: var(--site-focus-ring);
  }

  .contact-handle::before {
    width: 2.5rem;
    height: 0.25rem;
    border-radius: 1rem;
    background: var(--color-base-300);
    content: "";
  }

  /* Stack four contact choices and separate each with a theme border. */
  [data-contact-options] {
    display: grid;
  }

  /* Give each panel title a compact heading scale. */
  [data-contact-options] h2,
  [data-callback-form] h2 {
    margin: 0 0 0.75rem;
    font-size: 1.125rem;
  }

  /* Keep actions easy to scan and large enough for touch input. */
  [data-contact-options] a,
  [data-contact-options] button,
  [data-callback-form] > button,
  [data-callback-form] form > button {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.25rem;
    padding: 0.5rem;
    border: 0;
    border-top: 1px solid var(--color-base-300);
    color: inherit;
    background: transparent;
    text-align: start;
    text-decoration: none;
    cursor: pointer;
    font-size: 1.125rem;
  }

  [data-contact-options] a:hover,
  [data-contact-options] button:hover,
  [data-callback-form] > button:hover,
  [data-callback-form] form > button:hover {
    color: var(--color-secondary-content);
    background: var(--color-secondary);
  }

  /* Keep local social marks aligned and prevent them from shrinking. */
  [data-contact-options] img {
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
  }

  /* Group callback labels, fields and action in a readable form flow. */
  [data-callback-form] form {
    display: grid;
    gap: 0.75rem;
  }

  /* Keep the disabled fields aligned without a browser fieldset frame. */
  [data-callback-form] fieldset {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    border: 0;
  }

  /* Keep callback inputs large enough and allow their labels to wrap. */
  [data-callback-form] input:not([type="checkbox"]) {
    min-width: 0;
    min-height: 2.75rem;
    padding: 0.5rem;
  }

  /* Align the consent check with its wrapped text. */
  .callback-consent {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding-block: 0.5rem;
  }

  /* Keep the checkbox itself a comfortable pointer target. */
  .callback-consent input {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
  }

  /* Use a full-width bottom sheet only in the mobile layout. */
  @media (max-width: 47.999rem) {
    dialog {
      inset: auto 0 0;
      width: 100%;
      height: auto;
      max-height: 70dvh;
      padding: 0.25rem 1rem 0.25rem;
      border: 0;
      border-radius: 0.5rem 0.5rem 0 0;
      transform: translateY(100%);
      transition: transform 180ms ease;
    }

    dialog[open] {
      display: flex;
      flex-direction: column;
      transform: translateY(0);
    }

    [data-contact-options] > h2 {
      display: none;
    }

    .contact-handle {
      display: grid;
      place-items: start center;
      width: 3rem;
      min-height: 2.75rem;
      flex: none;
      margin: 0 auto;
      padding-top: 0.25rem;
    }
  }

  /* Remove sheet motion when the visitor requests reduced motion. */
  @media (prefers-reduced-motion: reduce) {
    dialog {
      transition: none;
    }
  }

  /* Lock page scrolling while the modal mobile sheet is open. */
  :global(body:has(#contact-menu:modal)) {
    overflow: hidden;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#contact-menu");
  const openers = document.querySelectorAll<HTMLElement>(
    "[data-contact-menu-opener]",
  );
  const options = dialog?.querySelector<HTMLElement>("[data-contact-options]");
  const callback = dialog?.querySelector<HTMLElement>("[data-callback-form]");

  if (dialog && dialog.parentElement !== document.body) {
    document.body.append(dialog);
  }

  if (dialog && options && callback && openers.length) {
    let activeOpener: HTMLElement | null = null;
    const close = () => dialog.close();

    dialog
      .querySelector("[data-contact-menu-close]")
      ?.addEventListener("click", close);

    openers.forEach((opener) => {
      opener.addEventListener("click", (event) => {
        event.preventDefault();
        if (dialog.open && activeOpener === opener) {
          close();
          return;
        }
        activeOpener = opener;
        options.hidden = false;
        callback.hidden = true;
        opener.setAttribute(
          "aria-label",
          dialog.getAttribute("aria-label") ?? "Contact options",
        );
        opener.setAttribute("aria-expanded", "true");
        document
          .querySelector("header")
          ?.setAttribute("data-contact-menu-open", "");
        if (window.matchMedia("(max-width: 47.999rem)").matches) {
          dialog.showModal();
        } else {
          dialog.show();
        }
      });
    });

    dialog
      .querySelector("[data-callback-start]")
      ?.addEventListener("click", () => {
        options.hidden = true;
        callback.hidden = false;
        callback.querySelector<HTMLElement>("[data-callback-back]")?.focus();
      });

    dialog
      .querySelector("[data-callback-back]")
      ?.addEventListener("click", () => {
        callback.hidden = true;
        options.hidden = false;
        dialog.querySelector<HTMLElement>("[data-callback-start]")?.focus();
      });

    dialog.addEventListener("click", (event) => {
      if (event.target !== dialog) {
        return;
      }
      const bounds = dialog.getBoundingClientRect();
      if (
        event.clientX < bounds.left ||
        event.clientX > bounds.right ||
        event.clientY < bounds.top ||
        event.clientY > bounds.bottom
      ) {
        close();
      }
    });

    document.addEventListener("pointerdown", (event) => {
      if (
        dialog.open &&
        !dialog.contains(event.target as Node) &&
        ![...openers].some((opener) => opener.contains(event.target as Node))
      ) {
        close();
      }
    });

    dialog.addEventListener("close", () => {
      document
        .querySelector("header")
        ?.removeAttribute("data-contact-menu-open");
      openers.forEach((opener) =>
        opener.setAttribute("aria-expanded", "false"),
      );
      activeOpener?.focus({ preventScroll: true });
    });
  }
</script>
