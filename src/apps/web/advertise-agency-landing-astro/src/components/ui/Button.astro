---
// Share action styling while preserving native link or button semantics.
// An href selects an anchor; otherwise type defaults to button.
// Variant/size default to primary/md; rest attributes and slot pass through.

// Caller-supplied data and presentation options for this component.
export interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'link';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  [key: string]: any;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  class: className = '',
  ...rest
} = Astro.props;

const baseClasses = 'btn site-button';
const variantClasses = {
  primary: 'btn-primary',
  secondary: 'btn-secondary',
  outline: 'btn-outline',
  ghost: 'btn-ghost',
  link: 'btn-link',
};
const sizeClasses = {
  sm: 'btn-sm',
  md: 'btn-md',
  lg: 'btn-lg',
};

// Explicit utilities keep outline actions on the semantic primary palette.
const outlineClasses =
  variant === 'outline'
    ? 'border-primary text-primary hover:bg-primary hover:text-primary-content'
    : '';

// Compose variant, size and caller classes without overriding attributes.
const combinedClasses = [
  baseClasses,
  variantClasses[variant],
  sizeClasses[size],
  outlineClasses,
  className,
]
  .filter(Boolean)
  .join(' ');
---

{/*
  Variant/size default to primary/md; rest attributes and slot pass through.
*/}
{href ? (
  <a href={href} class={combinedClasses} {...rest}>
    <slot />
  </a>
) : (
  <button type={type} class={combinedClasses} {...rest}>
    <slot />
  </button>
)}
