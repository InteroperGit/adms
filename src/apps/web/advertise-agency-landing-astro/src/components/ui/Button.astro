---
// Share action styling while preserving native link or button semantics.
// An href selects an anchor; otherwise type defaults to button.
// Variant/size default to primary/md; rest attributes and slot pass through.

import type { HTMLAttributes } from "astro/types";

// The href property selects which native element callers may configure.
type StyleProps = {
  variant?: "primary" | "secondary" | "outline" | "ghost" | "link";
  size?: "sm" | "md" | "lg";
  class?: string;
};

// Links use anchor attributes and do not accept button type values.
type AnchorProps = Omit<HTMLAttributes<"a">, "class" | "href" | "type"> &
  StyleProps & {
    href: string;
    type?: never;
  };

// Buttons retain native type values and form-related attributes.
type NativeButtonProps = Omit<HTMLAttributes<"button">, "class" | "type"> &
  StyleProps & {
    href?: never;
    type?: HTMLAttributes<"button">["type"];
  };

export type Props = AnchorProps | NativeButtonProps;

const {
  variant = "primary",
  size = "md",
  href,
  type = "button",
  class: className = "",
  ...rest
} = Astro.props;

const baseClasses = "btn site-button";
const variantClasses = {
  primary: "btn-primary",
  secondary: "btn-secondary",
  outline: "btn-outline",
  ghost: "btn-ghost",
  link: "btn-link",
};
const sizeClasses = {
  sm: "btn-sm",
  md: "btn-md",
  lg: "btn-lg",
};

// Explicit utilities keep outline actions on the semantic primary palette.
const outlineClasses =
  variant === "outline"
    ? "border-primary text-primary hover:bg-primary hover:text-primary-content"
    : "";

// Compose variant, size and caller classes without overriding attributes.
const combinedClasses = [
  baseClasses,
  variantClasses[variant],
  sizeClasses[size],
  outlineClasses,
  className,
]
  .filter(Boolean)
  .join(" ");
---

{/*
  Variant/size default to primary/md; rest attributes and slot pass through.
*/}
{href ? (
  <a
    href={href}
    class={combinedClasses}
    {...rest}
  >
    <slot />
  </a>
) : (
  <button
    type={type}
    class={combinedClasses}
    {...rest}
  >
    <slot />
  </button>
)}
