---
// Render phone, messenger and address actions below the mobile header row.
// The shared header supplies validated contact values and site destinations.

import Button from "@/components/ui/Button.astro";
import { MessageCircle, Phone } from "@lucide/astro";

// Keep these destinations derived from the shared contact data.
interface Props {
  phone: string;
  address: string;
}

const { phone, address } = Astro.props;
const phoneHref = `tel:${phone.replace(/\s/g, "")}`;
const [addressCity = address, ...addressParts] = address.split(",");
const addressDetails = addressParts.join(",").trim();
---

{/* Place the most-used contact actions directly below the mobile header. */}
<div
  class="mobile-header-contacts site-container"
  role="group"
  aria-label="Быстрые контакты"
>
  <Button
    href={phoneHref}
    size="sm"
    class="mobile-header-action mobile-header-phone"
    aria-label="Позвонить"
  >
    <Phone
      size={20}
      aria-hidden="true"
    />
  </Button>
  <Button
    variant="secondary"
    size="sm"
    href="/#contacts"
    class="mobile-header-action contact-open-action"
    data-contact-menu-opener
    aria-controls="contact-menu"
    aria-expanded="false"
    aria-label="Написать в Макс"
  >
    <MessageCircle
      size={20}
      aria-hidden="true"
    />
  </Button>
  <Button
    variant="ghost"
    size="sm"
    href="/#contacts"
    class="mobile-header-address"
    aria-label={address}
    title={address}
  >
    <span class="mobile-header-address-text">
      <span class="mobile-header-address-city">{addressCity.trim()}</span>
      {addressDetails && (
        <span class="mobile-header-address-details">{addressDetails}</span>
      )}
    </span>
  </Button>
</div>

<style>
  /* Keep the call and messenger links in a compact two-column row. */
  .mobile-header-contacts {
    --mobile-contact-control-size: 2.75rem;
    display: grid;
    grid-template-columns: repeat(2, var(--mobile-contact-control-size)) minmax(
        0,
        1fr
      );
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.75rem;
    background: var(--color-primary);
  }

  /* Keep both icon actions square and large enough for touch input. */
  .mobile-header-contacts :global(.mobile-header-action) {
    display: grid;
    place-items: center;
    width: var(--mobile-contact-control-size);
    height: var(--mobile-contact-control-size);
    min-width: var(--mobile-contact-control-size);
    min-height: var(--mobile-contact-control-size);
    padding: 0;
    border: 1px solid var(--site-navigation-button);
    border-radius: var(--radius-field);
    color: var(--site-navigation-button);
    background: #ffffff;
  }

  /* Match the standalone Max action to its blue logo without shadows. */
  .mobile-header-contacts :global(.contact-open-action) {
    background-color: #ffffff;
    border: 1px solid var(--site-navigation-button);
    border-radius: var(--radius-field);
    color: var(--site-navigation-button);
    box-shadow: none;
  }

  .mobile-header-contacts :global(.mobile-header-phone) {
    border-color: var(--site-navigation-button);
    color: var(--site-navigation-button);
    background-color: #ffffff;
    box-shadow: none;
    filter: none;
  }

  /* Keep keyboard focus distinct without adding a button shadow. */
  .mobile-header-contacts :global(.contact-open-action:focus-visible) {
    outline: var(--site-focus-ring);
    outline-offset: 3px;
  }

  /* Invert every mobile header action to the primary theme colors. */
  @media (hover: hover) and (pointer: fine) {
    /* Keep the contact row's hover treatment consistent across actions. */
    .mobile-header-contacts :global(.mobile-header-action:hover),
    .mobile-header-contacts :global(.mobile-header-address:hover),
    .mobile-header-contacts :global(.contact-open-action:hover) {
      background-color: #ffffff;
      border-color: var(--site-navigation-button-hover);
      color: var(--site-navigation-button-hover);
      box-shadow: var(--site-navigation-button-glow);
    }
  }

  /* Keep the chat mark compact inside the square contact opener. */
  .mobile-header-contacts :global(.contact-open-action svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* Keep the address aligned beside the two square contact actions. */
  .mobile-header-address {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-width: 0;
    min-height: 44px;
    height: auto;
    padding-inline: 0.4rem;
    border: 0;
    color: var(--site-navigation-content);
    background: transparent;
    white-space: normal;
  }

  /* Wrap the full address inside its narrow column without clipping. */
  .mobile-header-address-text {
    display: block;
    min-width: 0;
    line-height: 1.2;
    text-align: center;
    white-space: normal;
  }

  /* Keep the city on one line and start the remaining address below. */
  .mobile-header-address-city,
  .mobile-header-address-details {
    display: block;
    overflow-wrap: anywhere;
  }

  /* Hide the compact contact section on tablet and desktop layouts. */
  @media (min-width: 48rem) {
    /* Avoid duplicating contact actions beside the desktop navigation. */
    .mobile-header-contacts {
      display: none;
    }
  }
</style>
