---
// Render one validated slide, including optimized images and optional copy.
// The parent carousel owns item order, controls, and enhancement state.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from '@/components/ui/Button.astro';
import type { CarouselItem, CarouselOptions } from '@/types/image-carousel';

interface Props {
  // This leaf receives validated items/options from ImageCarousel only.
  id: string;
  item: CarouselItem;
  // Zero-based index drives accessible position and first-image loading.
  index: number;
  total: number;
  itemLabel: string;
  options: CarouselOptions;
}

const { id, item, index, total, itemLabel, options } = Astro.props;
const { presentation } = item;
const { focalPoint } = presentation;
const mobile = presentation.mobileFocalPoint ?? focalPoint;
// Omit the overlay entirely when both optional content features are absent.
const description = options.descriptions ? item.description?.trim() : null;
const button = options.buttons && item.href && item.linkLabel;
// Bundled originals generate responsive variants without remote downloads.
// A missing local asset is a build failure, never a broken published URL.
const originals = import.meta.glob<ImageMetadata>(
  '/src/assets/**/*.{avif,jpeg,jpg,png,webp}',
  { eager: true, import: 'default' },
);
const original = originals[item.image];
if (item.image.startsWith('/src/assets/') && !original) {
  throw new Error(`Carousel image missing: ${item.image}`);
}
// Include the original width once and avoid upscaling smaller source images.
const widths = original ? [...new Set([
  ...[320, 640, 960].filter(width => width < original.width),
  original.width,
])] : [];
const loading = index === 0 && options.eagerFirst ? 'eager' : 'lazy';
const sizes = options.layout === 'panel'
  ? '(min-width: 64rem) 40vw, 92vw'
  : '100vw';
---

{/* Each static slide keeps its image and enabled content accessible. */}
<article
  id={id}
  class="carousel-slide"
  aria-label={`${itemLabel} ${index + 1} из ${total}`}
  data-item-id={item.id}
  data-overlay={presentation.overlay}
  style={{
    '--description-size': `${presentation.fontSizeRem}rem`,
    '--description-color': presentation.textColor,
    '--focal-point': `${focalPoint.x}% ${focalPoint.y}%`,
    '--mobile-focal-point': `${mobile.x}% ${mobile.y}%`,
  }}
>
  {original ? (
    <Image
      src={original}
      alt={item.imageAlt}
      widths={widths}
      sizes={sizes}
      width={item.imageWidth}
      height={item.imageHeight}
      loading={loading}
      decoding="async"
      class="carousel-background"
    />
  ) : (
    <img
      src={item.image}
      alt={item.imageAlt}
      width={item.imageWidth}
      height={item.imageHeight}
      loading={loading}
      decoding="async"
      class="carousel-background"
    />
  )}
  {/* Disabled text/buttons omit the entire content stage. */}
  {(description || button) && (
    <div
      class:list={[
        'carousel-stage',
        { 'site-container': options.layout === 'full' },
      ]}
      data-horizontal={presentation.horizontal}
      data-vertical={presentation.vertical}
    >
      <div class="carousel-copy">
        {description && <p>{description}</p>}
        {button && item.href && (
          <Button href={item.href} class="carousel-link">
            {item.linkLabel}
          </Button>
        )}
      </div>
    </div>
  )}
</article>

<style>
  /* Share one grid track so the tallest slide reserves rotation height. */
  :global(.image-carousel[data-ready]) .carousel-slide {
    grid-area: 1 / 1;
  }

  /* Reserve hidden slide geometry without exposing content or links. */
  :global(.image-carousel[data-ready]) .carousel-slide[aria-hidden='true'] {
    visibility: hidden;
    pointer-events: none;
  }

  /* Fade selected content only when animation and motion are enabled. */
  @media (prefers-reduced-motion: no-preference) {
    /* Animate only visible slides and preserve their layout geometry. */
    :global(.image-carousel[data-ready][data-animation='true'])
      .carousel-slide:not([aria-hidden]) {
      animation: carousel-reveal 160ms ease-out;
    }
  }

  /* Reveal slide content without reflow. */
  @keyframes carousel-reveal {
    /* Start the reveal with transparent content. */
    from {
      opacity: 0;
    }

    /* Finish the reveal at the normal opacity. */
    to {
      opacity: 1;
    }
  }

  /* Reserve slide geometry without DaisyUI horizontal scroll utilities. */
  .carousel-slide {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: clamp(23rem, 36vw, 34rem);
    background: #000;
    --description-backing: rgb(0 0 0 / 25%);
    --description-edge: #000;
  }

  /* Use a light fallback and description backing for light presentation. */
  .carousel-slide[data-overlay='light'] {
    background: #fff;
    --description-backing: rgb(255 255 255 / 25%);
    --description-edge: #fff;
  }

  /* Cover the slide with the configured image crop. */
  .carousel-background {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focal-point);
  }

  /* Align content to site gutters with breathing room around copy. */
  .carousel-stage {
    display: grid;
    min-width: 0;
    min-height: inherit;
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  /* Reserve arrow and dot clearance in every copy alignment after setup. */
  :global(.image-carousel[data-ready][data-arrows='true']) .carousel-stage {
    padding-inline: max(
      var(--site-gutter),
      calc(var(--control-inset) + var(--arrow-size) + var(--control-gap))
    );
  }

  /* Reserve bottom clearance only when circles are actually present. */
  :global(.image-carousel[data-ready][data-circles='true']) .carousel-stage {
    padding-bottom: max(
      4.5rem,
      calc(
        var(--indicator-height) + var(--control-inset) + var(--control-gap)
      )
    );
  }

  /* Place the copy at the left edge of the content area. */
  .carousel-stage[data-horizontal='left'] {
    justify-items: start;
  }

  /* Center the copy within the content area. */
  .carousel-stage[data-horizontal='center'] {
    justify-items: center;
  }

  /* Place the copy at the right edge of the content area. */
  .carousel-stage[data-horizontal='right'] {
    justify-items: end;
  }

  /* Position copy near the top when there is spare slide height. */
  .carousel-stage[data-vertical='top'] {
    align-items: start;
  }

  /* Center copy vertically when there is spare slide height. */
  .carousel-stage[data-vertical='center'] {
    align-items: center;
  }

  /* Position copy near the bottom when there is spare slide height. */
  .carousel-stage[data-vertical='bottom'] {
    align-items: end;
  }

  /* Limit reading width and wrap long text without a surrounding panel. */
  .carousel-copy {
    width: min(100%, 36rem);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  /* Center text for the centered presentation. */
  .carousel-stage[data-horizontal='center'] .carousel-copy {
    text-align: center;
  }

  /* Right-align text for the right presentation. */
  .carousel-stage[data-horizontal='right'] .carousel-copy {
    text-align: right;
  }

  /* Preserve translucent backing with an image-independent glyph edge. */
  .carousel-copy p {
    margin: 0;
    padding: 1rem 1.25rem;
    background: var(--description-backing);
    color: var(--description-color);
    font-size: var(--description-size);
    line-height: 1.55;
    -webkit-text-stroke: 1px var(--description-edge);
    paint-order: stroke fill;
    text-shadow:
      -1px -1px 0 var(--description-edge),
      1px -1px 0 var(--description-edge),
      -1px 1px 0 var(--description-edge),
      1px 1px 0 var(--description-edge);
  }

  /* Keep the CTA readable and allow long labels to wrap. */
  .carousel-copy :global(.carousel-link) {
    max-width: 100%;
    min-height: 3rem;
    height: auto;
    padding-block: 0.75rem;
    white-space: normal;
    overflow-wrap: anywhere;
    text-align: center;
    background: #b2380a;
    color: #fff;
    border-color: #b2380a;
  }

  /* Separate the CTA from a rendered description; empty text adds no gap. */
  .carousel-copy p + :global(.carousel-link) {
    margin-top: 1.25rem;
  }

  /* Darken the CTA to indicate pointer hover. */
  .carousel-copy :global(.carousel-link:hover) {
    background: #8f2d08;
    border-color: #8f2d08;
  }

  /* Keep keyboard focus visible over both bright and dark photographs. */
  .carousel-copy :global(.carousel-link:focus-visible) {
    outline: 3px solid #fff;
    outline-offset: 3px;
    box-shadow: 0 0 0 8px #000;
  }

  /* Adapt image cropping and reading width for mobile screens. */
  @media (max-width: 47rem) {
    /* Keep enough image height for narrow screens. */
    .carousel-slide {
      min-height: 25rem;
    }

    /* Apply the mobile focal-point override to the image. */
    .carousel-background {
      object-position: var(--mobile-focal-point);
    }

    /* Use the available content width on mobile. */
    .carousel-copy {
      width: 100%;
    }
  }

  /* Keep wide, short screens from reserving excessive vertical space. */
  @media (max-height: 30rem) and (min-width: 47.01rem) {
    /* Reduce reserved height in short landscape viewports. */
    .carousel-slide {
      min-height: 20rem;
    }
  }

  /* Fit can preserve the full artwork or crop to a caller's focal point. */
  :global(.image-carousel) .carousel-background {
    object-fit: var(--image-fit);
  }

  /* Inline panels use a consistent ratio rather than hero-sized heights. */
  :global(.image-carousel[data-layout='panel']) .carousel-slide {
    min-height: 0;
    aspect-ratio: var(--panel-ratio);
    background: var(--color-base-200);
  }

  /* Overlay content can grow a panel when enlarged text needs more room. */
  :global(.image-carousel[data-layout='panel']) .carousel-stage {
    padding: 1.5rem;
    width: 100%;
  }
</style>
