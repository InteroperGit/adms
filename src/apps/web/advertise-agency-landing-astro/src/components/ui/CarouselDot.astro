---
// Render one selectable control or passive carousel position marker.
interface Props {
  // Keep the marker index consistent with the browser selection handler.
  index: number;
  // Use the same item wording in each accessible button label.
  itemName: string;
  // Manual navigation uses buttons; automatic-only dots remain passive.
  manualNavigation: boolean;
  // Associate each selectable dot with its corresponding slide.
  slideId: string;
}

const { index, itemName, manualNavigation, slideId } = Astro.props;
---

{/* Keep manual markers keyboard-accessible and passive markers inert. */}
{manualNavigation ? (
  <button
    type="button"
    class="carousel-dot"
    data-index={index}
    aria-label={"Показать: " + itemName + " " + (index + 1)}
    aria-controls={slideId}
  >
    <span aria-hidden="true"></span>
  </button>
) : (
  <span
    class="carousel-dot"
    data-index={index}
  >
    <span></span>
  </span>
)}

<style>
  /* Keep every marker keyboard and touch target at least 44px wide. */
  .carousel-dot {
    display: grid;
    place-items: center;
    width: var(--dot-size);
    height: var(--dot-size);
    flex: 0 0 auto;
    border-radius: 50%;
    color: #fff;
    cursor: pointer;
    background: transparent;
    border: 0;
  }

  /* Draw a compact, fully filled marker inside the hit area. */
  .carousel-dot span {
    width: 0.625rem;
    height: 0.625rem;
    background: currentColor;
    border-radius: 50%;
    opacity: 0.68;
    filter: drop-shadow(0 0 2px #000);
    transition:
      opacity 220ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Emphasize the current marker without changing the hit-area geometry. */
  .carousel-dot[aria-current] span {
    opacity: 1;
    transform: scale(1.2);
  }

  /* Keep passive indicators compact while preserving their visual rhythm. */
  span.carousel-dot {
    cursor: default;
    pointer-events: none;
    width: var(--dot-size);
    height: var(--dot-size);
  }

  /* Disable indicator motion when the carousel animation option is off. */
  :global(.image-carousel[data-animation="false"]) .carousel-dot span {
    transition: none;
  }

  /* Honor reduced-motion preferences for indicator state changes. */
  @media (prefers-reduced-motion: reduce) {
    /* Make the selected state immediate without removing the state itself. */
    .carousel-dot span {
      transition: none;
    }
  }
</style>
