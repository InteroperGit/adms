---
// Render the Макс messenger mark for contact actions.
// The logo is decorative because the surrounding link names the destination.
---

{/* Keep the messenger mark decorative beside the accessible action label. */}
<svg
  class="max-logo"
  viewBox="0 0 32 32"
  width="32"
  height="32"
  role="img"
  aria-hidden="true"
>
  <rect width="32" height="32" rx="9" fill="#1688f5" />
  <path
    d="M8 22V10h3l5 6 5-6h3v12h-3v-6l-4 5h-2l-4-5v6H8Z"
    fill="white"
  />
</svg>

<style>
  /* Keep the messenger mark compact while preserving its clear silhouette. */
  .max-logo {
    display: block;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
  }
</style>
