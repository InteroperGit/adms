---
// src/components/cards/ProjectCard.astro
import type { Project } from '@/types';

export interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-card">
  <figure class="project-image">
    <img
      src={project.image}
      alt={project.imageAlt}
      width={project.imageWidth}
      height={project.imageHeight}
      loading="lazy"
      decoding="async"
    />
  </figure>
  <div class="project-copy">
    <h3>{project.title}</h3>
    <p class="project-client">Клиент: {project.client}</p>
    <p class="project-summary">{project.shortDescription}</p>
    <a class="project-link" href={`/projects/${project.id}`}>
      Подробнее<span class="sr-only">: {project.title}</span>
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m9 5 7 7-7 7" /></svg>
    </a>
  </div>
</article>

<style>
  .project-card { min-width: 0; display: flex; flex-direction: column; background: var(--color-base-100); border: 1px solid var(--color-base-300); border-radius: var(--radius-field); }
  .project-image { margin: 0; aspect-ratio: 3 / 2; background: var(--color-base-200); overflow: hidden; border-radius: var(--radius-field) var(--radius-field) 0 0; }
  .project-image img { width: 100%; height: 100%; object-fit: cover; }
  .project-copy { min-width: 0; display: flex; flex: 1; flex-direction: column; gap: .75rem; padding: clamp(1rem, 2vw, 1.5rem); overflow-wrap: anywhere; }
  h3 { font-size: 1.25rem; line-height: 1.35; font-weight: 700; }
  .project-client { font-size: .875rem; color: var(--color-muted); }
  .project-summary { line-height: 1.6; color: var(--color-base-content); }
  .project-link { display: flex; align-items: center; gap: .5rem; width: fit-content; min-height: 44px; margin-top: auto; padding-block: .5rem; color: var(--color-primary); font-weight: 600; text-decoration: underline; text-underline-offset: .25em; }
  .project-link svg { flex-shrink: 0; }
  .project-link:hover { text-decoration-thickness: 2px; }
</style>
