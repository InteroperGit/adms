---
// Adapt project evidence and category data to the shared card presentation.
// Draft images stay hidden according to the shared content publication rules.

import Card from "@/components/cards/Card.astro";
import { getProjectCategory } from "@/content/project-categories";
import { getVisibleBlocks } from "@/validation/policies/block-publication";
import type { Project } from "@/types/project";

// Caller supplies a validated project record from the content layer.
export interface Props {
  project: Project;
}

const { project } = Astro.props;
const photo = getVisibleBlocks(project.content).find(
  (block) => block.type === "image" || block.type === "image-gallery",
);
const image = photo
  ? photo.type === "image"
    ? photo
    : photo.images[0]
  : undefined;
const category = getProjectCategory(project.category);
const metadata = `${project.client}${project.date ? `, ${project.date}` : ""}`;
---

{/* Keep project routing, attribution context and category metadata intact. */}
<Card
  title={project.title}
  titleId={`project-${project.id}`}
  description={project.description}
  href={`/projects/${project.id}/`}
  image={image}
  category={category}
  metadata={metadata}
  actionName={`Подробнее: ${project.title}`}
  projectLink
/>
