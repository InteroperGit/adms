---
// src/components/cards/ProjectCard.astro
import type { Project } from '@/types';
import Button from '@/components/ui/Button.astro';
import { icons } from '@/content/icons';

export interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div class="card bg-base-100 shadow-2xl hover:shadow-[0_20px_50px_rgba(0,0,0,0.2)] transition-all rounded-3xl overflow-hidden">
  <figure>
    <img
      src={project.image}
      alt={project.imageAlt}
      width={project.imageWidth}
      height={project.imageHeight}
      class="w-full h-48 object-cover rounded-t-3xl"
      loading="lazy"
      decoding="async"
    />
  </figure>
  <div class="card-body">
    <div class="flex items-center gap-2 mb-2">
      <span class="badge badge-ghost text-xs">Клиент</span>
      <span class="text-sm text-gray-500">{project.client}</span>
    </div>
    <h3 class="card-title text-xl font-bold">{project.title}</h3>
    <p class="text-sm text-gray-600 leading-relaxed">{project.shortDescription}</p>
    <div class="card-actions justify-end mt-4">
      <Button variant="primary" size="sm" href={`/projects/${project.id}`}>
        Подробнее
        <i class={`fas ${icons.arrow} ml-1`}></i>
      </Button>
    </div>
  </div>
</div>
