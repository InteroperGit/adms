---
// src/components/cards/ReviewCard.astro
import type { Review } from '@/types';

export interface Props {
  review: Review;
}

const { review } = Astro.props;
---

<figure class="review-card">
  <blockquote><p>{review.text}</p></blockquote>
  <figcaption>
          <img
            src={review.avatar}
            alt={review.avatarAlt}
            width={review.avatarWidth}
            height={review.avatarHeight}
            loading="lazy"
            decoding="async"
          />
      <div class="review-author">
        <p class="review-name">{review.name}</p>
        <p class="review-company">
          {review.position}, {review.company}
        </p>
      </div>
  </figcaption>
</figure>

<style>
  .review-card { margin: 0; min-width: 0; display: flex; flex-direction: column; gap: 1.5rem; padding: clamp(1rem, 2vw, 1.5rem); border: 1px solid var(--color-base-300); border-radius: var(--radius-field); background: var(--color-base-100); overflow-wrap: anywhere; }
  blockquote { margin: 0; line-height: 1.7; }
  figcaption { display: flex; align-items: center; gap: 1rem; margin-top: auto; padding-top: 1.25rem; border-top: 1px solid var(--color-base-300); }
  figcaption img { width: 48px; height: 48px; flex-shrink: 0; border-radius: 50%; object-fit: cover; background: var(--color-base-200); }
  .review-author { min-width: 0; }
  .review-name { font-weight: 600; line-height: 1.4; }
  .review-company { margin-top: .25rem; font-size: .875rem; color: var(--color-muted); line-height: 1.5; }
</style>
