---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Service } from '@/types/services';

export interface Props {
  service: Service;
}

const { service } = Astro.props;
const { image } = service;
const originals = import.meta.glob<ImageMetadata>(
  '/src/assets/**/*.{avif,jpeg,jpg,png,webp}',
  { eager: true, import: 'default' },
);
const original = image ? originals[image.src] : undefined;
if (image?.src.startsWith('/src/assets/') && !original) {
  throw new Error(`Service image not found (${service.id}): ${image.src}`);
}
const focalPoint = (point: { x: number; y: number }) =>
  `${point.x}% ${point.y}%`;
const sizes = '(min-width: 68rem) 380px, (min-width: 42rem) 46vw, 94vw';
---

<article class="service-card" aria-labelledby={`service-${service.id}`}>
  {image && (
    <div
      class="service-photo"
      style={{
        '--desktop-focal-point': focalPoint(image.desktopFocalPoint),
        '--mobile-focal-point': focalPoint(image.mobileFocalPoint),
      }}
    >
      {original ? <Image
        src={original}
        alt={image.alt}
        width={image.width}
        height={image.height}
        widths={[320, 480, 768]}
        sizes={sizes}
        loading="lazy"
        decoding="async"
        class="service-image"
      /> : <img
        src={image.src}
        alt={image.alt}
        width={image.width}
        height={image.height}
        loading="lazy"
        decoding="async"
        class="service-image"
      />}
    </div>
  )}
  <h3 id={`service-${service.id}`} class="service-title">
    {service.href ? <a href={service.href}>{service.name}</a> : service.name}
  </h3>
  <p class="service-description">{service.description}</p>
</article>

<style>
  /* Let lettering and work photos define cards without extra decoration. */
  .service-card {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  /* Reserve stable image space while a supplied photograph loads. */
  .service-photo {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-field);
    background: var(--color-base-300);
    margin-bottom: 1.25rem;
  }

  /* Keep the approved subject within the desktop crop. */
  .service-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--desktop-focal-point);
  }

  /* Make the service name the card's primary reading and navigation cue. */
  .service-title {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 700;
    line-height: 1.3;
  }

  /* Keep a persistent link cue for available service detail pages. */
  .service-title a {
    display: inline-block;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    padding-block: 0.25rem;
  }

  /* Keep the brief explanation readable beside a strong service heading. */
  .service-description {
    color: var(--site-muted);
    max-width: 48ch;
    margin-top: 0.75rem;
  }

  /* Use the separately reviewed subject position on narrow layouts. */
  @media (max-width: 41.999rem) {
    /* Preserve the mobile subject when the grid becomes a single column. */
    .service-image {
      object-position: var(--mobile-focal-point);
    }
  }
</style>
