---
// Provide the shared semantic structure and presentation for catalog cards.
// Domain components pass validated copy, media, metadata and native routes.

import ContentImage from "@/components/content/ContentImage.astro";
import Card from "@/components/ui/Card.astro";
import Link from "@/components/ui/Link.astro";
import type { ContentImage as ContentImageData } from "@/types/contentBlocks";

// Callers supply one card's presentation-ready content.
export interface Props {
  title: string;
  titleId: string;
  description: string;
  href?: string;
  image?: ContentImageData;
  category?: { label: string; color: string; textColor: string };
  metadata?: string;
  actionLabel?: string;
  actionName?: string;
  projectLink?: boolean;
}

const {
  title,
  titleId,
  description,
  href,
  image,
  category,
  metadata,
  actionLabel = "Подробнее",
  actionName = `Подробнее: ${title}`,
  projectLink = false,
} = Astro.props;
---

{/* Keep content in a shared image, title and action reading order. */}
<Card
  as="article"
  class="catalog-card"
  aria-labelledby={titleId}
>
  {image && (
    <ContentImage
      image={image}
      serviceCrop
      sizes="(min-width: 68rem) 368px, (min-width: 42rem) 46vw, 94vw"
    />
  )}
  <div class="catalog-copy">
    {category && (
      <span
        class="catalog-category"
        style={`--category-background: ${category.color};
          --category-text: ${category.textColor}`}
      >
        {category.label}
      </span>
    )}
    <h3
      id={titleId}
      class="catalog-title"
    >
      {href ? (
        <Link
          href={href}
          underline={false}
        >
          {title}
        </Link>
      ) : (
        title
      )}
    </h3>
    {metadata && <p class="catalog-client">{metadata}</p>}
    <p class="catalog-description">{description}</p>
    {href && (
      <Link
        class="catalog-action"
        href={href}
        aria-label={actionName}
        data-project-link={projectLink ? true : undefined}
      >
        {actionLabel}
      </Link>
    )}
  </div>
</Card>

<style>
  /* Stack the catalog image and copy within a single grid item. */
  .catalog-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    overflow-wrap: anywhere;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  /* Highlight the complete entry when it receives pointer or keyboard focus. */
  .catalog-card:hover,
  .catalog-card:focus-within {
    border-color: var(--color-primary);
    background-color: color-mix(
      in srgb,
      var(--color-base-100) 82%,
      var(--color-primary)
    );
    box-shadow: var(--shadow-elevated);
    transform: translateY(-0.125rem);
  }

  /* Keep the image flush with the top of the shared card. */
  .catalog-card :global(.content-media-frame) {
    border-radius: 0;
    background: var(--color-base-300);
  }

  /* Retain the original project card's plain base surface behind text. */
  .catalog-copy {
    min-width: 0;
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1rem, 2vw, 1.5rem);
    background: var(--color-base-100);
  }

  /* Use authored category colors with readable text and a compact shape. */
  .catalog-category {
    align-self: flex-start;
    max-width: 100%;
    padding: 0.3rem 0.65rem;
    color: var(--category-text);
    background: var(--category-background);
    border-radius: var(--radius-field);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  /* Keep linked titles plain and readable above the separate detail action. */
  .catalog-title {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.3;
  }

  /* Distinguish title links through focus and the separate detail action. */
  .catalog-title :global(a) {
    color: var(--color-base-content);
    text-decoration: none;
  }

  /* Separate client and date context from each project summary. */
  .catalog-client {
    margin: 0;
    color: var(--site-muted);
    font-size: 0.875rem;
  }

  /* Keep summary copy readable and align actions across neighboring cards. */
  .catalog-description {
    flex: 1;
    max-width: 48ch;
    margin: 0;
    color: var(--site-muted);
    line-height: 1.55;
  }

  /* Give the native detail link a persistent cue and touch-sized target. */
  :global(.catalog-action) {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: 2.75rem;
    margin-top: 0.25rem;
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Remove card lift and transitions for reduced-motion preferences. */
  @media (prefers-reduced-motion: reduce) {
    .catalog-card {
      transition: none;
    }

    /* Preserve the focus surface without translating the card. */
    .catalog-card:hover,
    .catalog-card:focus-within {
      transform: none;
    }
  }
</style>
