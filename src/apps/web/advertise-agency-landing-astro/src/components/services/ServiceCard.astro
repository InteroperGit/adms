---
// Adapt validated service metadata to the shared catalog card presentation.
// Local service imagery must exist; approval and demo policy stay in content.

import type { ImageMetadata } from "astro";
import Card from "@/components/cards/Card.astro";
import type { Service } from "@/types/services";

// Caller supplies a validated service record from the content layer.
export interface Props {
  service: Service;
}

const { service } = Astro.props;
const image = service.image
  ? {
      type: "image" as const,
      src: service.image.src,
      alt: service.image.alt,
      width: service.image.width,
      height: service.image.height,
      focalPoint: service.image.desktopFocalPoint,
      mobileFocalPoint: service.image.mobileFocalPoint,
    }
  : undefined;
const localImages = import.meta.glob<ImageMetadata>(
  "/src/assets/**/*.{avif,jpeg,jpg,png,webp}",
  { eager: true, import: "default" },
);
if (
  service.image?.src.startsWith("/src/assets/") &&
  !localImages[service.image.src]
) {
  throw new Error(
    `Service image not found (${service.id}): ${service.image.src}`,
  );
}
---

{/* Preserve service IDs and native routes while sharing card behavior. */}
<Card
  title={service.name}
  titleId={`service-${service.id}`}
  description={service.description}
  href={service.href}
  image={image}
  actionName={`Подробнее об услуге: ${service.name}`}
/>
