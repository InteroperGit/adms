---
// Render accessible search and category controls for a catalog instance.
interface Props {
  categories: { value: string; label: string }[];
  categoryId: string;
  labels: {
    search: string;
    searchPlaceholder: string;
    category: string;
    allCategories: string;
  };
  searchId: string;
}

const { categories, categoryId, labels, searchId } = Astro.props;
---

<form
  class="catalog-controls"
  role="search"
  data-catalog-controls
  hidden
>
  <label for={searchId}>{labels.search}</label>
  <input
    id={searchId}
    name="q"
    type="search"
    placeholder={labels.searchPlaceholder}
    autocomplete="off"
  />
  <fieldset>
    <legend>{labels.category}</legend>
    <select
      id={categoryId}
      name="category"
    >
      <option value="">{labels.allCategories}</option>
      {categories.map((category) => (
        <option value={category.value}>{category.label}</option>
      ))}
    </select>
  </fieldset>
</form>

<style>
  /* Keep search controls grouped and aligned with the result grid. */
  .catalog-controls {
    display: grid;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding: clamp(1rem, 3vw, 1.5rem);
    background: var(--color-base-200);
    border-radius: var(--radius-field);
  }

  /* Keep form labels visible and aligned with their controls. */
  .catalog-controls label,
  .catalog-controls legend {
    font-weight: 600;
  }

  /* Provide a large, keyboard-friendly search target. */
  .catalog-controls input {
    width: 100%;
    min-height: 44px;
    padding: 0.75rem 1rem;
    color: var(--color-base-content);
    background: var(--color-base-100);
    border: 1px solid var(--color-base-300);
    border-radius: var(--radius-field);
  }

  /* Remove the browser fieldset frame while preserving semantics. */
  .catalog-controls fieldset {
    min-width: 0;
    border: 0;
  }

  /* Keep the native select easy to operate on touch screens. */
  .catalog-controls select {
    width: 100%;
    min-height: 44px;
    margin-top: 0.75rem;
    padding: 0.625rem 1rem;
    color: var(--color-base-content);
    background: var(--color-base-100);
    border: 1px solid var(--color-base-300);
    border-radius: var(--radius-field);
  }
</style>
