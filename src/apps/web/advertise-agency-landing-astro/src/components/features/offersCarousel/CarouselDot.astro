---
interface Props {
  index: number;
  current: boolean;
  itemName: string;
  manualNavigation: boolean;
  slideId: string;
}

const { index, current, itemName, manualNavigation, slideId } = Astro.props;
---

{manualNavigation ? (
  <button
    class="carousel-dot"
    type="button"
    data-index={index}
    aria-label={`Показать: ${itemName} ${index + 1}`}
    aria-controls={slideId}
    aria-current={current ? "true" : undefined}
  >
    <span aria-hidden="true"></span>
  </button>
) : (
  <span
    class="carousel-dot"
    data-index={index}
  >
    <span></span>
  </span>
)}

<style>
  .carousel-dot {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 auto;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #fff;
    cursor: pointer;
  }

  .carousel-dot span {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.68;
    filter: drop-shadow(0 0 2px #000);
    transition:
      opacity 220ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .carousel-dot[aria-current="true"] span {
    opacity: 1;
    transform: scale(1.2);
  }

  span.carousel-dot {
    pointer-events: none;
    cursor: default;
  }

  .carousel-dot:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 1px;
  }

  :global(offers-image-carousel[data-animation="false"]) .carousel-dot span {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-dot span {
      transition: none;
    }
  }
</style>
