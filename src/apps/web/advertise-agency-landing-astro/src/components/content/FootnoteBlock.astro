---
// Display an authored note and its validated native article-target link.
import type { FootnoteBlock as Footnote } from '@/types/content-blocks';
interface Props {
  block: Footnote;
}
const { block } = Astro.props as Props;
---

{/* The shared stream owns this note's anchor; target links work without JS. */}
<aside class="content-footnote" role="note">
  {block.reference && <strong>{block.reference} </strong>}{block.text}
  {block.targetId && <a href={`#${block.targetId}`}>К разделу</a>}
</aside>
