---
// Render plain paragraphs without embedding structural headings.
import type { ParagraphBlock as Paragraph } from '@/types/content-blocks';
import { paragraphLinks } from '@/content/paragraph-links';

interface Props {
  block: Paragraph;
}
type ParagraphText = Paragraph['paragraphs'][number];

const { block } = Astro.props as Props;
---

{/* The outer stream owns the block anchor; this block contains prose only. */}
<section class="content-paragraph">
  {block.paragraphs.map((paragraph: ParagraphText) => (
    <p>{paragraphLinks(paragraph).map((segment) => segment.href
      ? <a href={segment.href}>{segment.text}</a>
      : segment.text)}</p>
  ))}
</section>

<style>
  /* Share the article measure without framing prose as a separate card. */
  .content-paragraph {
    max-inline-size: var(--site-reading-width);
    min-inline-size: 0;
    color: var(--color-base-content);
    overflow-wrap: anywhere;
  }

  /* Comfortable leading remains relative to enlarged user text. */
  .content-paragraph p {
    margin: 0;
    line-height: 1.7;
  }

  /* Scale paragraph separation gently from phones to wide reading columns. */
  .content-paragraph p + p {
    margin-block-start: clamp(0.75rem, 2vw, 1rem);
  }

  /* Underlines identify links without depending on theme color alone. */
  .content-paragraph a {
    color: var(--content-block-accent);
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  /* Strengthen hover feedback without moving surrounding text. */
  .content-paragraph a:hover {
    text-decoration-thickness: 0.14em;
  }

  /* Keep multiline URL links visible during keyboard navigation. */
  .content-paragraph a:focus-visible {
    outline: var(--content-block-focus-ring);
    outline-offset: 3px;
    border-radius: 0.125rem;
  }
</style>
