---
import type { ParagraphBlock as Paragraph } from '@/types/content-blocks';

interface Props { block: Paragraph }
type ParagraphText = Paragraph['paragraphs'][number];

const { block } = Astro.props as Props;
---

<section class="content-paragraph"
  aria-labelledby={block.heading ? block.id : undefined}>
  {block.heading && <h2 id={block.id}>{block.heading}</h2>}
  {block.paragraphs.map((paragraph: ParagraphText) => <p>{paragraph}</p>)}
</section>
