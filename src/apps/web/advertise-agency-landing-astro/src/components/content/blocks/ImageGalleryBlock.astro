---
// Give image galleries the same full-width visual weight as chart surfaces.
import type { ImageGalleryBlock as GalleryBlock } from "@/types/contentBlocks";
import ImageGallery from "../media/ImageGallery.astro";

interface Props {
  block: GalleryBlock;
  priority?: boolean;
}

const { block, priority = false } = Astro.props as Props;
---

<div class="image-gallery-block">
  <ImageGallery
    block={block}
    priority={priority}
  />
</div>

<style>
  /* Let the gallery span the complete article reading column. */
  .image-gallery-block {
    width: 100%;
    min-width: 0;
    margin-block: 2rem;
    padding: clamp(0.875rem, 2.5vw, 1.5rem);
    background: color-mix(in srgb, var(--color-base-200) 28%, transparent);
    border-block: 1px solid var(--content-block-border);
  }

  /* Let the tile layout use the full width of the reading surface. */
  .image-gallery-block :global(.content-gallery) {
    width: 100%;
    margin-inline: auto;
  }

  /* Keep the chart-like surface comfortable on narrow screens. */
  @media (max-width: 42rem) {
    .image-gallery-block {
      padding-inline: 0.75rem;
    }
  }
</style>
