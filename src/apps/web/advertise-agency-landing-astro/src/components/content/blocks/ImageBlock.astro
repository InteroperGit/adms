---
// Render authored media with a production URL and reserved intrinsic space.
import type { ImageBlock as ImageContent } from "@/types/contentBlocks";
import ImageGallery from "@/components/ui/media/ImageGallery.astro";
import type { ImageCrop } from "@/components/ui/media/types";

interface Props {
  block: ImageContent;
  priority?: boolean;
  crop?: ImageCrop;
}
const { block, priority = false, crop } = Astro.props as Props;
---

{/* Captions retain the author's qualification of the image. */}
<div class="content-image">
  <ImageGallery
    images={[block]}
    id={block.id}
    caption={block.caption}
    priority={priority}
    layout="single"
    crop={crop}
  />
</div>

<style>
  /* Keep a standalone image as one responsive media group in the stream. */
  .content-image {
    width: 100%;
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
  }

  /* Keep article captions readable below the reserved media frame. */
  .content-image :global(.media-gallery-caption) {
    margin-block-start: var(--content-block-caption-gap);
    color: var(--content-block-caption);
    line-height: 1.5;
  }
</style>
