---
// Render a progressive-enhancement gallery for an image-gallery block.
import type { ImageGalleryBlock } from '@/types/content-blocks';
import { resolveContentImage } from './resolve-image';
import ImageGalleryTiles from './ImageGalleryTiles.astro';
import ImageGalleryLightbox from './ImageGalleryLightbox.astro';
import type { GalleryImage } from './image-gallery.types';

interface Props {
  block: ImageGalleryBlock;
  // Prioritize the first tile when the gallery starts above the fold.
  priority?: boolean;
}

const { block, priority = false } = Astro.props as Props;
// Keep source metadata and its resolved full-size URL together for both views.
const images: GalleryImage[] = await Promise.all(
  block.images.map(async (image) => ({
    image,
    src: (await resolveContentImage(image)).src,
  })),
);

const galleryId = `gallery-${block.id ?? crypto.randomUUID()}`;
---

{images.length > 0 && (
  <figure class="content-gallery" id={galleryId} data-gallery>
    {/* Keep every tile as a native link when JavaScript is unavailable. */}
    <ImageGalleryTiles images={images} priority={priority} />

    {/* Native modal dialog provides browser focus containment. */}
    <ImageGalleryLightbox images={images} />

    {block.caption && <figcaption>{block.caption}</figcaption>}
  </figure>
)}

<script>
  import { initializeImageGalleries } from '@/scripts/image-gallery';

  initializeImageGalleries();
</script>

<style>
  /* Keep the gallery figure aligned with the enclosing local surface. */
  .content-gallery {
    display: grid;
    gap: 0.875rem;
    min-width: 0;
    margin: 0;
  }

  /* Treat the gallery caption as editorial metadata beneath the surface. */
  .content-gallery > figcaption {
    max-width: 65ch;
    color: var(--content-block-caption);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
</style>
