---
// One ordered article renderer for normalized MDX and explicit JSON fallback.
// Only the page supplies owner context; authors cannot enable production forms.
import type { ContentBlock } from '@/types/content-blocks';
import type { ArticleContext } from '@/content/article-context';
import {
  blockDemoNotice,
  getVisibleBlocks,
  hasDemoBlocks,
} from '@/content/block-publication';
import ChartBlock from './ChartBlock.astro';
import FootnoteBlock from './FootnoteBlock.astro';
import HeadingBlock from './HeadingBlock.astro';
import ImageBlock from './ImageBlock.astro';
import ImageGalleryBlock from './ImageGalleryBlock.astro';
import ListBlock from './ListBlock.astro';
import OrderFormBlock from './OrderFormBlock.astro';
import ParagraphBlock from './ParagraphBlock.astro';
import QuoteBlock from './QuoteBlock.astro';
import TableBlock from './TableBlock.astro';

interface Props {
  blocks: ContentBlock[];
  /** Omitted context uses general inquiry and full-image framing. */
  context?: ArticleContext;
}
const { blocks, context } = Astro.props as Props;
// Filter before choosing eager media so hidden drafts never take its priority.
const visibleBlocks = getVisibleBlocks(blocks);
const demo = hasDemoBlocks(blocks);
// A mixed demo stream cannot enable production forms via an approved owner.
const formContext = context && demo
  ? { ...context, published: false } : context;
const firstMediaIndex = visibleBlocks.findIndex((block) =>
  block.type === 'image' || block.type === 'image-gallery');
---

{/* Block IDs identify article targets, including standalone headings. */}
<div class="content-blocks">
  {/* Qualify demo blocks even when an approved page contains mixed content. */}
  {demo && <p class="block-demo-notice">{blockDemoNotice}</p>}
  {visibleBlocks.map((block: ContentBlock, index) => (
    <div
      class="content-block"
      data-block-type={block.type}
      id={block.type === 'order-form' ? undefined : block.id}
    >
      {block.type === 'heading' && <HeadingBlock block={block} />}
      {block.type === 'paragraph' && (
        <ParagraphBlock block={block} />
      )}
      {(block.type === 'ordered-list' ||
        block.type === 'unordered-list') && <ListBlock block={block} />}
      {block.type === 'table' && <TableBlock block={block} />}
      {block.type === 'chart' && <ChartBlock block={block} />}
      {block.type === 'image' && (
        <ImageBlock
          block={block}
          priority={index === firstMediaIndex}
          serviceCrop={context?.kind === 'service'}
        />
      )}
      {block.type === 'image-gallery' && (
        <ImageGalleryBlock
          block={block}
          priority={index === firstMediaIndex}
        />
      )}
      {block.type === 'order-form' && (
        <OrderFormBlock
          block={block}
          context={block.status === 'published' && context
            ? { ...context, published: true } : formContext}
        />
      )}
      {block.type === 'quote' && <QuoteBlock block={block} />}
      {block.type === 'footnote' && <FootnoteBlock block={block} />}
    </div>
  ))}
</div>

<style>
  /* Keep articles in one reading column with consistent section spacing. */
  .content-blocks {
    display: grid;
    gap: var(--content-block-gap);
    max-width: var(--site-reading-width);
    overflow-wrap: anywhere;
  }

  /* Keep blocks in one flow while allowing tables and media to shrink. */
  .content-block {
    min-width: 0;
    scroll-margin-top: var(--site-header-clearance, 5rem);
  }

  /* Keep demo disclosure distinct from approved narrative and media. */
  .block-demo-notice {
    padding-left: 1rem;
    border-left: 3px solid var(--content-block-accent);
    color: var(--content-block-caption);
  }

  /* Use a comfortable line height for both narrative and inquiry paragraphs. */
  .content-block :global(p) {
    line-height: 1.7;
  }

  /* Separate consecutive paragraphs within an authored prose block. */
  .content-block :global(p + p) {
    margin-top: 0.75rem;
  }

  /* Make native list semantics visible despite the site's CSS reset. */
  .content-block :global(ul),
  .content-block :global(ol) {
    padding-left: 1.5rem;
  }

  /* Give unordered content its expected markers. */
  .content-block :global(ul) {
    list-style: disc;
  }

  /* Preserve authored numbering for ordered content. */
  .content-block :global(ol) {
    list-style: decimal;
  }

  /* Keep media qualifications legible beneath their images. */
  .content-block :global(figcaption) {
    margin-top: var(--content-block-caption-gap);
    color: var(--content-block-caption);
  }

  /* Keep the lightbox caption legible on its fixed dark backdrop. */
  .content-block :global(.gallery-caption) {
    color: white;
  }

  /* Contain wide tables without causing document-level horizontal overflow. */
  .content-block :global(.table-scroll) {
    overflow-x: auto;
  }
</style>
