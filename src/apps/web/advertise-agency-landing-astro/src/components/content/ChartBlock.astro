---
// Render a responsive chart with a semantic, expandable data fallback.
import type { ChartBlock as ChartBlockType } from '@/types/content-blocks';

interface Props {
  block: ChartBlockType;
}

const { block } = Astro.props as Props;
const chartId = `chart-${block.id ?? crypto.randomUUID()}`;
const primarySeries = block.series[0];
const maximum = Math.max(
  ...(primarySeries?.points.map((point) => point.value) ?? [1]),
  1,
);
const labels = [...new Set(block.series.flatMap((series) =>
  series.points.map((point) => point.label),
))];
---

<figure class="content-chart" data-chart-figure={chartId}>
  <div
    class="content-chart__canvas"
    id={chartId}
    data-chart={JSON.stringify({
      chartType: block.chartType,
      unit: block.unit,
      series: block.series,
    })}
    role="img"
    aria-label={block.caption ?? 'Диаграмма'}
  ></div>
  {block.series.length > 0 && (
    <ul class="content-chart__legend" aria-label="Легенда диаграммы">
      {block.series.map((series) => (
        <li>
          <span class="content-chart__legend-swatch" aria-hidden="true"></span>
          {series.name}
        </li>
      ))}
    </ul>
  )}
  <div class="content-chart__bars" aria-label="Диаграмма без JavaScript">
    {primarySeries?.points.map((point) => (
      <div class="content-chart__bar-row">
        <span class="content-chart__bar-label">{point.label}</span>
        <span class="content-chart__bar-track">
          <span
            class="content-chart__bar-value"
            style={`width: ${(point.value / maximum) * 100}%`}
          ></span>
        </span>
        <strong class="content-chart__bar-number">
          {point.value}{block.unit ? ` ${block.unit}` : ''}
        </strong>
      </div>
    ))}
  </div>
  <details class="content-chart__data">
    <summary>Показать данные диаграммы</summary>
    <div class="content-chart__data-scroll">
      <table>
        <thead>
          <tr>
            <th scope="col">Серия</th>
            {labels.map((label) => <th scope="col">{label}</th>)}
          </tr>
        </thead>
        <tbody>
          {block.series.map((series) => (
            <tr>
              <th scope="row">{series.name}</th>
              {labels.map((label) => (
                <td>
                  {series.points.find((point) => point.label === label)?.value
                    ?? '—'}
                  {block.unit && ' ' + block.unit}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
  {block.caption && <figcaption>{block.caption}</figcaption>}
</figure>

<style>
  /* Keep the chart as one meaningful visual group in the article flow. */
  .content-chart {
    margin: 2rem 0;
    padding: 1rem;
    background: color-mix(in srgb, var(--color-base-200) 35%, transparent);
    border-block: 1px solid var(--content-block-border);
  }

  /* Reserve the canvas footprint before the optional runtime loads. */
  .content-chart__canvas {
    min-block-size: 18rem;
    width: 100%;
  }

  /* Explain series colors without relying on color alone. */
  .content-chart__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  /* Give each series a stable visual key shared with the canvas runtime. */
  .content-chart__legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  /* Use a visible swatch for each series key. */
  .content-chart__legend-swatch {
    inline-size: 0.75rem;
    block-size: 0.75rem;
    background: var(--color-primary);
    border: 1px solid var(--content-block-border);
  }

  /* Match runtime colors so legend keys remain useful after enhancement. */
  .content-chart__legend li:nth-child(2) .content-chart__legend-swatch {
    background: #c2410c;
  }

  .content-chart__legend li:nth-child(3) .content-chart__legend-swatch {
    background: #2563eb;
  }

  .content-chart__legend li:nth-child(4) .content-chart__legend-swatch {
    background: #9333ea;
  }

  .content-chart__legend li:nth-child(5) .content-chart__legend-swatch {
    background: #be123c;
  }

  .content-chart__legend li:nth-child(6) .content-chart__legend-swatch {
    background: #4d7c0f;
  }

  /* Keep readable data visible before and after optional canvas enhancement. */
  .content-chart__bars {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  /* Canvas enhancement replaces only the duplicated visual fallback. */
  .content-chart[data-chart-enhanced] .content-chart__bars {
    display: none;
  }

  /* Align labels, tracks and values while preserving a hanging label column. */
  .content-chart__bar-row {
    display: grid;
    grid-template-columns: minmax(9rem, 0.8fr) 2fr auto;
    align-items: center;
    gap: 0.75rem;
  }

  /* Wrap long authored labels instead of widening the document. */
  .content-chart__bar-label {
    overflow-wrap: anywhere;
  }

  /* Keep zero and small values visible against a neutral track. */
  .content-chart__bar-track {
    display: block;
    block-size: 1rem;
    overflow: hidden;
    border-radius: 999px;
    background: var(--color-base-300);
  }

  /* Use the primary accent for the no-JavaScript value bar. */
  .content-chart__bar-value {
    display: block;
    block-size: 100%;
    border-radius: inherit;
    background: var(--color-primary);
  }

  /* Keep numeric values aligned at the end of each row. */
  .content-chart__bar-number {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* Let wide fallback tables scroll inside the chart surface. */
  .content-chart__data-scroll {
    max-inline-size: 100%;
    overflow-x: auto;
  }

  /* Give the expanded fallback table the same readable numeric rhythm. */
  .content-chart__data table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  /* Keep fallback labels and values distinct for keyboard and print users. */
  .content-chart__data th,
  .content-chart__data td {
    padding: 0.45rem 0.6rem;
    border-bottom: 1px solid var(--content-block-border);
    text-align: start;
    white-space: nowrap;
  }

  /* Stack fallback rows when the viewport cannot hold chart labels. */
  @media (max-width: 42rem) {
    .content-chart {
      padding-inline: 0.75rem;
    }

    .content-chart__bar-row {
      grid-template-columns: 1fr auto;
    }

    .content-chart__bar-track {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  /* Preserve a quiet static chart for readers who request less motion. */
  @media (prefers-reduced-motion: reduce) {
    .content-chart__bar-value {
      transition: none;
    }
  }
</style>

<script>
  // Enhance visible charts only; the semantic fallback remains complete.
  const elements = document.querySelectorAll<HTMLElement>('[data-chart]');
  const enhance = async (element: HTMLElement) => {
    try {
      const { renderChart } = await import('@/scripts/chart-runtime');
      renderChart(element);
      element.closest<HTMLElement>('[data-chart-figure]')?.setAttribute(
        'data-chart-enhanced',
        'true',
      );
    } catch {
      // Keep the server-rendered bars and data table when canvas fails.
      element.hidden = true;
    }
  };
  if (elements.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        observer.unobserve(entry.target);
        void enhance(entry.target as HTMLElement);
      });
    });
    elements.forEach((element) => observer.observe(element));
    window.addEventListener('pagehide', (event) => {
      if (!event.persisted) observer.disconnect();
    });
  } else {
    elements.forEach((element) => { void enhance(element); });
  }
</script>
