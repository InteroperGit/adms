---
// Keep chart data readable without JS; load the canvas runtime on visibility.
import type { ChartBlock as ChartBlockType } from '@/types/content-blocks';

interface Props {
  block: ChartBlockType;
}

const { block } = Astro.props as Props;
const chartId = `chart-${block.id ?? crypto.randomUUID()}`;
const primarySeries = block.series[0];
const maximum = Math.max(
  ...(primarySeries?.points.map((point) => point.value) ?? [1]),
  1,
);
---

{/* Keep the chart visible while optional client enhancement is loading. */}
<figure class="content-chart" data-chart-figure={chartId}>
  {block.title && <h2>{block.title}</h2>}
  <div
    class="content-chart__canvas"
    id={chartId}
    data-chart={JSON.stringify({
      chartType: block.chartType,
      unit: block.unit,
      series: block.series,
    })}
    aria-hidden="true"
  ></div>
  <div class="content-chart__bars" aria-label={block.title}>
    {primarySeries?.points.map((point) => (
      <div class="content-chart__bar-row">
        <span class="content-chart__bar-label">{point.label}</span>
        <span class="content-chart__bar-track">
          <span
            class="content-chart__bar-value"
            style={`width: ${(point.value / maximum) * 100}%`}
          ></span>
        </span>
        <strong class="content-chart__bar-number">
          {point.value}{block.unit ? ` ${block.unit}` : ''}
        </strong>
      </div>
    ))}
  </div>
  {block.caption && <figcaption>{block.caption}</figcaption>}
</figure>

<style>
  /* Separate the visual and its accessible data from neighbouring blocks. */
  .content-chart {
    margin: 2rem 0;
  }

  /* Reserve chart height before its lazy runtime arrives. */
  .content-chart__canvas {
    min-height: 18rem;
    width: 100%;
  }

  /* Keep a readable chart visible before optional ECharts enhancement. */
  .content-chart__bars {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  /* Let the interactive canvas replace the static version after loading. */
  .content-chart[data-chart-enhanced] .content-chart__bars {
    display: none;
  }

  /* Align each label, bar and value into a compact data row. */
  .content-chart__bar-row {
    display: grid;
    grid-template-columns: minmax(9rem, 0.8fr) 2fr auto;
    align-items: center;
    gap: 0.75rem;
  }

  /* Keep long stage names readable without widening the page. */
  .content-chart__bar-label {
    overflow-wrap: anywhere;
  }

  /* Provide a neutral track so zero and small values remain visible. */
  .content-chart__bar-track {
    display: block;
    height: 1rem;
    overflow: hidden;
    border-radius: 999px;
    background: var(--color-base-300);
  }

  /* Use the site accent for the proportional data value. */
  .content-chart__bar-value {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--color-primary);
  }

  /* Keep numeric values aligned at the end of every row. */
  .content-chart__bar-number {
    white-space: nowrap;
  }

  /* Stack chart rows when labels and tracks no longer fit side by side. */
  @media (max-width: 42rem) {
    .content-chart__bar-row {
      grid-template-columns: 1fr auto;
    }

    .content-chart__bar-track {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>

<script>
  // No chart means no runtime request, including pages sharing this renderer.
  const elements = document.querySelectorAll<HTMLElement>('[data-chart]');
  const enhance = async (element: HTMLElement) => {
    try {
      const { renderChart } = await import('@/scripts/chart-runtime');
      renderChart(element);
      element.closest<HTMLElement>('[data-chart-figure]')?.setAttribute(
        'data-chart-enhanced', 'true',
      );
    } catch {
      // Network/canvas failures retain the complete server-rendered chart.
      element.hidden = true;
    }
  };
  if (elements.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        observer.unobserve(entry.target);
        void enhance(entry.target as HTMLElement);
      });
    });
    elements.forEach((element) => observer.observe(element));
    window.addEventListener('pagehide', (event) => {
      // Cached pages keep their observers for browser Back/Forward restore.
      if (!event.persisted) observer.disconnect();
    });
  } else {
    elements.forEach((element) => { void enhance(element); });
  }
</script>
