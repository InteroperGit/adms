---
// Keep chart data readable without JS; load the canvas runtime on visibility.
import type { ChartBlock as ChartBlockType } from '@/types/content-blocks';

interface Props {
  block: ChartBlockType;
}

const { block } = Astro.props as Props;
const chartId = `chart-${block.id ?? crypto.randomUUID()}`;
// Use a common label order so missing series values remain explicit in rows.
const labels = [...new Set(block.series.flatMap((series) =>
  series.points.map((point) => point.label),
))];
---

{/* The native table remains available when enhancement fails or is blocked. */}
<figure class="content-chart" data-chart-figure={chartId}>
  {block.title && <h2>{block.title}</h2>}
  <div
    class="content-chart__canvas"
    id={chartId}
    data-chart={JSON.stringify({
      chartType: block.chartType,
      unit: block.unit,
      series: block.series,
    })}
    aria-hidden="true"
  ></div>
  <div class="table-scroll">
    <table class="content-chart__table">
      <caption>{block.caption ?? block.title ?? 'Данные графика'}</caption>
      <thead>
        <tr>
          <th scope="col">Показатель</th>
          {block.series.map((series) => <th scope="col">{series.name}</th>)}
        </tr>
      </thead>
      <tbody>
        {labels.map((label) => (
          <tr>
            <th scope="row">{label}</th>
            {block.series.map((series) => {
              const point = series.points.find((item) => item.label === label);
              return (
                <td>
                  {point
                    ? `${point.value}${block.unit ? ` ${block.unit}` : ''}`
                    : '—'}
                </td>
              );
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {block.caption && <figcaption>{block.caption}</figcaption>}
</figure>

<style>
  /* Separate the visual and its accessible data from neighbouring blocks. */
  .content-chart {
    margin: 2rem 0;
  }

  /* Reserve chart height before its lazy runtime arrives. */
  .content-chart__canvas {
    min-height: 18rem;
    width: 100%;
  }

  /* The fallback spans the same column as the chart it describes. */
  .content-chart__table {
    border-collapse: collapse;
    width: 100%;
  }

  /* Distinguish values and headings in both themes. */
  .content-chart__table th,
  .content-chart__table td {
    border-bottom: 1px solid var(--color-base-300);
    padding: 0.5rem;
    text-align: left;
  }

  /* A visible caption names the data independently of the canvas. */
  .content-chart__table caption {
    margin-bottom: 0.5rem;
    text-align: left;
  }
</style>

<script>
  // No chart means no runtime request, including pages sharing this renderer.
  const elements = document.querySelectorAll<HTMLElement>('[data-chart]');
  const enhance = async (element: HTMLElement) => {
    try {
      const { renderChart } = await import('@/scripts/chart-runtime');
      renderChart(element);
    } catch {
      // Network/canvas failures retain the complete server-rendered table.
      element.hidden = true;
    }
  };
  if (elements.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        observer.unobserve(entry.target);
        void enhance(entry.target as HTMLElement);
      });
    });
    elements.forEach((element) => observer.observe(element));
    window.addEventListener('pagehide', (event) => {
      // Cached pages keep their observers for browser Back/Forward restore.
      if (!event.persisted) observer.disconnect();
    });
  } else {
    elements.forEach((element) => { void enhance(element); });
  }
</script>
