---
// Render responsive native image links; the parent owns lightbox enhancement.
import type { GalleryImage } from "./imageGallery.types";
import ContentImage from "./ContentImage.astro";
import Link from "@/components/ui/Link.astro";

interface Props {
  images: GalleryImage[];
  // Only the first tile receives the parent gallery's loading priority.
  priority?: boolean;
}

const { images, priority = false } = Astro.props;
---

{/* Native links preserve access to each full-size image without JavaScript. */}
<div class="gallery-grid">
  {images.map(({ image, src }, index) => (
    <Link
      class="gallery-tile"
      underline={false}
      href={src}
      data-gallery-open={index}
      aria-current={index === 0 ? "true" : undefined}
    >
      <ContentImage
        image={image}
        thumbnail
        priority={index === 0 && priority}
      />
    </Link>
  ))}
</div>

<style>
  /* Arrange article images as the approved responsive tile composition. */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: clamp(12rem, 19vw, 15.5rem);
    gap: 0.875rem;
    min-width: 0;
  }

  /* Make each whole tile a large, stable target for lightbox activation. */
  :global(.gallery-tile) {
    position: relative;
    display: block;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border-radius: var(--radius-field);
    background: var(--color-base-200);
    color: inherit;
    cursor: zoom-in;
    text-decoration: none;
  }

  /* Give the first photo two adjacent places in the wide layout. */
  :global(.gallery-tile:first-child) {
    grid-column: span 2;
  }

  /* Fill each tile with a crop while preserving its intrinsic image ratio. */
  .gallery-tile :global(.content-media-frame) {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    border-radius: inherit;
  }

  /* Crop tile imagery to its stable frame without stretching it. */
  .gallery-tile :global(.content-media-image) {
    object-fit: cover;
    transition:
      transform 180ms ease,
      filter 180ms ease;
  }

  /* Keep the image target clear during keyboard navigation. */
  :global(.gallery-tile:focus-visible) {
    outline: 3px solid var(--content-block-accent);
    outline-offset: 3px;
  }

  /* Highlight tiles only on devices that can hover precisely. */
  @media (hover: hover) and (pointer: fine) {
    /* Mark the hovered tile with a clear inset brand outline. */
    :global(.gallery-tile:hover) {
      outline: 3px solid var(--color-primary);
      outline-offset: -3px;
    }

    /* Bring the hovered image forward with a slight zoom and dim. */
    :global(.gallery-tile:hover .content-media-image) {
      transform: scale(1.035);
      filter: brightness(0.92);
    }
  }

  /* Remove hover animation when visitors prefer reduced motion. */
  @media (prefers-reduced-motion: reduce) {
    :global(.gallery-tile .content-media-image) {
      transition: none;
    }
  }

  /* Switch the tile wall to two columns at tablet content widths. */
  @media (max-width: 47.5rem) {
    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 12rem;
    }
  }

  /* Give narrow phones one full-width tile at a time. */
  @media (max-width: 30rem) {
    .gallery-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: 13.75rem;
      gap: 0.75rem;
    }

    :global(.gallery-tile:first-child) {
      grid-column: auto;
    }
  }
</style>
