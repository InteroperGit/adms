---
// Present the project title and the small set of verified attribution fields.
import type { Project } from '@/types/project';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<header class="project-heading">
  <h1>{project.title}</h1>
  <dl class="project-meta">
    <div>
      <dt>Заказчик</dt>
      <dd>{project.client}</dd>
    </div>
    <div>
      <dt>Год</dt>
      <dd>
        {project.year
          ? <time datetime={String(project.year)}>{project.year}</time>
          : 'Уточняется'}
      </dd>
    </div>
  </dl>
</header>

<style>
  /* Keep the title and attribution together above the lead image. */
  .project-heading {
    max-width: 50rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  /* Keep one prominent document heading across narrow viewports. */
  h1 {
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.2;
    font-weight: 700;
  }

  /* Compact pairs share one row and wrap on narrow screens. */
  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 1.25rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* Each label and value forms one outlined metadata tag. */
  .project-meta > div {
    display: flex;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
    border: 1px solid var(--color-base-300);
    border-radius: var(--radius-field);
  }

  /* Muted label backgrounds distinguish the two metadata parts. */
  .project-meta dt {
    flex-shrink: 0;
    margin: 0;
    padding: 0.375rem 0.75rem;
    background: var(--color-base-200);
    color: var(--color-muted);
    font-weight: 500;
  }

  /* Values use the page surface and a divider for theme contrast. */
  .project-meta dd {
    min-width: 0;
    margin: 0;
    padding: 0.375rem 0.75rem;
    border-inline-start: 1px solid var(--color-base-300);
    background: var(--color-base-100);
    color: var(--color-base-content);
    font-weight: 600;
  }
</style>
