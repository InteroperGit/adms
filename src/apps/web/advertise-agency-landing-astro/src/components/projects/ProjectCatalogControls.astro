---
import type { ProjectCategoryConfig } from '@/content/project-categories';

interface Props {
  categories: ProjectCategoryConfig[];
}

const { categories } = Astro.props;
---

<form class="catalog-controls" role="search" data-catalog-controls hidden>
  <label for="project-search">Поиск по проектам</label>
  <input
    id="project-search"
    name="q"
    type="search"
    placeholder="Название или заказчик"
    autocomplete="off"
  />
  <fieldset>
    <legend>Категория</legend>
    <select id="project-category" name="category">
      <option value="">Все проекты</option>
      {categories.map((category) => (
        <option value={category.slug}>{category.label}</option>
      ))}
    </select>
  </fieldset>
</form>
