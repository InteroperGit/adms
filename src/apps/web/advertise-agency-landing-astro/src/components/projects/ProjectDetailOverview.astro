---
// Render narrative and factual sections while omitting empty data groups.
import type { Project } from '@/types/project';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const details = project.details ?? {};
const production = details.timing?.production;
const number = new Intl.NumberFormat('ru-RU', {
  maximumFractionDigits: 20,
});
const units = { mm: 'мм', cm: 'см', m: 'м' };
const productionDuration = production
  ? new Intl.NumberFormat('ru-RU', {
    style: 'unit',
    unit: production.unit === 'hours' ? 'hour' : 'day',
    unitDisplay: 'long',
    maximumFractionDigits: 20,
  }).format(production.value)
  : null;
const hasSpecifications = Boolean(details.materials?.length
  || details.dimensions?.length || details.includedWork?.length);
const hasTask = Boolean(details.customerTask || project.fullDescription
  || project.story?.length);
const hasReading = Boolean(hasTask || details.installationContext
  || details.constraints?.length || project.expectedBenefits?.length);
const hasTiming = Boolean(production || details.timing?.design
  || details.timing?.installation || details.timing?.totalDelivery);
const hasFacts = hasSpecifications || hasTiming;
---

{(hasReading || hasFacts) && (
  <div class:list={['project-body', {
    'has-columns': hasReading && hasFacts,
  }]}>
    {hasReading && (
      <div class="project-reading">
        {hasTask && (
          <section aria-labelledby="project-task">
            <h2 id="project-task">
              {details.customerTask ? 'Задача заказчика' :
                'О проекте'}
            </h2>
            {details.customerTask && <p>{details.customerTask}</p>}
            {project.fullDescription && <p>{project.fullDescription}</p>}
            {project.story?.map((paragraph) => <p>{paragraph}</p>)}
          </section>
        )}
        {(details.installationContext || details.constraints?.length) && (
          <section aria-labelledby="project-context">
            <h2 id="project-context">Условия установки</h2>
            {details.installationContext && (
              <p>{details.installationContext}</p>
            )}
            {details.constraints?.length && (
              <ul>
                {details.constraints.map((constraint) => <li>{constraint}</li>)}
              </ul>
            )}
          </section>
        )}
        {project.expectedBenefits?.length && (
          <section aria-labelledby="project-benefits">
            <h2 id="project-benefits">
              Что получает заказчик
            </h2>
            <ul>
              {project.expectedBenefits.map((benefit) => <li>{benefit}</li>)}
            </ul>
          </section>
        )}
      </div>
    )}
    {hasFacts && (
      <div class="project-specifications">
        {hasSpecifications && (
          <section aria-labelledby="project-scope">
            <h2 id="project-scope">Материалы и работы</h2>
            <dl class="project-facts">
              {details.materials?.length && (
                <div>
                  <dt>Материалы</dt>
                  <dd>
                    <ul>
                      {details.materials.map((item) => <li>{item}</li>)}
                    </ul>
                  </dd>
                </div>
              )}
              {details.dimensions?.length && (
                <div>
                  <dt>Размеры</dt>
                  <dd><ul>
                    {details.dimensions.map((dimension) => (
                      <li>
                        {dimension.label}: {number.format(dimension.value)}
                        {' '}{units[dimension.unit]}
                      </li>
                    ))}
                  </ul></dd>
                </div>
              )}
              {details.includedWork?.length && (
                <div>
                  <dt>{project.status === 'demo'
                    ? 'Состав проекта' :
                    'Выполненные работы'}</dt>
                  <dd><ul>
                    {details.includedWork.map((work) => <li>{work}</li>)}
                  </ul></dd>
                </div>
              )}
            </dl>
          </section>
        )}
        {hasTiming && details.timing && (
          <section aria-labelledby="project-timing">
            <h2 id="project-timing">
              {project.status === 'demo' ? 'Плановые сроки' :
                    'Сроки'}
            </h2>
            <dl class="project-facts">
              {production && <div>
                <dt>Производство</dt>
                <dd>{productionDuration}
                  <p class="project-timing-basis">{production.basis}</p>
                </dd>
              </div>}
              {details.timing.design && <div>
                <dt>Дизайн</dt><dd>{details.timing.design}</dd>
              </div>}
              {details.timing.installation && <div>
                <dt>Монтаж</dt><dd>{details.timing.installation}</dd>
              </div>}
              {details.timing.totalDelivery && <div>
                <dt>Общий срок</dt>
                <dd>{details.timing.totalDelivery}</dd>
              </div>}
            </dl>
          </section>
        )}
      </div>
    )}
  </div>
)}

<style>
  /* Mobile reading order presents narrative before factual specifications. */
  .project-body {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  /* Narrative paragraphs stay comfortably readable on wide displays. */
  .project-reading {
    min-width: 0;
    max-width: var(--site-reading-width);
  }

  /* Factual information uses a quiet shared surface without nested cards. */
  .project-specifications {
    min-width: 0;
    padding: clamp(1rem, 3vw, 2rem);
    background: var(--color-base-200);
    border-radius: var(--radius-field);
  }

  /* Clear separation connects adjacent sections. */
  section + section {
    margin-top: 2rem;
  }

  /* Secondary headings organize each case detail. */
  h2 {
    margin-bottom: 1rem;
    font-size: 1.5rem;
    line-height: 1.3;
    font-weight: 700;
  }

  /* Paragraphs use the site's established reading rhythm. */
  .project-body p {
    line-height: 1.7;
  }

  /* Separate consecutive narrative paragraphs. */
  .project-reading p + p {
    margin-top: 1rem;
  }

  /* Native lists keep constraints and work items scannable. */
  ul {
    padding-inline-start: 1.25rem;
    list-style: disc;
  }

  /* Separate items so enlarged text does not merge adjacent facts. */
  li + li {
    margin-top: 0.5rem;
  }

  /* Label/value groups remain aligned when values wrap. */
  .project-facts {
    display: grid;
    gap: 1.5rem;
  }

  /* Labels distinguish scope and timing values. */
  dt {
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  /* Timing basis clarifies what production duration measures. */
  .project-timing-basis {
    margin-top: 0.5rem;
    color: var(--color-muted);
  }

  /* Wide pages pair narrative with measured project facts. */
  @media (min-width: 64rem) {
    /* Two columns use space without stretching paragraph measures. */
    .project-body.has-columns {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: clamp(2rem, 5vw, 4rem);
    }
  }
</style>

