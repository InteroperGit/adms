---
interface Props {
  count: number;
}

const { count } = Astro.props;
---

<div class="catalog-count" data-catalog-count role="status" aria-live="polite">
  <span class="catalog-count__label">Найдено проектов</span>
  <span class="catalog-count__value" data-catalog-count-value>{count}</span>
</div>

<style>
  /* Present the result total as a quiet information badge. */
  .catalog-count {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1.5rem;
    padding: 0.5rem 0.75rem;
    color: var(--color-muted);
    background: var(--color-base-200);
    border: 1px solid var(--color-base-300);
    border-radius: 999px;
    font-size: 0.875rem;
    line-height: 1.25;
  }

  /* Keep the label secondary to the numeric result. */
  .catalog-count__label {
    white-space: nowrap;
  }

  /* Give the changing result a compact, high-contrast emphasis. */
  .catalog-count__value {
    min-width: 1.5rem;
    padding: 0.125rem 0.375rem;
    color: var(--color-primary-content);
    background: var(--color-primary);
    border-radius: 999px;
    font-weight: 700;
    text-align: center;
  }
</style>
