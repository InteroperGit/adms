---
// src/components/Header.astro
import { site } from '@/content/site';
import { icons } from '@/content/icons';
import NavLinks from '@/components/ui/NavLinks.astro';
---

<header class="sticky top-0 z-40 bg-base-100/80 backdrop-blur-md shadow-lg">
  <div class="navbar container mx-auto px-4">
    <div class="flex-1">
      <a href="/" class="text-2xl font-bold text-primary">{site.logoText}</a>
    </div>
    <NavLinks items={site.menu} variant="desktop" phone={site.phone} />
    <div class="md:hidden">
      <label for="mobile-drawer" class="btn btn-ghost btn-circle">
        <span class="text-2xl">{icons.menu.open}</span>
      </label>
    </div>
  </div>
  <input type="checkbox" id="mobile-drawer" class="drawer-toggle" />
  <div class="drawer-side z-50">
    <label for="mobile-drawer" class="drawer-overlay"></label>
    <NavLinks items={site.menu} variant="mobile" phone={site.phone} />
  </div>
</header>