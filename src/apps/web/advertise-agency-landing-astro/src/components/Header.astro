---
// Render shared navigation, brand and settings with a scroll-aware header.
// Site content supplies links; the mobile drawer owns its focus handling.
// Keep focused or expanded controls visible while scrolling.

import { site } from "@/content/site";
import DesktopNavigation from "@/components/ui/DesktopNavigation.astro";
import ContactMenu from "@/components/ui/ContactMenu.astro";
import HeaderAddress from "@/components/ui/HeaderAddress.astro";
import HeaderCall from "@/components/ui/HeaderCall.astro";
import MobileHeaderContacts from "@/components/ui/MobileHeaderContacts.astro";
import MobileMenuDialog from "@/components/ui/MobileMenuDialog.astro";
import Settings from "@/components/ui/Settings.astro";
import HeaderBrand from "@/components/ui/HeaderBrand.astro";
import HeaderMenuOpener from "@/components/ui/HeaderMenuOpener.astro";
---

{/* Keep focused or expanded controls visible while scrolling. */}
<header
  data-auto-hide-header
  class="site-header sticky top-0 z-40"
>
  <div class="header-layout site-container">
    <HeaderBrand />
    <HeaderAddress address={site.address} />
    <HeaderCall phone={site.phone} />
    <ContactMenu phone={site.phone} />
    <Settings />
    <HeaderMenuOpener />
  </div>
  {/* Keep key contact actions visible below the mobile header row. */}
  <DesktopNavigation items={site.menu} />
  <MobileHeaderContacts
    phone={site.phone}
    address={site.address}
  />
  <MobileMenuDialog items={site.menu} />
</header>

<style>
  /* Keep the sticky header themed without a strip below mobile navigation. */
  .site-header {
    background-color: var(--color-base-100);
    background-color: color-mix(
      in srgb,
      var(--color-base-100) 94%,
      transparent
    );
    border-bottom: 0;
    box-shadow: none;
    backdrop-filter: blur(12px);
  }

  /* Wrap navigation within the shared header container. */
  .header-layout {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 0.5rem;
    min-height: 4rem;
    padding-block: 0.625rem;
  }

  /* Reserve contact controls for desktop while mobile has its own row. */
  .header-layout :global(.contact-menu) {
    display: none;
    flex: none;
  }

  @media (min-width: 48rem) and (hover: hover) and (pointer: fine) {
    .header-layout :global(.settings-trigger:hover .settings-surface),
    .header-layout :global([data-contact-menu-opener]:hover) {
      border-color: var(--color-primary);
      color: var(--color-primary-content);
      background: var(--color-primary);
    }
  }

  /* Show compact header controls from tablet width upward. */
  @media (min-width: 48rem) {
    .header-layout {
      min-height: 5rem;
    }

    .header-layout :global(.theme-settings),
    .header-layout :global([data-contact-menu-opener]) {
      width: 3.25rem;
      height: 3.25rem;
      min-height: 3.25rem;
    }

    .header-layout :global(.settings-trigger),
    .header-layout :global(.settings-surface),
    .header-layout :global(.contact-menu-opener) {
      width: 3.25rem;
      height: 3.25rem;
      min-height: 3.25rem;
    }

    .header-layout :global(.contact-menu) {
      display: block;
    }

    :global(.header-menu-wrap) {
      display: none;
    }
  }

  /* Reserve room for settings and the mobile opener on narrow screens. */
  @media (max-width: 47.999rem) {
    /* Keep compact controls at the end of the wrapping header row. */
    .header-layout {
      justify-content: flex-end;
      gap: 0.25rem 0.5rem;
    }

    /* Allow the brand column to contract beside the mobile controls. */
    :global(.header-brand-wrap) {
      flex: 1 1 8rem;
      min-width: 0;
      display: flex;
      justify-content: flex-start;
      margin-inline-end: auto;
    }

    /* Break long brand labels instead of forcing horizontal overflow. */
    :global(.header-brand) {
      overflow-wrap: anywhere;
    }
  }

  /* Give desktop controls room for the full address. */
  @media (min-width: 64rem) {
    /* Give desktop controls one aligned row above the separate navigation. */
    .header-layout {
      flex-wrap: nowrap;
    }
  }

  /* Animate scroll-driven visibility without changing document flow. */
  header {
    transition: transform 180ms ease;
  }

  /* Slide the header away on downward scrolling. */
  header[data-hidden="true"] {
    transform: translateY(-100%);
  }

  /* Keep keyboard focus visible above adjacent controls and surfaces. */
  header:focus-within,
  header[data-mobile-menu-open],
  header[data-contact-menu-open],
  header:has([data-settings-open]) {
    transform: translateY(0);
  }

  /* Respect the visitor preference for reduced interface motion. */
  @media (prefers-reduced-motion: reduce) {
    /* Switch header visibility immediately for reduced-motion visitors. */
    header {
      transition: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-auto-hide-header]");
  if (header) {
    const overlaySelector = "dialog[open], [data-settings-open]";
    const hasOpenOverlay = () =>
      header.hasAttribute("data-mobile-menu-open") ||
      header.hasAttribute("data-contact-menu-open") ||
      header.querySelector(overlaySelector) !== null;

    // Measure the rendered header so anchor targets clear it at any text size.
    const setClearance = () => {
      const firstRow = header.querySelector<HTMLElement>(".header-layout");
      document.documentElement.style.setProperty(
        "--site-header-clearance",
        `${header.offsetHeight + 16}px`,
      );
      document.documentElement.style.setProperty(
        "--site-header-first-row-height",
        `${firstRow?.offsetHeight ?? 64}px`,
      );
    };
    setClearance();
    new ResizeObserver(setClearance).observe(header);
    // Correct the initial anchor as soon as layout exists, without waiting for
    // remote images.
    const initialHash = location.hash;
    if (initialHash) {
      let interrupted = false;
      const interrupt = () => {
        interrupted = true;
      };
      const events = ["pointerdown", "wheel", "touchstart", "keydown"];
      events.forEach((event) =>
        window.addEventListener(event, interrupt, { passive: true }),
      );
      requestAnimationFrame(() => {
        if (!interrupted && location.hash === initialHash) {
          try {
            document
              .getElementById(decodeURIComponent(initialHash.slice(1)))
              ?.scrollIntoView();
          } catch {
            /* A malformed hash has no matching section. */
          }
        }
        events.forEach((event) => window.removeEventListener(event, interrupt));
      });
    }
    // Track accumulated direction changes to avoid jitter on tiny scrolls.
    let previousY = Math.max(0, window.scrollY);
    let distance = 0;
    let direction = 0;
    let scheduled = false;

    // Reset the travel threshold whenever an interaction needs the header.
    const reveal = () => {
      header.dataset.hidden = "false";
      distance = 0;
    };

    // Clamp overscroll and keep active header interactions on screen.
    const update = () => {
      scheduled = false;
      const maxY = Math.max(
        0,
        document.documentElement.scrollHeight - window.innerHeight,
      );
      const y = Math.min(maxY, Math.max(0, window.scrollY));
      const delta = y - previousY;
      previousY = y;

      if (
        y <= header.offsetHeight ||
        header.contains(document.activeElement) ||
        hasOpenOverlay()
      ) {
        reveal();
        return;
      }

      const nextDirection = Math.sign(delta);
      if (!nextDirection) return;
      if (nextDirection !== direction) distance = 0;
      direction = nextDirection;
      distance += Math.abs(delta);
      if (distance >= 12) {
        header.dataset.hidden = delta > 0 ? "true" : "false";
        distance = 0;
      }
    };

    // Coalesce passive scroll events into one layout update per frame.
    window.addEventListener(
      "scroll",
      () => {
        if (!scheduled) {
          scheduled = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    header.addEventListener("focusin", reveal);
    window.addEventListener("hashchange", reveal);
    window.addEventListener("pageshow", reveal);
    // Opening a drawer or settings panel overrides scroll-driven hiding.
    new MutationObserver(() => {
      if (hasOpenOverlay()) reveal();
    }).observe(header, {
      attributes: true,
      attributeFilter: [
        "open",
        "data-settings-open",
        "data-contact-menu-open",
        "data-mobile-menu-open",
      ],
      subtree: true,
    });
  }
</script>
