---
// src/components/Header.astro
import { site } from '@/content/site';
import { icons } from '@/content/icons';
import NavLinks from '@/components/ui/NavLinks.astro';
import MobileMenuDialog from '@/components/ui/MobileMenuDialog.astro';
import Settings from '@/components/ui/Settings.astro';
---

<header data-auto-hide-header class="sticky top-0 z-40 bg-base-100/80 backdrop-blur-md shadow-panel">
  <div class="navbar site-container">
    <div class="header-brand-wrap flex-1">
      <a href="/" class="header-brand text-2xl font-bold text-brand">{site.logoText}</a>
    </div>
    <NavLinks items={site.menu} variant="desktop" phone={site.phone} />
    <Settings />
    <div class="md:hidden">
      <button type="button" id="mobile-menu-open" class="btn btn-ghost btn-circle" aria-label="Открыть меню" aria-controls="mobile-menu" aria-expanded="false" aria-haspopup="dialog">
        <i class={`fas ${icons.menu.open} text-2xl`} aria-hidden="true"></i>
      </button>
    </div>
  </div>
  <MobileMenuDialog items={site.menu} phone={site.phone} />
</header>

<style>
  @media (max-width: 374px) { .header-brand { font-size: 1.125rem; } }
  @media (max-width: 767px) {
    .navbar { flex-wrap: wrap; justify-content: flex-end; }
    .header-brand-wrap { flex: 1 1 8rem; min-width: 0; }
    .header-brand { overflow-wrap: anywhere; }
  }
  header { transition: transform 180ms ease; }
  header[data-hidden='true'] { transform: translateY(-100%); }
  header:focus-within, header:has(dialog[open]), header:has([data-settings-open]) { transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) {
    header { transition: none; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-auto-hide-header]');
  if (header) {
    let previousY = Math.max(0, window.scrollY);
    let distance = 0;
    let direction = 0;
    let scheduled = false;

    const reveal = () => {
      header.dataset.hidden = 'false';
      distance = 0;
    };

    const update = () => {
      scheduled = false;
      const maxY = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
      const y = Math.min(maxY, Math.max(0, window.scrollY));
      const delta = y - previousY;
      previousY = y;

      if (y <= header.offsetHeight || header.contains(document.activeElement) || header.querySelector('dialog[open], [data-settings-open]')) {
        reveal();
        return;
      }

      const nextDirection = Math.sign(delta);
      if (!nextDirection) return;
      if (nextDirection !== direction) distance = 0;
      direction = nextDirection;
      distance += Math.abs(delta);
      if (distance >= 12) {
        header.dataset.hidden = delta > 0 ? 'true' : 'false';
        distance = 0;
      }
    };

    window.addEventListener('scroll', () => {
      if (!scheduled) {
        scheduled = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    header.addEventListener('focusin', reveal);
    window.addEventListener('hashchange', reveal);
    window.addEventListener('pageshow', reveal);
    new MutationObserver(() => {
      if (header.querySelector('dialog[open], [data-settings-open]')) reveal();
    }).observe(header, { attributes: true, attributeFilter: ['open', 'data-settings-open'], subtree: true });
  }
</script>
