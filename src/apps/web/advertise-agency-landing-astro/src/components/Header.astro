---
// src/components/Header.astro
import { site } from '@/content/site';
import { type MenuItem } from '@/types/site';
---

<header class="sticky top-0 z-40 bg-base-100 shadow-sm">
  <div class="navbar container mx-auto px-4">
    <!-- Левая часть: логотип -->
    <div class="flex-1">
      <a href="/" class="text-2xl font-bold text-primary">{site.logoText}</a>
    </div>

    <!-- Правая часть: десктопное меню -->
    <div class="hidden md:flex items-center gap-6">
      {site.menu.map((item: MenuItem) => (
        <a href={item.href} class="link link-hover">{item.label}</a>
      ))}
      <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="btn btn-outline btn-sm">{site.phone}</a>
    </div>

    <!-- Бургер-кнопка (только на мобильных) -->
    <div class="md:hidden">
      <label for="mobile-drawer" class="btn btn-ghost btn-circle">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </label>
    </div>
  </div>

  <!-- Мобильное меню (Drawer) -->
  <input type="checkbox" id="mobile-drawer" class="drawer-toggle" />
  <div class="drawer-side z-50">
    <label for="mobile-drawer" class="drawer-overlay"></label>
    <ul class="menu p-4 w-72 min-h-full bg-base-200 text-base-content gap-3">
      {site.menu.map((item: MenuItem) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
      <li>
        <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="btn btn-primary btn-block mt-4">Позвонить</a>
      </li>
    </ul>
  </div>
</header>