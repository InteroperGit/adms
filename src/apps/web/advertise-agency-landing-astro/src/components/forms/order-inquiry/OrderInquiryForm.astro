---
import type { OrderInquiryContent } from "@/types/orderInquiry";
import OrderInquiryFields from "./OrderInquiryFields.astro";

interface Props {
  content: OrderInquiryContent;
}

const { content } = Astro.props;
---

<div class="inquiry">
  <form
    class="inquiry-form"
    method="post"
    data-inquiry
    data-enabled={String(content.submission.enabled)}
    data-endpoint={content.submission.endpoint}
    data-timeout={content.submission.timeoutMs}
    data-feedback={JSON.stringify(content.feedback)}
    aria-describedby="inquiry-required inquiry-status"
  >
    <p
      id="inquiry-required"
      class="inquiry-note inquiry-required"
    >
      {content.requiredNote}
    </p>
    <OrderInquiryFields content={content} />
    <button
      class="btn btn-primary site-button inquiry-submit"
      type="submit"
      disabled
      aria-describedby="inquiry-status"
    >
      {content.submitLabel}
    </button>
    <p
      id="inquiry-status"
      class="inquiry-status"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    >
      {content.submission.enabled ? "" : content.feedback.unavailable}
    </p>
    <noscript>
      <p class="inquiry-note">{content.feedback.noJavaScript}</p>
    </noscript>
  </form>
</div>

<script>
  import { initializeInquiry } from "../orderInquiry";

  // Install the protected submit handler before controls become available.
  document
    .querySelectorAll<HTMLFormElement>("[data-inquiry]")
    .forEach(initializeInquiry);
</script>

<style>
  /* Bound the writing area so long labels cannot stretch the page. */
  .inquiry {
    max-width: 56rem;
    margin-inline: auto;
    overflow-wrap: anywhere;
  }

  /* Separate the form surface from surrounding section content. */
  .inquiry-form {
    min-width: 0;
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    border: 1px solid var(--color-base-300);
    border-radius: var(--radius-panel);
    background: var(--color-base-200);
    box-shadow: var(--shadow-panel);
  }

  /* Give the required-field note a clear start to the form. */
  .inquiry-required {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-base-300);
  }

  /* Keep the final action full width on narrow screens. */
  .inquiry-submit {
    width: 100%;
    max-width: 100%;
    height: auto;
    min-height: 3.25rem;
    padding: 0.875rem 1.5rem;
    white-space: normal;
    font-size: 1rem;
  }

  /* Disabled sending remains legible and visibly unavailable. */
  .inquiry-submit:disabled {
    background: var(--color-base-300);
    color: var(--color-base-content);
    border-color: var(--site-control-border);
    opacity: 1;
    box-shadow: none;
  }

  /* Delivery feedback remains a distinct part of the form footer. */
  .inquiry-status {
    min-height: 1.6em;
    padding: 1rem;
    border: 1px solid var(--color-base-300);
    border-radius: var(--radius-field);
    background: var(--color-base-100);
    color: var(--site-muted);
  }

  /* Empty live feedback reserves no visible panel. */
  .inquiry-status:empty {
    padding: 0;
    border: 0;
    background: transparent;
  }

  /* Align the desktop action with the form's left edge. */
  @media (min-width: 48rem) {
    /* Keep a stable action width on wider layouts. */
    .inquiry-submit {
      width: fit-content;
      min-width: 14rem;
    }
  }
</style>
