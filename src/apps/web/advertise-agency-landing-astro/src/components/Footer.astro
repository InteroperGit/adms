---
// Render shared legal navigation, contact details and the home brand link.
// Footer-local colors support a slate light footer and the dark theme.
// Content and destinations come from the validated site configuration.

import { site } from "@/content/site";
import { visibleServices } from "@/content/services";
import type { LegalItem } from "@/types";
import { ChevronDown } from "@lucide/astro";
import ContactInfo from "@/components/ui/ContactInfo.astro";
import Logo from "@/components/ui/Logo.astro";
import Link from "@/components/ui/Link.astro";

const agencyLinks = site.menu.filter((item) => item.href !== "/#services");
---

{/* Content and destinations come from the validated site configuration. */}
<footer class="site-footer border-t [overflow-wrap:anywhere]">
  <div class="site-container">
    <div class="footer-grid">
      <div class="footer-section min-w-0">
        <div class="footer-brand-row">
          <div class="footer-brand-copy">
            <Link
              href="/"
              class="footer-brand flex items-center gap-2 font-bold text-brand"
            >
              <Logo size="footer" />
              <span class="min-w-0">{site.logoText}</span>
            </Link>
            <p class="text-sm text-muted max-w-xs mt-2">
              {site.footer.description}
            </p>
          </div>
          <ul
            class="footer-socials"
            aria-label="Социальные сети и мессенджеры"
          >
            <li>
              <Link
                href="https://vk.com/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="ВКонтакте"
              >
                <img
                  src="/icons/social/vk.svg"
                  alt=""
                  width="24"
                  height="24"
                />
              </Link>
            </li>
            <li>
              <Link
                href="https://max.ru/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="MAX"
              >
                <img
                  src="/icons/social/max.svg"
                  alt=""
                  width="24"
                  height="24"
                />
              </Link>
            </li>
            <li>
              <Link
                href="https://t.me/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Telegram"
              >
                <img
                  src="/icons/social/telegram.svg"
                  alt=""
                  width="24"
                  height="24"
                />
              </Link>
            </li>
          </ul>
        </div>
      </div>
      <div class="footer-section">
        <hr class="footer-separator" />
        <details
          class="footer-group"
          data-footer-group
        >
          <summary class="footer-summary">
            <h2 class="text-base font-semibold">Услуги</h2>
            <ChevronDown
              class="footer-chevron"
              size={18}
              aria-hidden="true"
            />
          </summary>
          <nav
            class="min-w-0"
            aria-label="Услуги"
          >
            <ul class="footer-link-list space-y-1">
              {visibleServices.map((service) => (
                <li>
                  <Link
                    href={service.href}
                    class="footer-link"
                  >
                    {service.name}
                  </Link>
                </li>
              ))}
              {visibleServices.length > 0 && (
                <li>
                  <Link
                    href="/#services"
                    class="footer-link"
                  >
                    Все услуги
                  </Link>
                </li>
              )}
            </ul>
          </nav>
        </details>
      </div>
      <div class="footer-section">
        <hr class="footer-separator" />
        <details
          class="footer-group"
          data-footer-group
        >
          <summary class="footer-summary">
            <h2 class="text-base font-semibold">Агентство</h2>
            <ChevronDown
              class="footer-chevron"
              size={18}
              aria-hidden="true"
            />
          </summary>
          <nav
            class="min-w-0"
            aria-label="Агентство"
          >
            <ul class="footer-link-list space-y-1">
              {agencyLinks.map((item) => (
                <li>
                  <Link
                    href={item.href}
                    class="footer-link"
                  >
                    {item.label}
                  </Link>
                </li>
              ))}
            </ul>
          </nav>
        </details>
      </div>
      <div class="footer-section">
        <hr class="footer-separator" />
        <div class="min-w-0">
          <h2 class="text-base font-semibold mb-3">Контакты</h2>
          {/* Keep shared contact markup on the footer surface. */}
          <ContactInfo
            phone={site.phone}
            email={site.email}
            address={site.address}
            workHours={site.workHours}
            workHoursWeekend={site.workHoursWeekend}
            class="text-sm footer-contact-info"
          />
        </div>
      </div>
    </div>
    {/* End the shared footer with supplied copyright and the build year. */}
    <div class="footer-copyright border-t mt-10 pt-6 text-sm text-muted">
      <p class="footer-disclaimer">
        Информация на сайте носит справочный характер. Итоговая стоимость услуг
        уточняется после консультации менеджера.
      </p>
      <p>
        © {new Date().getFullYear()} {site.logoText}. {site.footer.copyright}.
      </p>
      <nav
        aria-label="Правовая информация"
        class="footer-legal"
      >
        <ul>
          {site.legal.map((item: LegalItem) => (
            <li>
              <Link
                href={item.href}
                class="footer-link"
              >
                {item.label}
              </Link>
            </li>
          ))}
          <li>
            <button
              type="button"
              class="footer-link footer-cookie-settings"
              data-cookie-settings-trigger
            >
              Настройки cookie
            </button>
          </li>
          <li>
            <Link
              href="/sitemap.xml"
              class="footer-link"
            >
              Карта сайта
            </Link>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</footer>

<script>
  // Use disclosures only where the footer switches to a mobile stack.
  const footerMobile = window.matchMedia("(max-width: 37.999rem)");
  const footerGroups = document.querySelectorAll<HTMLDetailsElement>(
    "[data-footer-group]",
  );

  const syncFooterGroups = () => {
    footerGroups.forEach((group) => {
      group.open = !footerMobile.matches;
      const summary = group.querySelector("summary");
      if (summary) {
        summary.tabIndex = footerMobile.matches ? 0 : -1;
      }
    });
  };

  footerGroups.forEach((group) => {
    group.querySelector("summary")?.addEventListener("click", (event) => {
      if (!footerMobile.matches) {
        event.preventDefault();
      }
    });
  });

  syncFooterGroups();
  footerMobile.addEventListener("change", syncFooterGroups);
</script>

<style>
  /* End light pages with brand slate and readable local foregrounds. */
  .site-footer {
    --site-section-space: clamp(1.5rem, 3vw, 2.5rem);
    --footer-background: #18222d;
    --footer-text: #edf2f7;
    --footer-muted: #bdc8d4;
    --footer-link: #ffa04d;
    --footer-divider: #354555;
    --footer-focus: var(--footer-link);
    padding-block: var(--site-section-space) 2rem;
    background: var(--footer-background);
    color: var(--footer-text);
    border-color: var(--footer-divider);
  }

  /* Retain the existing dark theme surface and divider. */
  :global([data-theme="dark"]) .site-footer {
    --footer-background: var(--color-base-200);
    --footer-divider: var(--color-base-300);
  }

  /* Follow system dark mode before scripts run and with JavaScript off. */
  @media (prefers-color-scheme: dark) {
    /* An explicit light preference takes priority over the system. */
    :global(:root:not([data-theme])) .site-footer {
      --footer-background: var(--color-base-200);
      --footer-divider: var(--color-base-300);
    }
  }

  /* Stack the existing content columns on smaller screens. */
  .footer-grid {
    display: grid;
    gap: 2rem;
  }

  /* Keep each footer column within its responsive grid track. */
  .footer-section {
    min-width: 0;
  }

  /* Use separators only where the columns become a mobile stack. */
  .footer-separator {
    display: none;
    width: 100%;
    margin: 0 0 0.25rem;
    border: 0;
    border-top: 1px solid var(--footer-divider);
  }

  /* Keep social controls grouped while allowing them to wrap when needed. */
  .footer-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  /* Give each social icon a stable touch target and clear focus boundary. */
  .footer-socials :global(a) {
    display: grid;
    width: 64px;
    height: 64px;
    place-items: center;
    padding: 0;
  }

  /* Let each local social mark fill most of its touch target. */
  .footer-socials img {
    width: 56px;
    height: 56px;
    transition: filter 160ms ease;
  }

  /* Brighten local social marks only on devices with a hover pointer. */
  @media (hover: hover) and (pointer: fine) {
    .footer-socials :global(a:hover) img {
      filter: brightness(1.22);
    }
  }

  /* Avoid decorative hover transitions when reduced motion is requested. */
  @media (prefers-reduced-motion: reduce) {
    .footer-socials img {
      transition: none;
    }

    .footer-group::details-content {
      transition: none;
    }
  }

  /* Align each expandable heading with its disclosure icon. */
  .footer-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    cursor: pointer;
    list-style: none;
  }

  /* Hide the browser marker so the same icon works across platforms. */
  .footer-summary::-webkit-details-marker {
    display: none;
  }

  /* Make keyboard focus on the disclosure heading visible in both themes. */
  .footer-summary:focus-visible {
    outline: 2px solid var(--footer-focus);
    outline-offset: 4px;
  }

  /* Indicate the native disclosure state with a restrained rotation. */
  .footer-chevron {
    flex: 0 0 auto;
    transition: transform 160ms ease;
  }

  /* Point the disclosure icon upward when its links are visible. */
  .footer-group[open] .footer-chevron {
    transform: rotate(180deg);
  }

  /* Keep footer contact rows evenly spaced and aligned across the column. */
  .site-footer :global(.footer-contact-info > div) {
    min-height: 56px;
  }

  /* Halve the shared vertical gap between footer contact rows. */
  .site-footer :global(.footer-contact-info > :not(:last-child)) {
    margin-block-end: 0.375rem;
  }

  /* Center larger social controls where the footer stacks into one column. */
  @media (max-width: 37.999rem) {
    /* Halve the total mobile gap from the footer edge to its brand. */
    .site-footer {
      padding-block-start: calc(var(--site-section-space) / 2 + 0.375rem);
    }

    /* Animate native list disclosures without changing their semantics. */
    .footer-group {
      interpolate-size: allow-keywords;
    }

    .footer-group::details-content {
      block-size: 0;
      overflow: clip;
      transition:
        block-size 220ms ease,
        content-visibility 220ms allow-discrete;
    }

    .footer-group[open]::details-content {
      block-size: auto;
    }

    /* Keep mobile section boundaries equally spaced in the vertical flow. */
    .footer-grid {
      gap: 0;
    }

    /* Give each stacked section the same breathing room. */
    .footer-section {
      padding-block: 0.25rem;
    }

    /* Match the logo offset to the distance below each mobile separator. */
    .footer-section:first-child {
      padding-top: 0.75rem;
      padding-bottom: 1.5rem;
    }

    /* Align the contact title below its rule like the other section titles. */
    .footer-section > div > h2 {
      display: flex;
      min-height: 44px;
      align-items: center;
      margin: 0 0 0.75rem;
    }

    /* Separate each navigation and contact section with a thin rule. */
    .footer-separator {
      display: block;
    }

    /* Center the social controls beneath the brand on mobile. */
    .footer-socials {
      justify-content: center;
    }

    /* Stack the copyright and its legal actions on narrow screens. */
    .site-footer .footer-copyright {
      align-items: flex-start;
      flex-direction: column;
    }

    .footer-legal {
      width: 100%;
    }

    /* Align wrapped legal actions with the copyright copy. */
    .footer-legal ul {
      width: 100%;
      align-items: flex-start;
      flex-direction: column;
      justify-content: flex-start;
    }

    .footer-legal li {
      width: 100%;
    }
  }

  /* Keep legal actions together at the right of the copyright row. */
  .footer-legal ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    justify-content: flex-end;
  }

  /* Let the cookie settings command match the neighboring legal links. */
  :global(.footer-cookie-settings) {
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--footer-link);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  /* Keep the home link and butterfly within the available width. */
  :global(.footer-brand) {
    width: fit-content;
    max-width: 100%;
    font-size: clamp(1.5rem, 2.5vw, 1.875rem);
  }

  /* Cover muted utilities inside the shared contact component too. */
  .site-footer :global(.text-muted) {
    color: var(--footer-muted);
  }

  /* Override inherited light-theme contact actions on the dark surface. */
  .site-footer :global(a:not(.footer-brand)) {
    color: var(--footer-link);
  }

  /* Keep footer contact links plain until the visitor hovers them. */
  .site-footer :global(.contact-action) {
    text-decoration: none;
  }

  /* Retain the contact underline as a clear pointer affordance. */
  .site-footer :global(.contact-action:hover) {
    text-decoration: underline;
    text-underline-offset: calc(0.2em + 1px);
  }

  /* Make keyboard focus visible independently of link and brand colors. */
  .site-footer :global(a:focus-visible) {
    outline: 2px solid var(--footer-focus);
    outline-offset: 4px;
  }

  /* Keep keyboard focus visible on the cookie settings action. */
  .site-footer :global(button:focus-visible) {
    outline: 2px solid var(--footer-focus);
    outline-offset: 4px;
  }

  /* Separate the copyright without introducing a light-theme border. */
  .footer-copyright {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    border-color: var(--footer-divider);
  }

  .footer-disclaimer {
    flex-basis: 100%;
  }

  /* Keep the legal row from forcing the copyright into a narrow measure. */
  .footer-legal {
    min-width: 0;
  }

  /* Retain the legal links' generous targets and underline affordance. */
  :global(.footer-link) {
    display: flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  /* Reinforce hover without changing the readable foreground. */
  :global(.footer-link:hover) {
    text-decoration: underline;
    text-underline-offset: calc(0.2em + 1px);
  }

  /* Give the brand, services, agency, and contacts clear columns. */
  @media (min-width: 64rem) {
    /* Center the brand group against the neighboring desktop columns. */
    .footer-section:first-child {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    /* Divide desktop footer columns with restrained theme-aware rules. */
    .footer-section + .footer-section {
      border-inline-start: 1px solid var(--footer-divider);
      padding-inline-start: 1.5rem;
    }

    /* Keep the services and agency navigation in one visual group. */
    .footer-grid > .footer-section:nth-child(3) {
      border-inline-start: 0;
      padding-inline-start: 0;
    }

    /* Keep navigation lists expanded on desktop. */
    .footer-group {
      align-self: start;
    }

    /* Preserve the grouped heading rhythm from the original footer. */
    .footer-summary {
      min-height: 0;
      align-items: flex-start;
      margin-bottom: 0.75rem;
    }

    /* Remove disclosure affordances when desktop lists stay expanded. */
    .footer-chevron {
      display: none;
    }

    /* Keep expanded desktop headings visually static. */
    .footer-summary {
      cursor: default;
    }

    /* Keep desktop sections aligned in one row. */
    .footer-grid {
      grid-template-columns: 1.1fr 1fr 1fr 1.2fr;
      gap: 3rem;
    }
  }

  /* Balance columns before the layout has room for the desktop arrangement. */
  @media (min-width: 38rem) and (max-width: 63.999rem) {
    /* Add breathing room below the footer's top rule on tablet. */
    .site-footer {
      --footer-tablet-divider-space: 1rem;
      --footer-tablet-content-inset: 1rem;
      padding-block-start: calc(var(--site-section-space) + 1rem);
    }

    /* Stack each tablet section while keeping its content compact. */
    .footer-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .footer-section {
      padding-block: 0;
    }

    .footer-section:first-child {
      padding-bottom: 0;
    }

    .footer-separator {
      display: block;
      margin-block: var(--footer-tablet-divider-space);
    }

    .footer-section:nth-child(2) > .footer-group,
    .footer-section:nth-child(3) > .footer-group,
    .footer-section:nth-child(4) > div {
      margin-inline-start: var(--footer-tablet-content-inset);
    }

    /* Keep brand copy left and social controls right in one row. */
    .footer-section:first-child {
      padding-block: 0;
    }

    .footer-brand-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }

    .footer-brand-copy {
      min-width: 0;
    }

    .footer-brand-copy p {
      margin-top: 0.5rem;
    }

    .footer-socials {
      flex: 0 0 auto;
      margin-top: 0;
    }

    /* Keep navigation lists open and split their contents into two columns. */
    .footer-group {
      align-self: start;
    }

    .footer-link-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.5rem;
    }

    .site-footer :global(.footer-contact-info) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.5rem;
    }

    .footer-link-list li,
    .footer-legal li {
      min-width: 0;
    }

    .site-footer :global(.footer-contact-info > div) {
      min-width: 0;
    }

    .site-footer :global(.footer-contact-info > :not(:first-child)) {
      margin-block-start: 0;
    }

    .site-footer :global(.footer-contact-info > :not(:last-child)) {
      margin-block-end: 0;
    }

    .footer-legal {
      width: 100%;
    }

    .footer-legal ul {
      display: flex;
      flex-wrap: nowrap;
      justify-content: space-between;
      gap: 0 0.75rem;
    }

    .footer-legal li {
      flex: 0 1 auto;
    }

    .footer-copyright {
      align-items: flex-start;
      flex-direction: column;
      margin-top: var(--footer-tablet-divider-space);
      padding-top: var(--footer-tablet-divider-space);
    }

    /* Preserve compact heading spacing inside each stacked section. */
    .footer-summary {
      min-height: 0;
      align-items: flex-start;
      margin-bottom: 0.75rem;
    }

    /* Keep tablet navigation lists expanded without disclosure affordances. */
    .footer-chevron {
      display: none;
    }

    /* Keep expanded tablet headings visually static. */
    .footer-summary {
      cursor: default;
    }
  }
</style>
