---
// src/components/Footer.astro
import { site } from '@/content/site';
import { icons } from '@/content/icons';
import type { LegalItem } from '@/types';
import ContactInfo from '@/components/ui/ContactInfo.astro';
---

<footer class="bg-gradient-to-b from-base-200 to-base-300 pt-16 pb-8">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
      <div class="flex flex-col items-center md:items-start text-center md:text-left">
        <h3 class="text-3xl font-bold text-primary">{site.logoText}</h3>
        <p class="text-sm text-base-content/70 max-w-xs mt-2">
          {site.footer.description}
        </p>
      </div>
      <div class="flex flex-col items-center md:items-start">
        <h4 class="text-sm font-semibold uppercase tracking-wider text-base-content/60 mb-3">
          Информация
        </h4>
        <ul class="space-y-2">
          {site.legal.map((item: LegalItem) => (
            <li>
              <a href={item.href} class="link link-hover text-sm">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="flex flex-col items-center md:items-start">
        <h4 class="text-sm font-semibold uppercase tracking-wider text-base-content/60 mb-3">
          Контакты
        </h4>
        <ContactInfo
          phone={site.phone}
          email={site.email}
          address={site.address}
          workHours={site.workHours}
          workHoursWeekend={site.workHoursWeekend}
          class="text-sm"
        />
      </div>
    </div>
    <div class="border-t border-base-content/20 mt-12 pt-6 text-center text-sm text-base-content/50">
      <p>
        © {new Date().getFullYear()} {site.logoText}. {site.footer.copyright}.
        <i class={`fas ${icons.butterfly} ml-1 text-primary`}></i>
      </p>
    </div>
  </div>
</footer>
