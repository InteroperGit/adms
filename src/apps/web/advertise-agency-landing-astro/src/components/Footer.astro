---
// src/components/Footer.astro
import { site } from '@/content/site';
import type { LegalItem } from '@/types';
import ContactInfo from '@/components/ui/ContactInfo.astro';
import Logo from '@/components/ui/Logo.astro';
---

<footer class="site-footer bg-base-200 border-t border-base-300 [overflow-wrap:anywhere]">
  <div class="site-container">
    <div class="footer-grid">
      <div class="min-w-0">
        <a href="/" class="footer-brand flex items-center gap-2 text-3xl font-bold text-brand"><Logo size="footer" /><span class="min-w-0">{site.logoText}</span></a>
        <p class="text-sm text-muted max-w-xs mt-2">
          {site.footer.description}
        </p>
      </div>
      <nav aria-label="Правовая информация" class="min-w-0">
        <h2 class="text-base font-semibold mb-3">
          Информация
        </h2>
        <ul class="space-y-1">
          {site.legal.map((item: LegalItem) => (
            <li>
              <a href={item.href} class="footer-link">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="min-w-0">
        <h2 class="text-base font-semibold mb-3">
          Контакты
        </h2>
        <ContactInfo
          phone={site.phone}
          email={site.email}
          address={site.address}
          workHours={site.workHours}
          workHoursWeekend={site.workHoursWeekend}
          class="text-sm"
        />
      </div>
    </div>
    <div class="border-t border-base-300 mt-10 pt-6 text-sm text-muted">
      <p>
        © {new Date().getFullYear()} {site.logoText}. {site.footer.copyright}.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding-block: var(--site-section-space) 2rem; }
  .footer-grid { display: grid; gap: 2rem; }
  .footer-brand { width: fit-content; max-width: 100%; font-size: clamp(1.5rem, 2.5vw, 1.875rem); }
  .footer-link { display: flex; align-items: center; min-height: 44px; color: var(--color-primary); text-decoration: underline; text-underline-offset: 0.2em; }
  .footer-link:hover { text-decoration-thickness: 2px; }
  @media (min-width: 64rem) { .footer-grid { grid-template-columns: 1fr 1fr 1.2fr; gap: 3rem; } }
</style>
