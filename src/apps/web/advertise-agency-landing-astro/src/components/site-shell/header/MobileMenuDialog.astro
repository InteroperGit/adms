---
// Render a full-height mobile navigation drawer below the first header row.
import NavLinks from "@/components/navigation/NavLinks.astro";
import type { MenuItem } from "@/types";

interface Props {
  items: MenuItem[];
}

const { items } = Astro.props;
---

<dialog
  id="mobile-menu"
  aria-label="Меню сайта"
  class="mobile-menu-dialog"
>
  <NavLinks
    items={items}
    variant="mobile"
  />
</dialog>

<style>
  /* Fill the viewport below the persistent first header row. */
  dialog {
    position: fixed;
    z-index: 50;
    inset: var(--site-header-first-row-height, 4rem) 0 0;
    width: auto;
    max-width: none;
    height: auto;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: 0;
    color: var(--color-base-content);
    background: var(--color-base-100);
    opacity: 0;
    transform: translateY(-0.5rem);
    transition:
      display 180ms allow-discrete,
      opacity 180ms ease,
      transform 180ms ease;
  }

  /* Keep the drawer scrollable while preserving full-height coverage. */
  dialog[open] {
    display: flex;
    flex-direction: column;
    opacity: 1;
    transform: translateY(0);
  }

  /* Animate the first rendered frame instead of flashing at full opacity. */
  @starting-style {
    dialog[open] {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }

  /* Respect reduced-motion preferences when the drawer changes state. */
  @media (prefers-reduced-motion: reduce) {
    /* Keep menu visibility immediate for reduced-motion visitors. */
    dialog {
      transition: none;
    }
  }
</style>

<script>
  const opener = document.querySelector<HTMLButtonElement>("#mobile-menu-open");
  const menu = document.querySelector<HTMLDialogElement>("#mobile-menu");
  const header = document.querySelector<HTMLElement>("[data-auto-hide-header]");

  if (menu && menu.parentElement !== document.body) {
    document.body.append(menu);
  }

  // Keep the header trigger available while the drawer is open and nonmodal.
  if (opener && menu) {
    let restoreOpenerFocus = true;

    // Close without stealing focus when an outside pointer action continues.
    const closeMenu = (restoreFocus = true) => {
      restoreOpenerFocus = restoreFocus;
      if (menu.open) {
        menu.close();
      }
    };

    // Synchronize the animated icon and header visibility with drawer state.
    const handleMenuClose = () => {
      opener.setAttribute("aria-expanded", "false");
      opener.setAttribute("aria-label", "Открыть меню");
      header?.removeAttribute("data-mobile-menu-open");
      if (restoreOpenerFocus) {
        opener.focus({ preventScroll: true });
      } else if (document.activeElement === opener) {
        opener.blur();
      }
      restoreOpenerFocus = true;
    };

    // Preserve native links and close before navigating to their destination.
    const handleMenuLinkClick = (
      event: MouseEvent,
      link: HTMLAnchorElement,
    ) => {
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) {
        return;
      }

      const destination = new URL(link.href);
      const samePageHash =
        destination.pathname === location.pathname && destination.hash;

      if (!samePageHash) {
        closeMenu(false);
        return;
      }

      event.preventDefault();
      history.pushState(null, "", destination.pathname + destination.hash);
      const sectionId = decodeURIComponent(destination.hash.slice(1));
      const section = document.getElementById(sectionId);

      if (section) {
        if (!section.hasAttribute("tabindex")) {
          section.setAttribute("tabindex", "-1");
          section.addEventListener(
            "blur",
            () => section.removeAttribute("tabindex"),
            { once: true },
          );
        }
        menu.addEventListener(
          "close",
          () => {
            section.focus({ preventScroll: true });
            section.scrollIntoView();
          },
          { once: true },
        );
        closeMenu(false);
        return;
      }

      closeMenu(true);
    };

    // Let the same header control open and close the nonmodal drawer.
    opener.addEventListener("click", (event: MouseEvent) => {
      if (menu.open) {
        closeMenu(event.detail === 0);
        return;
      }

      menu.show();
      opener.setAttribute("aria-expanded", "true");
      opener.setAttribute("aria-label", "Закрыть меню");
      header?.setAttribute("data-mobile-menu-open", "");
      menu.querySelector<HTMLAnchorElement>("a[href]")?.focus();
    });

    // Escape closes the nonmodal drawer and restores its opener focus.
    menu.addEventListener("keydown", (event: KeyboardEvent) => {
      if (event.key === "Escape") {
        event.preventDefault();
        closeMenu(true);
      }
    });

    // Outside pointer actions keep their native target and focus behavior.
    document.addEventListener("pointerdown", (event: PointerEvent) => {
      if (
        menu.open &&
        event.target instanceof Node &&
        !menu.contains(event.target) &&
        !opener.contains(event.target)
      ) {
        closeMenu(false);
      }
    });

    menu.addEventListener("close", handleMenuClose);
    menu.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((link) => {
      link.addEventListener("click", (event) => {
        handleMenuLinkClick(event, link);
      });
    });

    // Close if responsive layout removes the menu trigger from view.
    window.addEventListener("resize", () => {
      if (menu.open && opener.getClientRects().length === 0) {
        closeMenu(false);
      }
    });
  }
</script>
