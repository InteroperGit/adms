---
// Keep contact choices separate from the unavailable callback request.
import { site } from "@/content/site";
import { orderInquiry } from "@/content/orderInquiry";
import { MessageCircle, PhoneCall, Phone, X } from "@lucide/astro";
import Link from "@/components/ui/Link.astro";

interface Props {
  phone: string;
}

const { phone } = Astro.props;
const phoneHref = `tel:${phone.replace(/\s/g, "")}`;
const privacyPhrase = "политикой конфиденциальности";
const callbackConsentLabel = orderInquiry.consent.label.replace(
  privacyPhrase,
  "",
);
---

<div class="contact-menu">
  <button
    type="button"
    class="contact-menu-opener contact-menu-opener-desktop"
    data-contact-menu-opener
    aria-label={site.sections.contacts.panelTitle}
    aria-controls="contact-menu"
    aria-expanded="false"
  >
    <MessageCircle
      size={20}
      aria-hidden="true"
    />
  </button>
  <button
    type="button"
    class="contact-menu-opener contact-menu-opener-mobile"
    data-contact-menu-opener
    aria-label="Связаться"
    aria-controls="contact-menu"
    aria-expanded="false"
  >
    <span
      class="contact-menu-mark"
      aria-hidden="true"
    >
      <Phone
        class="contact-menu-phone"
        size={24}
      />
      <MessageCircle
        class="contact-menu-chat"
        size={12}
      />
    </span>
  </button>
  <dialog
    id="contact-menu"
    aria-label={site.sections.contacts.panelTitle}
  >
    <button
      type="button"
      class="contact-handle"
      data-contact-menu-close
      aria-label="Свернуть меню"
    ></button>
    <section data-contact-options>
      <h2>{site.sections.contacts.panelTitle}</h2>
      <Link
        underline={false}
        href={phoneHref}
        class="mobile-call-option"
      >
        <Phone
          size={20}
          aria-hidden="true"
        />
        Позвонить
      </Link>
      <button
        type="button"
        data-callback-start
      >
        <PhoneCall
          size={20}
          aria-hidden="true"
        />
        Обратный звонок
      </button>
      <Link
        underline={false}
        href="https://vk.com/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          src="/icons/social/vk.svg"
          alt=""
          width="24"
          height="24"
          loading="lazy"
        />
        ВКонтакте
      </Link>
      <Link
        underline={false}
        href="https://max.ru/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          src="/icons/social/max.svg"
          alt=""
          width="24"
          height="24"
          loading="lazy"
        />
        MAX
      </Link>
      <Link
        underline={false}
        href="https://t.me/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          src="/icons/social/telegram.svg"
          alt=""
          width="24"
          height="24"
          loading="lazy"
        />
        Telegram
      </Link>
    </section>
  </dialog>
  <dialog
    id="callback-dialog"
    class="callback-dialog"
    aria-labelledby="callback-title"
  >
    <section data-callback-form>
      <button
        type="button"
        class="callback-close"
        data-callback-close
        aria-label="Закрыть форму"
      >
        <X
          size={24}
          aria-hidden="true"
        />
      </button>
      <h2 id="callback-title">Обратный звонок</h2>
      <p>{orderInquiry.feedback.unavailable}</p>
      <form>
        <fieldset>
          <label for="callback-name">Имя</label>
          <input
            id="callback-name"
            name="name"
            autocomplete="name"
            required
          />
          <label for="callback-phone">Телефон</label>
          <input
            id="callback-phone"
            name="phone"
            type="tel"
            autocomplete="tel"
            required
          />
          <div class="callback-consent">
            <input
              type="checkbox"
              id="callback-consent"
              name="consent"
              required
              aria-labelledby="callback-consent-text"
            />
            <span id="callback-consent-text">
              <label for="callback-consent">{callbackConsentLabel}</label>
              <Link
                class="callback-consent-policy"
                href="/privacy-policy"
              >
                {privacyPhrase}
              </Link>
            </span>
          </div>
        </fieldset>
        <button
          class="callback-submit"
          type="submit"
          disabled
        >
          Отправить
        </button>
      </form>
    </section>
  </dialog>
</div>

<style>
  /* Keep the contact opener square and aligned with the shared controls. */
  .contact-menu-opener {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0;
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-field);
    color: var(--color-primary);
    background: var(--color-base-100);
    cursor: pointer;
  }

  /* Reserve the legacy chat button for tablet and desktop layouts. */
  .contact-menu-opener-desktop {
    display: none;
  }

  /* Keep the handset and conversation marks legible in one control. */
  .contact-menu-mark {
    position: relative;
    display: block;
    width: 1.625rem;
    height: 1.625rem;
  }

  /* Make the handset the dominant shape in the contact action. */
  .contact-menu-phone {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    width: 1.5rem;
    height: 1.5rem;
    stroke-width: 2.25;
  }

  /* Align the smaller chat mark with the handset's upper curve. */
  .contact-menu-chat {
    position: absolute;
    inset-inline-end: 0;
    inset-block-start: 0;
    width: 0.75rem;
    height: 0.75rem;
    padding: 1px;
    border-radius: 50%;
    background-color: var(--color-base-100);
    stroke-width: 2.5;
  }

  .contact-menu-opener:hover {
    border-color: var(--color-primary);
    color: var(--color-primary-content);
    background: var(--color-primary);
  }

  /* Keep keyboard focus visible across both panel layouts. */
  .contact-menu-opener:focus-visible,
  dialog :global(a:focus-visible),
  dialog button:focus-visible,
  dialog input:focus-visible {
    outline: var(--site-focus-ring);
    outline-offset: 3px;
  }

  /* Position desktop choices beside the opener using its measured anchor. */
  dialog {
    position: fixed;
    z-index: 50;
    inset: auto 1rem auto auto;
    width: min(24rem, calc(100vw - 2rem));
    max-width: none;
    max-height: min(80dvh, 42rem);
    margin: 0;
    padding: 1.25rem;
    overflow: auto;
    border: 1px solid var(--site-control-border);
    border-radius: var(--radius-field);
    color: var(--color-base-content);
    background: var(--color-base-100);
    box-shadow: var(--shadow-panel);
  }

  /* Keep the centered drag cue available only in the mobile sheet. */
  .contact-handle {
    display: none;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    touch-action: none;
  }

  .contact-handle:focus-visible {
    outline: var(--site-focus-ring);
  }

  .contact-handle::before {
    width: 2.5rem;
    height: 0.25rem;
    border-radius: 1rem;
    background: var(--color-base-300);
    content: "";
  }

  /* Stack four contact choices and separate each with a theme border. */
  [data-contact-options] {
    display: grid;
  }

  /* Give each panel title a compact heading scale. */
  [data-contact-options] h2,
  [data-callback-form] h2 {
    margin: 0 0 0.75rem;
    font-size: 1.125rem;
  }

  /* Keep actions easy to scan and large enough for touch input. */
  [data-contact-options] :global(a),
  [data-contact-options] button,
  [data-callback-form] > button,
  [data-callback-form] form > button {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.25rem;
    padding: 0.5rem;
    border: 0;
    border-top: 1px solid var(--color-base-300);
    color: inherit;
    background: transparent;
    text-align: start;
    text-decoration: none;
    cursor: pointer;
    font-size: 1.125rem;
  }

  [data-contact-options] :global(a:hover),
  [data-contact-options] button:hover,
  [data-callback-form] > button:hover,
  [data-callback-form] form > button:hover {
    color: var(--color-secondary-content);
    background: var(--color-secondary);
  }

  /* Keep local social marks aligned and prevent them from shrinking. */
  [data-contact-options] img {
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
  }

  /* Keep the direct-call action exclusive to the mobile contact sheet. */
  @media (min-width: 48rem) {
    /* Hide the phone-specific trigger and option on larger layouts. */
    .contact-menu-opener-mobile,
    [data-contact-options] .mobile-call-option {
      display: none;
    }

    /* Restore the original chat-only trigger on tablet and desktop. */
    .contact-menu-opener-desktop {
      display: grid;
    }
  }

  /* Group callback labels, fields and action in a readable form flow. */
  [data-callback-form] form {
    display: grid;
    gap: 0.75rem;
  }

  /* Keep editable callback fields aligned without a fieldset frame. */
  [data-callback-form] fieldset {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    border: 0;
  }

  /* Keep callback inputs large enough and allow their labels to wrap. */
  [data-callback-form] input:not([type="checkbox"]) {
    min-width: 0;
    width: 100%;
    min-height: 2.75rem;
    padding: 0.75rem;
    border: 1px solid var(--color-base-content);
    border-radius: var(--radius-field);
    background: var(--color-base-100);
    color: var(--color-base-content);
  }

  /* Keep the callback request in its own full-screen modal surface. */
  #callback-dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: max(1rem, env(safe-area-inset-top)) 1rem
      max(1rem, env(safe-area-inset-bottom));
    overflow: auto;
    border: 0;
    border-radius: 0;
    background: color-mix(in srgb, var(--color-base-content) 35%, transparent);
    transform: none;
  }

  /* Center the form within the full-screen overlay and preserve edge space. */
  #callback-dialog[open] {
    display: grid;
    place-items: center;
  }

  /* Separate the form from the dimmed page with a readable, padded surface. */
  #callback-dialog [data-callback-form] {
    position: relative;
    width: min(100%, 32rem);
    min-width: 0;
    padding: 1.5rem;
    border: 1px solid var(--color-base-300);
    border-radius: var(--radius-field);
    background: var(--color-base-100);
    box-shadow: var(--shadow-panel);
  }

  /* Set the callback heading apart from the form fields. */
  #callback-dialog #callback-title {
    margin: 0 0 1rem;
    padding-inline-end: 2.75rem;
    padding-block-end: 0.75rem;
    border-bottom: 2px solid
      color-mix(in srgb, var(--color-primary) 38%, transparent);
    color: var(--color-primary);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.25;
  }

  /* Present the unavailable notice as a distinct, readable status. */
  #callback-dialog [data-callback-form] > p {
    margin: 0 0 1rem;
    padding: 0.75rem;
    border-inline-start: 3px solid var(--color-accent);
    border-radius: 0 var(--radius-field) var(--radius-field) 0;
    background: color-mix(
      in srgb,
      var(--color-accent) 10%,
      var(--color-base-100)
    );
    color: var(--color-base-content);
    font-weight: 600;
  }

  /* Keep the icon-only dismissal target at the form's upper-right corner. */
  #callback-dialog .callback-close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    color: var(--color-base-content);
    background: transparent;
  }

  #callback-dialog .callback-close:hover {
    color: var(--color-primary);
    background: transparent;
  }

  #callback-dialog .callback-close:hover svg {
    stroke-width: 2.5;
  }

  /* Keep deferred submission prominent while retaining its disabled state. */
  #callback-dialog .callback-submit:disabled {
    justify-content: center;
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-field);
    background: var(--color-primary);
    color: var(--color-primary-content);
    font-weight: 600;
    cursor: not-allowed;
    opacity: 1;
  }

  /* Align the consent check with its wrapped text. */
  .callback-consent {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    align-items: start;
    gap: 0.5rem;
    padding-block: 0.5rem;
  }

  /* Keep the linked policy phrase inline with the consent sentence. */
  #callback-consent-text {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  /* Keep only the checkbox's lead-in text inside its native label. */
  #callback-consent-text label {
    display: inline;
  }

  /* Keep the policy destination recognizable in every link state. */
  #callback-consent-text :global(.callback-consent-policy),
  #callback-consent-text :global(.callback-consent-policy:hover),
  #callback-consent-text :global(.callback-consent-policy:visited),
  #callback-consent-text :global(.callback-consent-policy:focus-visible),
  #callback-consent-text :global(.callback-consent-policy:active) {
    color: var(--color-primary);
    text-decoration: underline;
  }

  /* Keep the checkbox itself a comfortable pointer target. */
  .callback-consent input {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
  }

  /* Use a full-width bottom sheet only in the mobile layout. */
  @media (max-width: 47.999rem) {
    dialog {
      inset: auto 0 0;
      width: 100%;
      height: auto;
      max-height: 70dvh;
      padding: 0.25rem 1rem 0.25rem;
      border: 0;
      border-radius: 0.5rem 0.5rem 0 0;
      transform: translateY(100%);
      transition: transform 180ms ease;
    }

    dialog[open] {
      display: flex;
      flex-direction: column;
      transform: translateY(0);
    }

    [data-contact-options] > h2 {
      display: none;
    }

    .contact-handle {
      display: grid;
      place-items: start center;
      width: 3rem;
      min-height: 2.75rem;
      flex: none;
      margin: 0 auto;
      padding-top: 0.25rem;
    }
  }

  /* Remove sheet motion when the visitor requests reduced motion. */
  @media (prefers-reduced-motion: reduce) {
    dialog {
      transition: none;
    }
  }

  /* Lock page scrolling while the modal mobile sheet is open. */
  :global(body:has(#contact-menu:modal, #callback-dialog:modal)) {
    overflow: hidden;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#contact-menu");
  const callbackDialog =
    document.querySelector<HTMLDialogElement>("#callback-dialog");
  const openers = document.querySelectorAll<HTMLElement>(
    "[data-contact-menu-opener]",
  );
  const options = dialog?.querySelector<HTMLElement>("[data-contact-options]");
  let openCallbackAfterClose = false;

  if (dialog && dialog.parentElement !== document.body) {
    document.body.append(dialog);
  }
  if (callbackDialog && callbackDialog.parentElement !== document.body) {
    document.body.append(callbackDialog);
  }

  if (dialog && callbackDialog && options && openers.length) {
    let activeOpener: HTMLElement | null = null;
    let swipeStartY: number | null = null;
    let suppressHandleClick = false;
    const close = () => dialog.close();
    const swipeCloseThreshold = 48;

    // Match the settings popup's vertical anchor on desktop and tablet.
    const placeDialog = () => {
      if (!activeOpener || !dialog.open) {
        return;
      }
      if (window.matchMedia("(max-width: 47.999rem)").matches) {
        dialog.style.removeProperty("top");
        dialog.style.removeProperty("right");
        return;
      }
      const anchor = activeOpener.getBoundingClientRect();
      const viewport = window.visualViewport;
      const viewportRight =
        (viewport?.offsetLeft ?? 0) + (viewport?.width ?? window.innerWidth);
      dialog.style.top = `${anchor.bottom + 8}px`;
      dialog.style.right = `${viewportRight - anchor.right}px`;
    };

    // Allow local input while delivery is deferred; never send a native GET.
    callbackDialog
      .querySelector("form")
      ?.addEventListener("submit", (event) => {
        event.preventDefault();
      });

    const handle = dialog.querySelector<HTMLElement>(
      "[data-contact-menu-close]",
    );
    handle?.addEventListener("pointerdown", (event: PointerEvent) => {
      if (
        event.pointerType === "touch" ||
        window.matchMedia("(max-width: 47.999rem)").matches
      ) {
        swipeStartY = event.clientY;
      }
    });
    window.addEventListener("pointerup", (event: PointerEvent) => {
      if (swipeStartY === null) {
        return;
      }
      const swipeDistance = event.clientY - swipeStartY;
      swipeStartY = null;
      if (Math.abs(swipeDistance) < swipeCloseThreshold) {
        return;
      }
      suppressHandleClick = handle?.contains(event.target as Node) ?? false;
      if (swipeDistance > 0) {
        close();
      }
    });
    window.addEventListener("pointercancel", () => {
      swipeStartY = null;
    });
    handle?.addEventListener("click", (event) => {
      if (suppressHandleClick) {
        suppressHandleClick = false;
        event.preventDefault();
        return;
      }
      close();
    });

    // Nonmodal desktop dialogs need an explicit Escape dismissal path.
    dialog.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        event.preventDefault();
        close();
      }
    });

    openers.forEach((opener) => {
      opener.addEventListener("click", (event) => {
        event.preventDefault();
        if (dialog.open && activeOpener === opener) {
          close();
          return;
        }
        activeOpener = opener;
        options.hidden = false;
        opener.setAttribute("aria-expanded", "true");
        document
          .querySelector("header")
          ?.setAttribute("data-contact-menu-open", "");
        if (window.matchMedia("(max-width: 47.999rem)").matches) {
          dialog.showModal();
        } else {
          dialog.show();
        }
        placeDialog();
      });
    });

    dialog
      .querySelector("[data-callback-start]")
      ?.addEventListener("click", () => {
        openCallbackAfterClose = true;
        close();
      });

    callbackDialog
      .querySelector("[data-callback-close]")
      ?.addEventListener("click", () => {
        callbackDialog.close();
      });

    dialog.addEventListener("click", (event) => {
      if (event.target !== dialog) {
        return;
      }
      const bounds = dialog.getBoundingClientRect();
      if (
        event.clientX < bounds.left ||
        event.clientX > bounds.right ||
        event.clientY < bounds.top ||
        event.clientY > bounds.bottom
      ) {
        close();
      }
    });

    document.addEventListener("pointerdown", (event) => {
      if (
        dialog.open &&
        !dialog.contains(event.target as Node) &&
        ![...openers].some((opener) => opener.contains(event.target as Node))
      ) {
        close();
      }
    });

    dialog.addEventListener("close", () => {
      document
        .querySelector("header")
        ?.removeAttribute("data-contact-menu-open");
      openers.forEach((opener) =>
        opener.setAttribute("aria-expanded", "false"),
      );
      if (openCallbackAfterClose) {
        openCallbackAfterClose = false;
        callbackDialog.showModal();
        callbackDialog
          .querySelector<HTMLElement>("[data-callback-close]")
          ?.focus();
        return;
      }
      activeOpener?.focus({ preventScroll: true });
    });

    callbackDialog.addEventListener("close", () => {
      activeOpener?.focus({ preventScroll: true });
    });
    window.addEventListener("resize", placeDialog);
    window.visualViewport?.addEventListener("resize", placeDialog);
    window.visualViewport?.addEventListener("scroll", placeDialog);
  }
</script>
