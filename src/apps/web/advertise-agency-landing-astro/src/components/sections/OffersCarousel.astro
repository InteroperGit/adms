---
import Button from '@/components/ui/Button.astro';
import { offers, enabledOffers } from '@/content/offers';
---

{offers.enabled && enabledOffers.length > 0 && (
  <section
    id="offers"
    class="offers-section"
    aria-label="Предложения"
    data-autoplay={offers.autoplay}
    data-interval={offers.intervalMs}
  >
    {enabledOffers.length > 1 && (
      <div class="offer-controls" hidden>
        <button
          type="button"
          class="offer-arrow"
          data-direction="-1"
          aria-label="Предыдущее предложение"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m14 6-6 6 6 6" />
          </svg>
        </button>
        <div class="offer-dots" role="group" aria-label="Выбор предложения">
          {enabledOffers.map((offer, index) => (
            <button
              type="button"
              class="offer-dot"
              data-index={index}
              aria-label={`Показать предложение ${index + 1}`}
              aria-controls={`offer-${offer.id}`}
            >
              <span aria-hidden="true"></span>
            </button>
          ))}
        </div>
        <button
          type="button"
          class="offer-arrow"
          data-direction="1"
          aria-label="Следующее предложение"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m10 6 6 6-6 6" />
          </svg>
        </button>
      </div>
    )}
    <div class="offers-list">
      {enabledOffers.map((offer, index) => {
        const { presentation } = offer;
        const { focalPoint } = presentation;
        const mobile = presentation.mobileFocalPoint ?? presentation.focalPoint;
        return (
          <article
            id={`offer-${offer.id}`}
            class="offer"
            aria-label={`Предложение ${index + 1} из ${enabledOffers.length}`}
            data-offer-id={offer.id}
            data-overlay={presentation.overlay}
            style={{
              '--description-size': `${presentation.fontSizeRem}rem`,
              '--description-color': presentation.textColor,
              '--focal-point': `${focalPoint.x}% ${focalPoint.y}%`,
              '--mobile-focal-point': `${mobile.x}% ${mobile.y}%`,
            }}
          >
            <img
              class="offer-background"
              src={offer.image}
              alt={offer.imageAlt}
              width={offer.imageWidth}
              height={offer.imageHeight}
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
            <div
              class="site-container offer-stage"
              data-horizontal={presentation.horizontal}
              data-vertical={presentation.vertical}
            >
              <div class="offer-copy">
                {offer.description.trim() && <p>{offer.description}</p>}
                <Button href={offer.href} class="offer-link">
                  {offer.linkLabel}
                </Button>
              </div>
            </div>
          </article>
        );
      })}
    </div>
    <span class="sr-only" role="status" aria-atomic="true"></span>
  </section>
)}

<script>
  const carousels = document.querySelectorAll<HTMLElement>('.offers-section');

  for (const carousel of carousels) {
    const slides = [...carousel.querySelectorAll<HTMLElement>('.offer')];
    const controls = carousel.querySelector<HTMLElement>('.offer-controls');
    const indicators = carousel.querySelector<HTMLElement>('.offer-dots');
    const status = carousel.querySelector<HTMLElement>('[role="status"]');
    const dots = [
      ...carousel.querySelectorAll<HTMLButtonElement>('.offer-dot'),
    ];
    const arrows = carousel.querySelectorAll<HTMLButtonElement>('.offer-arrow');

    if (slides.length < 2 || !controls || !indicators || !status
      || dots.length !== slides.length || arrows.length !== 2) continue;

    let currentSlide = 0;
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const interval = Number(carousel.dataset.interval);
    const autoplay = carousel.dataset.autoplay === 'true';
    let hovered = window.matchMedia('(hover: hover)').matches
      && carousel.matches(':hover');
    let inViewport = false;
    let suspended = false;
    let timer: ReturnType<typeof setTimeout> | undefined;

    const canRotate = () => autoplay && !motion.matches && !hovered
      && !document.hidden && inViewport && !suspended
      && !carousel.contains(document.activeElement);

    // Clear before scheduling: every resume gets one fresh full interval.
    const reconcileRotation = () => {
      clearTimeout(timer);
      timer = undefined;
      if (!canRotate()) return;
      timer = setTimeout(() => {
        timer = undefined;
        if (canRotate()) selectSlide(currentSlide + 1);
        reconcileRotation();
      }, interval);
    };

    const selectSlide = (index: number, announce = false) => {
      currentSlide = (index + slides.length) % slides.length;
      slides.forEach((slide, position) => {
        const inactive = position !== currentSlide;
        if (inactive) slide.setAttribute('aria-hidden', 'true');
        else slide.removeAttribute('aria-hidden');
        slide.inert = inactive;
      });
      dots.forEach((dot, position) => {
        if (position === currentSlide) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      if (announce) {
        status.textContent =
          `Предложение ${currentSlide + 1} из ${slides.length}`;
      }
    };

    arrows.forEach((arrow) => {
      arrow.addEventListener('click', () => {
        selectSlide(currentSlide + Number(arrow.dataset.direction), true);
        reconcileRotation();
      });
    });
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        selectSlide(index, true);
        reconcileRotation();
      });
    });

    carousel.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'touch') return;
      hovered = true;
      reconcileRotation();
    });
    carousel.addEventListener('pointerleave', () => {
      hovered = false;
      reconcileRotation();
    });
    carousel.addEventListener('focusin', reconcileRotation);
    carousel.addEventListener('focusout', () => {
      queueMicrotask(reconcileRotation);
    });
    document.addEventListener('visibilitychange', reconcileRotation);
    motion.addEventListener('change', reconcileRotation);
    new IntersectionObserver(([entry]) => {
      inViewport = entry.isIntersecting;
      reconcileRotation();
    }).observe(carousel);
    window.addEventListener('pagehide', () => {
      suspended = true;
      reconcileRotation();
    });
    window.addEventListener('pageshow', () => {
      suspended = false;
      reconcileRotation();
    });

    selectSlide(0);
    carousel.dataset.ready = 'true';
    carousel.setAttribute('aria-roledescription', 'карусель');
    controls.hidden = false;
    reconcileRotation();

    // Reserve bottom clearance even when indicators wrap or text is enlarged.
    const reserveIndicators = () => {
      carousel.style.setProperty(
        '--indicator-height', `${indicators.getBoundingClientRect().height}px`,
      );
    };
    reserveIndicators();
    new ResizeObserver(reserveIndicators).observe(indicators);
  }
</script>

<style>
  /* Anchor overlaid controls and share their spacing with slide content. */
  .offers-section {
    position: relative;
    --arrow-size: clamp(44px, 4vw, 56px);
    --control-inset: clamp(0.5rem, 2vw, 1.5rem);
    --control-gap: clamp(12px, 1rem, 20px);
  }

  /* Stack enabled offers in editorial order. */
  .offers-list {
    display: grid;
  }

  /* Share one grid track so the tallest slide reserves rotation height. */
  .offers-section[data-ready] .offer {
    grid-area: 1 / 1;
  }

  /* Reserve hidden slide geometry without exposing content or links. */
  .offers-section[data-ready] .offer[aria-hidden='true'] {
    visibility: hidden;
    pointer-events: none;
  }

  /* Overlay navigation without blocking pointer access to the slide. */
  .offer-controls {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    color: var(--color-base-content);
  }

  /* Reveal navigation only when the script has initialized all slides. */
  .offer-controls[hidden] {
    display: none;
  }

  /* Wrap a long offer list while preserving generous dot targets. */
  .offer-dots {
    position: absolute;
    bottom: var(--control-inset);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    width: max-content;
    max-width: calc(100% - 2 * var(--control-inset));
    pointer-events: auto;
  }

  /* Make arrows and dots comfortably reachable with pointer or touch. */
  .offer-arrow,
  .offer-dot {
    display: grid;
    place-items: center;
    width: var(--arrow-size);
    height: var(--arrow-size);
    flex: 0 0 auto;
    padding: 0;
    border-radius: 50%;
    color: inherit;
    cursor: pointer;
  }

  /* Center circular arrows at the edges with a solid image-independent base. */
  .offer-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: var(--color-base-100);
    border: 1px solid var(--site-control-border);
    pointer-events: auto;
  }

  /* Leave only the marker visible within each generous indicator target. */
  .offer-dot {
    background: transparent;
    border: 0;
    color: #fff;
  }

  /* Place previous navigation inside the left image edge. */
  .offer-arrow[data-direction='-1'] {
    left: var(--control-inset);
  }

  /* Place next navigation inside the right image edge. */
  .offer-arrow[data-direction='1'] {
    right: var(--control-inset);
  }

  /* Hide mouse arrows without removing their keyboard destinations. */
  @media (hover: hover) and (pointer: fine) {
    /* Fade hidden arrows while preventing invisible pointer activation. */
    .offer-arrow {
      opacity: 0;
      pointer-events: none;
      transition: opacity 180ms ease;
    }

    /* Reveal controls for pointer presence and native keyboard focus. */
    .offers-section:hover .offer-arrow,
    .offers-section:focus-within .offer-arrow {
      opacity: 1;
      pointer-events: auto;
    }
  }

  /* Remove hover reveal motion when the visitor requests reduced motion. */
  @media (prefers-reduced-motion: reduce) {
    /* Switch arrow visibility immediately while preserving navigation. */
    .offer-arrow {
      transition: none;
    }
  }

  /* Draw local directional icons with strong contrast. */
  .offer-arrow svg {
    width: min(1.5rem, 28px);
    height: min(1.5rem, 28px);
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Draw a circular position marker inside each generous target. */
  .offer-dot span {
    width: 0.75rem;
    height: 0.75rem;
    border: 2px solid currentColor;
    border-radius: 50%;
    filter: drop-shadow(0 0 1px #000) drop-shadow(0 0 1px #000);
  }

  /* Fill the current marker without changing any circle's radius. */
  .offer-dot[aria-current] span {
    background: currentColor;
  }

  /* Give pointer feedback without moving controls. */
  .offer-arrow:hover {
    background: var(--color-base-200);
  }

  /* Keep focus readable over bright and dark image areas. */
  .offer-arrow:focus-visible,
  .offer-dot:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
    box-shadow: 0 0 0 8px #000;
  }

  /* Fade manually selected content only when motion is welcome. */
  @media (prefers-reduced-motion: no-preference) {
    /* Animate only visible slides and preserve their layout geometry. */
    .offers-section[data-ready] .offer:not([aria-hidden]) {
      animation: offer-reveal 160ms ease-out;
    }
  }

  @keyframes offer-reveal {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  /* Reserve slide geometry and provide the dark image fallback. */
  .offer {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: clamp(23rem, 36vw, 34rem);
    background: #000;
    --description-backing: rgb(0 0 0 / 25%);
  }

  /* Use a light fallback and description backing for light presentation. */
  .offer[data-overlay='light'] {
    background: #fff;
    --description-backing: rgb(255 255 255 / 25%);
  }

  /* Cover the slide with the configured image crop. */
  .offer-background {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focal-point);
  }

  /* Align content to site gutters with breathing room around copy. */
  .offer-stage {
    display: grid;
    min-width: 0;
    min-height: inherit;
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(4.5rem, 6vw, 5.5rem);
  }

  /* Reserve arrow and dot clearance in every copy alignment after setup. */
  .offers-section[data-ready] .offer-stage {
    padding-inline: max(
      var(--site-gutter),
      calc(var(--control-inset) + var(--arrow-size) + var(--control-gap))
    );
    padding-bottom: max(
      4.5rem,
      calc(var(--indicator-height) + var(--control-inset) + var(--control-gap))
    );
  }

  /* Place the copy at the left edge of the content area. */
  .offer-stage[data-horizontal='left'] {
    justify-items: start;
  }

  /* Center the copy within the content area. */
  .offer-stage[data-horizontal='center'] {
    justify-items: center;
  }

  /* Place the copy at the right edge of the content area. */
  .offer-stage[data-horizontal='right'] {
    justify-items: end;
  }

  /* Position copy near the top when there is spare slide height. */
  .offer-stage[data-vertical='top'] {
    align-items: start;
  }

  /* Center copy vertically when there is spare slide height. */
  .offer-stage[data-vertical='center'] {
    align-items: center;
  }

  /* Position copy near the bottom when there is spare slide height. */
  .offer-stage[data-vertical='bottom'] {
    align-items: end;
  }

  /* Limit reading width and wrap long text without a surrounding panel. */
  .offer-copy {
    width: min(100%, 36rem);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  /* Center text for the centered presentation. */
  .offer-stage[data-horizontal='center'] .offer-copy {
    text-align: center;
  }

  /* Right-align text for the right presentation. */
  .offer-stage[data-horizontal='right'] .offer-copy {
    text-align: right;
  }

  /* Back nonempty descriptions with a 25% opaque rectangle. */
  .offer-copy p {
    margin: 0;
    padding: 1rem 1.25rem;
    background: var(--description-backing);
    color: var(--description-color);
    font-size: var(--description-size);
    line-height: 1.55;
  }

  /* Keep the CTA readable and allow long labels to wrap. */
  .offer-copy :global(.offer-link) {
    max-width: 100%;
    min-height: 3rem;
    height: auto;
    padding-block: 0.75rem;
    white-space: normal;
    overflow-wrap: anywhere;
    text-align: center;
    background: #b2380a;
    color: #fff;
    border-color: #b2380a;
  }

  /* Separate the CTA from a rendered description; empty text adds no gap. */
  .offer-copy p + :global(.offer-link) {
    margin-top: 1.25rem;
  }

  /* Darken the CTA to indicate pointer hover. */
  .offer-copy :global(.offer-link:hover) {
    background: #8f2d08;
    border-color: #8f2d08;
  }

  /* Keep keyboard focus visible over both bright and dark photographs. */
  .offer-copy :global(.offer-link:focus-visible) {
    outline: 3px solid #fff;
    outline-offset: 3px;
    box-shadow: 0 0 0 8px #000;
  }

  /* Adapt image cropping and reading width for mobile screens. */
  @media (max-width: 47rem) {
    /* Keep enough image height for narrow screens. */
    .offer {
      min-height: 25rem;
    }

    /* Apply the mobile focal-point override to the image. */
    .offer-background {
      object-position: var(--mobile-focal-point);
    }

    /* Use the available content width on mobile. */
    .offer-copy {
      width: 100%;
    }
  }

  /* Keep wide, short screens from reserving excessive vertical space. */
  @media (max-height: 30rem) and (min-width: 47.01rem) {
    /* Reduce reserved height in short landscape viewports. */
    .offer {
      min-height: 20rem;
    }
  }
</style>
