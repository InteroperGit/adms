---
import type { OrderingProcessStep as StepData } from "@/types/orderingProcess";
import OrderingResponsibilities from "./OrderingResponsibilities.astro";

interface Props {
  step: StepData;
  number: number;
}

const { step, number } = Astro.props;
const headingId = `${step.id}-heading`;
---

<li class="ordering-step">
  <article
    class="ordering-card"
    tabindex="0"
    aria-labelledby={headingId}
  >
    <span
      class="ordering-icon"
      style={{ "--ordering-icon": `url(${step.icon})` }}
      aria-hidden="true"
    ></span>
    <p
      class="ordering-step-number"
      aria-hidden="true"
    >
      {String(number).padStart(2, "0")}
    </p>
    <h3 id={headingId}>{step.title}</h3>
    <p class="ordering-description">{step.description}</p>
    <OrderingResponsibilities
      customerProvides={step.customerProvides}
      agencyHandles={step.agencyHandles}
    />
  </article>
</li>

<style>
  /* Keep each step's content inside one stable reading unit. */
  .ordering-step {
    min-width: 0;
  }

  /* Separate cards from the section surface while preserving theme tokens. */
  .ordering-card {
    height: 100%;
    padding: 1.25rem;
    border: 1px solid var(--site-control-border);
    border-radius: var(--radius-panel);
    background: var(--color-base-100);
    box-shadow: var(--shadow-panel);
    overflow-wrap: anywhere;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  /* Match keyboard focus to the established card emphasis. */
  .ordering-card:focus {
    border-color: var(--color-primary);
    background: color-mix(
      in srgb,
      var(--color-primary) 8%,
      var(--color-base-100)
    );
    box-shadow: inset 0 0 0 1px var(--color-primary);
  }

  /* Keep keyboard location distinct from the focused card surface. */
  .ordering-card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
  }

  /* Highlight hover without moving surrounding content. */
  .ordering-card:hover {
    border-color: var(--color-primary);
    background: color-mix(
      in srgb,
      var(--color-primary) 8%,
      var(--color-base-100)
    );
    box-shadow: inset 0 0 0 1px var(--color-primary);
  }

  /* Respect motion preferences while keeping feedback immediate. */
  @media (prefers-reduced-motion: reduce) {
    /* Remove the transition without removing focus or hover indication. */
    .ordering-card {
      transition: none;
    }
  }

  /* Keep the number visible without changing ordered-list semantics. */
  .ordering-step-number {
    margin: 0 0 0.5rem;
    color: var(--color-primary);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  /* Align each decorative mark with the step's heading. */
  .ordering-icon {
    display: block;
    width: 3rem;
    height: 3rem;
    margin-bottom: 0.75rem;
    background: var(--color-primary);
    -webkit-mask: var(--ordering-icon) center / contain no-repeat;
    mask: var(--ordering-icon) center / contain no-repeat;
  }

  /* Give each step a clear heading that anchors its article. */
  .ordering-card h3 {
    font-size: 1.375rem;
    font-weight: 700;
  }

  /* Keep the step explanation distinct from responsibility lists. */
  .ordering-description {
    margin-top: 0.75rem;
    color: var(--site-muted);
  }
</style>
