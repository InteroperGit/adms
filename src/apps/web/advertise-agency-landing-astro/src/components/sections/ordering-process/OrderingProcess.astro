---
// Explain the draft customer journey as a static, accessible sequence.
// The content contract keeps agency approval and open inputs explicit.
// The section has no browser behavior, so it remains available without JS.

import Button from "@/components/ui/Button.astro";
import CardCarousel from "../../ui/carousel/card-carousel/CardCarousel.astro";
import { orderingProcess } from "@/content/orderingProcess";
import OrderingStep from "./OrderingStep.astro";
---

<section
  id="ordering-process"
  class="site-section ordering-process"
  aria-labelledby="ordering-process-heading"
>
  <div class="site-container">
    {/* Keep the sequence introduction separate from its ordered list. */}
    <div class="ordering-introduction">
      <h2
        id="ordering-process-heading"
        class="site-section-title"
      >
        {orderingProcess.heading}
      </h2>
      <p class="site-section-subtitle ordering-summary">
        {orderingProcess.introduction}
      </p>
    </div>

    {/* Keep native list semantics inside the horizontal process carousel. */}
    <CardCarousel
      Item={OrderingStep}
      items={orderingProcess.steps.map((step, index) => ({
        step,
        number: index + 1,
      }))}
      label="Как проходит заказ"
      ordered
    />

    {/* Keep the next action adjacent to the final process explanation. */}
    <div class="ordering-action">
      <Button
        href="/#order-inquiry"
        size="lg"
      >
        Обсудить задачу
      </Button>
    </div>
  </div>
</section>

<style>
  /* Keep the heading readable above the five process cards. */
  .ordering-introduction {
    max-width: 60ch;
    margin-inline: auto;
    margin-bottom: 2rem;
    text-align: center;
    overflow-wrap: anywhere;
  }

  /* Keep the process introduction distinct from the card details. */
  .ordering-summary {
    margin-bottom: 0;
  }

  /* Show one full mobile card and a preview of the next step. */
  .ordering-process :global(.card-carousel-list > li) {
    box-sizing: border-box;
    flex: 0 0 calc(100% / 1.2);
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  /* Align the end of the carousel with the final process card. */
  .ordering-process :global(.card-carousel-list > li:last-child) {
    scroll-snap-align: end;
  }

  /* Keep the inquiry action aligned with the section's reading container. */
  .ordering-action {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  /* Show two full tablet cards and a preview of the following step. */
  @media (min-width: 48rem) {
    .ordering-process :global(.card-carousel-list > li) {
      flex-basis: calc((100% - 1rem) / 2.2);
    }
  }

  /* Show three full desktop cards and a preview of the following step. */
  @media (min-width: 75rem) {
    .ordering-process :global(.card-carousel-list > li) {
      flex-basis: calc((100% - 2rem) / 3.2);
    }
  }
</style>
