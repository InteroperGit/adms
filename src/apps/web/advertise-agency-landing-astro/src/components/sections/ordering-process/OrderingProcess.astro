---
// Explain the draft customer journey as a static, accessible sequence.
// The content contract keeps agency approval and open inputs explicit.
// The section has no browser behavior, so it remains available without JS.

import Button from "@/components/ui/Button.astro";
import Section from "@/components/ui/Section.astro";
import CardCarousel from "../../ui/carousel/card-carousel/CardCarousel.astro";
import { orderingProcess } from "@/content/orderingProcess";
import OrderingStep from "./OrderingStep.astro";
---

<Section
  id="ordering-process"
  title={orderingProcess.heading}
  subtitle={orderingProcess.introduction}
  headingClass="ordering-introduction"
  background="none"
  class="ordering-process"
>
  {/* Keep native list semantics inside the horizontal process carousel. */}
  <CardCarousel
    Item={OrderingStep}
    items={orderingProcess.steps.map((step, index) => ({
      step,
      number: index + 1,
    }))}
    label="Как проходит заказ"
    ordered
  />

  {/* Keep the next action adjacent to the final process explanation. */}
  <div
    slot="action"
    class="ordering-action"
  >
    <Button
      href="/#order-inquiry"
      size="lg"
    >
      Обсудить задачу
    </Button>
  </div>
</Section>

<style>
  /* Keep the heading readable above the five process cards. */
  :global(.ordering-introduction) {
    max-width: 60ch;
    margin-inline: auto;
    margin-bottom: 2rem;
    text-align: center;
    overflow-wrap: anywhere;
  }

  /* Keep the process introduction distinct from the card details. */
  :global(.ordering-introduction .site-section-subtitle) {
    margin-bottom: 0;
  }

  /* Show one full mobile card and a preview of the next step. */
  :global(.ordering-process .card-carousel-list > li) {
    box-sizing: border-box;
    flex: 0 0 calc(100% / 1.2);
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  /* Align the end of the carousel with the final process card. */
  :global(.ordering-process .card-carousel-list > li:last-child) {
    scroll-snap-align: end;
  }

  /* Keep the inquiry action aligned with the section's reading container. */
  .ordering-action {
    display: flex;
    justify-content: center;
    margin-top: var(--site-section-action-space);
  }

  /* Show one full tablet card and a larger preview of the next step. */
  @media (min-width: 48rem) {
    :global(.ordering-process .card-carousel-list > li) {
      flex-basis: calc((100% - 1rem) / 1.8);
    }
  }

  /* Show two full desktop cards and a preview of the next step. */
  @media (min-width: 75rem) {
    :global(.ordering-process .card-carousel-list > li) {
      flex-basis: calc((100% - 2rem) / 2.5);
    }
  }
</style>
