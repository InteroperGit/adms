---
// Present validated solutions for four business types without client code.
// Optional attribution and media render only when supplied with evidence.

import Button from '@/components/ui/Button.astro';
import ImageCarousel from '@/components/ui/ImageCarousel.astro';
import Section from '@/components/ui/Section.astro';
import { businessSolutions } from '@/content/business-solutions';
---

{/* Keep the business types in the editorial order from the content source. */}
<Section
  id="business-solutions"
  title={businessSolutions.heading}
  ariaLabel={businessSolutions.heading}
>
  <div class="solutions-introduction">
    <p>{businessSolutions.introduction}</p>
  </div>
  <div class="solutions-list">
    {businessSolutions.items.map((item) => (
        <article
          class="solution-item"
          aria-labelledby={`solution-${item.id}`}
        >
        <div class="solution-heading">
          <h3 id={`solution-${item.id}`}>{item.title}</h3>
          <p class="solution-summary">{item.summary}</p>
        </div>
        {/*
          Pair each business type with contextual, rights-recorded media.
        */}
        <figure class="solution-gallery">
          <ImageCarousel
            id={`business-solutions-${item.id}`}
            label={item.carousel.itemLabel}
            itemLabel={item.carousel.itemLabel}
            items={item.carousel.items}
            options={item.carousel.options}
          />
          <figcaption>
            {item.carousel.mediaSource} {item.carousel.mediaRights}
          </figcaption>
        </figure>
        <div class="solution-copy">
          <div>
            <h4>Задача клиента</h4>
            <p>{item.customerTask}</p>
          </div>
          <div>
            <h4>Подходящее решение</h4>
            <p>{item.solution}</p>
          </div>
          <div>
            <h4>{item.example.title}</h4>
            <p>{item.example.text}</p>
          </div>
        </div>
        {/* Omit attribution unless complete evidence metadata is available. */}
        {item.attribution.customerName && item.attribution.evidence && (
          <div class="solution-attribution">
            <p>
              Реализовано для: {item.attribution.customerName}.
              {' '}{item.attribution.evidence}
            </p>
            {item.attribution.href && (
              <a href={item.attribution.href}>
                Смотреть проект
              </a>
            )}
          </div>
        )}
        <Button
          href={item.inquiryHref}
          variant="outline"
          class="solution-inquiry"
          aria-label={item.inquiryLabel}
        >
          {item.inquiryLabel}
        </Button>
      </article>
    ))}
  </div>
</Section>

<style>
  /* Keep the opening copy readable and aligned with the solution cards. */
  .solutions-introduction {
    max-width: var(--site-reading-width);
    margin: 0 auto 2.5rem;
    color: var(--site-muted);
    overflow-wrap: anywhere;
  }

  /* Stack each business type so its complete example stays together. */
  .solutions-list {
    display: grid;
    gap: 2rem;
  }

  /* Use a bordered panel to separate long, content-driven examples. */
  .solution-item {
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--site-control-border);
    border-radius: var(--radius-box);
    background: var(--color-base-100);
    overflow-wrap: anywhere;
  }

  /* Keep the category name and its summary visually grouped. */
  .solution-heading h3 {
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    font-weight: 700;
  }

  /* Treat the summary as supporting context while retaining contrast. */
  .solution-summary {
    margin-top: 0.5rem;
    color: var(--site-muted);
    line-height: 1.6;
  }

  /* Keep the contextual gallery inside the same content-driven panel. */
  .solution-gallery {
    min-width: 0;
    margin: 1.5rem 0 0;
  }

  /* Keep media corners aligned with the surrounding solution panel. */
  .solution-gallery :global(.image-carousel) {
    overflow: hidden;
    border-radius: var(--radius-field);
  }

  /* Expose provenance without presenting contextual media as project proof. */
  .solution-gallery figcaption {
    margin-top: 0.75rem;
    color: var(--site-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  /* Let each labelled paragraph expand naturally at every text size. */
  .solution-copy {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  /* Make the short labels easy to scan above their complete copy. */
  .solution-copy h4 {
    font-size: 1.05rem;
    font-weight: 700;
  }

  /* Preserve readable separation between labels and wrapped paragraphs. */
  .solution-copy p {
    margin-top: 0.4rem;
    color: var(--site-muted);
    line-height: 1.65;
  }

  /* Keep verified customer evidence distinct from reusable category copy. */
  .solution-attribution {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--site-control-border);
    color: var(--site-muted);
  }

  /* Retain a visible cue for an available project evidence link. */
  .solution-attribution a {
    display: inline-block;
    margin-top: 0.5rem;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Keep the inquiry action reachable and wrapping at enlarged text sizes. */
  .solution-inquiry {
    max-width: 100%;
    height: auto;
    min-height: 2.75rem;
    margin-top: 1.5rem;
    padding-block: 0.7rem;
    white-space: normal;
  }

  /* Place labelled copy in columns only when each column remains readable. */
  @media (min-width: 48rem) {
    .solution-copy {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }
</style>
