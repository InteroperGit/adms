---
// Render current company reviews from the configured Yandex Maps profile.
// The provider owns review content, ratings and moderation.

import Section from '@/components/ui/Section.astro';
import YandexReviews from '@/components/ui/YandexReviews.astro';
import { site } from '@/content/site';
---

{/* Section copy and Yandex settings come from site configuration. */}
<Section
  id="reviews"
  title={site.sections.reviews.title}
  subtitle={site.sections.reviews.subtitle}
  background="default"
>
  <YandexReviews
    enabled={site.yandexReviews.enabled}
    organizationId={site.yandexReviews.organizationId}
    companyName={site.logoText}
    reviewsUrl={site.yandexReviews.reviewsUrl}
    placeholder={site.yandexReviews.placeholder}
  />
</Section>
