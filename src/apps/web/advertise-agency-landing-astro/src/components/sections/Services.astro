---
// Render the service catalog only when at least one item is available.
// Optional items default to the validated visibleServices collection.

import ServiceCard from "@/components/features/services/ServiceCard.astro";
import Section from "@/components/ui/Section.astro";
import Button from "@/components/ui/Button.astro";
import { services, visibleServices } from "@/content/services";
import type { Service } from "@/types/services";

// Caller-supplied data and presentation options for this component.
export interface Props {
  items?: Service[];
}

const { items = visibleServices } = Astro.props;
---

{items.length > 0 && (
  <Section
    id="services"
    title={services.heading}
    subtitle={services.introduction}
    headingClass="services-introduction"
    background="none"
    class="services"
  >
    {/*
        Cards share the filtered catalog order without client-side rendering.
      */}
    <div class="services-grid">
      {items.map((service) => (
        <ServiceCard service={service} />
      ))}
    </div>
    <div
      slot="action"
      class="services-action"
    >
      <Button
        href="/#order-inquiry"
        size="lg"
      >
        Заказать услугу
      </Button>
    </div>
  </Section>
)}

<style>
  /* Center the service heading and copy as one readable introduction. */
  :global(.services-introduction) {
    max-width: 60ch;
    margin: 0 auto 2.5rem;
    text-align: center;
    overflow-wrap: anywhere;
  }

  /* Keep service cards close to the shared subtitle. */
  :global(.services-introduction .site-section-subtitle) {
    margin-bottom: 1rem;
  }

  /* Keep each service fully readable in a narrow single-column layout. */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    align-items: stretch;
    gap: clamp(1.5rem, 3vw, 2rem);
  }

  .services-action {
    display: flex;
    justify-content: center;
    margin-top: var(--site-section-action-space);
  }
</style>
