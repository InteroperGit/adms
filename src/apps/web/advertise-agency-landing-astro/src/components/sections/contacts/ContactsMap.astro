---
// Render the configured lazy map or its local image fallback.

import type { SiteConfig } from "@/types/site";

interface Props {
  enabled: boolean;
  src: string;
  title: string;
  fallback: SiteConfig["mapFallback"];
}

const { enabled, src, title, fallback } = Astro.props;
---

<div
  class:list={[
    "contact-map w-full rounded-[var(--radius-field)]",
    "overflow-hidden border border-base-300 bg-base-200",
  ]}
>
  {enabled ? (
    <iframe
      src={src}
      title={title}
      width="100%"
      height="100%"
      class="border-0"
      allowfullscreen
      loading="lazy"
    ></iframe>
  ) : (
    <img
      src={fallback.src}
      alt={fallback.alt}
      width={fallback.width}
      height={fallback.height}
      class="w-full h-full object-cover"
      loading="lazy"
      decoding="async"
    />
  )}
</div>

<style>
  /* Reserve map height independently of third-party loading. */
  .contact-map {
    min-height: 18rem;
    height: 100%;
  }

  /* Fill the reserved map frame for either configured media variant. */
  .contact-map iframe,
  .contact-map img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 18rem;
  }
</style>
