---
// Render eligible pricing scopes and shared estimate guidance as static HTML.
// Empty collections omit the section. The loader owns demo/approval gates;
// this section owns the shared heading and price examples.
import PricingExample from "@/components/sections/pricing/PricingExample.astro";
import Section from "@/components/ui/Section.astro";
import CardCarousel from "../../ui/carousel/card-carousel/CardCarousel.astro";
import { pricing, visiblePricingExamples } from "@/content/pricing";
---

{visiblePricingExamples.length > 0 && (
  <Section
    id="pricing"
    title={pricing.heading}
    subtitle={pricing.introduction}
    headingClass="pricing-introduction"
    background="none"
    class="pricing"
  >
    {/* Keep each complete scope and its inquiry link inside one card. */}
    <div class="pricing-examples">
      <CardCarousel
        Item={PricingExample}
        items={visiblePricingExamples.map((example) => ({
          example,
          demoPriceLabel: pricing.demoPriceLabel,
          inquiryLabel: pricing.inquiryLabel,
        }))}
        label={pricing.heading}
      />
    </div>
    {/* Answer cost questions immediately after the example comparisons. */}
    <div class="pricing-guidance">
      <div>
        <h3 class="pricing-guidance-heading">{pricing.costFactors.heading}</h3>
        <ul class="pricing-factors">
          {pricing.costFactors.items.map((factor) => (
            <li>{factor}</li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="pricing-guidance-heading">
          {pricing.estimateGuidance.heading}
        </h3>
        <p class="pricing-estimate">{pricing.estimateGuidance.text}</p>
      </div>
    </div>
  </Section>
)}

<style>
  /* Center the pricing heading and subtitle above the examples. */
  :global(.pricing-introduction) {
    max-width: 60ch;
    margin: 0 auto 2.5rem;
    text-align: center;
    overflow-wrap: anywhere;
  }

  /* Keep the demo notice close to the shared pricing subtitle. */
  :global(.pricing-introduction .site-section-subtitle) {
    margin-bottom: 1rem;
  }

  /* Separate shared estimate guidance from the final example. */
  .pricing-guidance {
    display: grid;
    gap: 2rem;
    margin-top: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--site-control-border);
    overflow-wrap: anywhere;
  }

  /* Show one mobile card and a preview of the next example. */
  .pricing-examples :global(.card-carousel-track > *) {
    flex-basis: calc(100% / 1.2);
  }

  /* Give a lone example the full region instead of reserving a preview. */
  .pricing-examples :global(.card-carousel-track:has(> :only-child) > *) {
    flex-basis: 100%;
  }

  /* Keep a partial next card visible at tablet widths. */
  @media (min-width: 48rem) {
    .pricing-examples :global(.card-carousel-track > *) {
      flex-basis: calc((100% - 1rem) / 2.2);
    }
  }

  /* Show two cards and part of the third on wide screens. */
  @media (min-width: 75rem) {
    .pricing-examples :global(.card-carousel-track > *) {
      flex-basis: calc((100% - 2rem) / 2.5);
    }
  }

  /* Make the two practical buyer questions easy to locate. */
  .pricing-guidance-heading {
    font-size: 1.5rem;
    font-weight: 700;
  }

  /* Present each cost factor as a readable native list item. */
  .pricing-factors {
    display: grid;
    gap: 0.5rem;
    margin-top: 1rem;
    padding-left: 1.25rem;
    list-style: disc;
    color: var(--site-muted);
  }

  /* Keep the custom-estimate explanation close to its heading. */
  .pricing-estimate {
    margin-top: 1rem;
    color: var(--site-muted);
    max-width: 48ch;
  }

  /* Pair the questions only when each has a useful reading width. */
  @media (min-width: 64rem) {
    /* Share space equally between cost factors and next-step guidance. */
    .pricing-guidance {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3rem;
    }
  }
</style>
