---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { CarouselItem, CarouselOptions } from "@/types/imageCarousel";

interface Props {
  item: CarouselItem;
  index: number;
  options: CarouselOptions;
}

const { item, index, options } = Astro.props;
const originals = import.meta.glob<ImageMetadata>(
  "/src/assets/**/*.{avif,jpeg,jpg,png,webp}",
  { eager: true, import: "default" },
);
const original = originals[item.image];
if (item.image.startsWith("/src/assets/") && !original) {
  throw new Error(`Carousel image missing: ${item.image}`);
}
const widths = original
  ? [
      ...new Set([
        ...[320, 640].filter((width) => width < original.width),
        original.width,
      ]),
    ]
  : [];
const presentation = item.presentation;
const mobileFocalPoint =
  presentation.mobileFocalPoint ?? presentation.focalPoint;
const focalPoint =
  `${presentation.focalPoint.x}% ` + `${presentation.focalPoint.y}%`;
const mobileFocal = `${mobileFocalPoint.x}% ${mobileFocalPoint.y}%`;
const visibleDescription = options.descriptions && item.description;
const visibleLink = options.buttons && item.href && item.linkLabel;
const loadEagerly = index === 0 && options.eagerFirst;
---

<article
  class="offers-track-card"
  data-track-index={index}
  data-overlay={presentation.overlay}
  data-horizontal={presentation.horizontal}
  data-vertical={presentation.vertical}
  style={{
    "--offers-focal-point": focalPoint,
    "--offers-mobile-focal-point": mobileFocal,
    "--offers-description-size": `${presentation.fontSizeRem}rem`,
    "--offers-description-color": presentation.textColor,
  }}
>
  {original ? (
    <Image
      src={original}
      alt={item.imageAlt}
      widths={widths}
      sizes="100vw"
      draggable="false"
      loading={loadEagerly ? "eager" : "lazy"}
      decoding="async"
    />
  ) : (
    <img
      src={item.image}
      alt={item.imageAlt}
      width={item.imageWidth}
      height={item.imageHeight}
      draggable="false"
      loading={loadEagerly ? "eager" : "lazy"}
      decoding="async"
    />
  )}
  {visibleDescription || visibleLink ? (
    <div class="offers-track-copy">
      {visibleDescription && <p>{visibleDescription}</p>}
      {visibleLink && item.href && item.linkLabel && (
        <a
          class="offers-track-link"
          href={item.href}
        >
          {item.linkLabel}
        </a>
      )}
    </div>
  ) : null}
</article>

<style>
  .offers-track-card {
    position: absolute;
    inset: 0;
    isolation: isolate;
    display: grid;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 10px;
    background: #000;
  }

  .offers-track-card img {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--offers-focal-point);
  }

  .offers-track-copy {
    z-index: 1;
    display: grid;
    align-content: var(--offers-copy-align, end);
    justify-items: var(--offers-copy-justify, start);
    gap: 1rem;
    height: 100%;
    padding: clamp(2rem, 4vw, 3rem)
      max(var(--site-gutter), calc(var(--arrow-size) + 2rem));
    color: var(--offers-description-color, #fff);
  }

  .offers-track-card[data-horizontal="center"] .offers-track-copy {
    --offers-copy-justify: center;
    text-align: center;
  }

  .offers-track-card[data-horizontal="right"] .offers-track-copy {
    --offers-copy-justify: end;
    text-align: right;
  }

  .offers-track-card[data-vertical="top"] .offers-track-copy {
    --offers-copy-align: start;
  }

  .offers-track-card[data-vertical="center"] .offers-track-copy {
    --offers-copy-align: center;
  }

  .offers-track-copy p {
    margin: 0;
    padding: 1rem 1.25rem;
    background: rgb(0 0 0 / 35%);
    color: inherit;
    font-size: var(--offers-description-size, 1.25rem);
    line-height: 1.55;
    overflow-wrap: anywhere;
    text-shadow: 0 1px 3px #000;
  }

  .offers-track-card[data-overlay="light"] .offers-track-copy p {
    background: rgb(255 255 255 / 70%);
    text-shadow: none;
  }

  .offers-track-link {
    justify-self: var(--offers-copy-justify, start);
    max-width: 100%;
    min-height: 3rem;
    padding: 0.75rem 1.25rem;
    border: 1px solid #b2380a;
    background: #b2380a;
    color: #fff;
    text-align: center;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .offers-track-link:hover {
    border-color: #8f2d08;
    background: #8f2d08;
  }

  .offers-track-link:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
    box-shadow: 0 0 0 8px #000;
  }

  @media (max-width: 47.999rem) {
    .offers-track-card img {
      object-position: var(--offers-mobile-focal-point);
    }

    .offers-track-card {
      border-radius: 0;
    }

    .offers-track-copy {
      padding: 1.5rem;
    }
  }
</style>
