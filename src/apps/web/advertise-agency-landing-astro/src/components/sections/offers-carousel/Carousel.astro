---
import type { CarouselItem, CarouselOptions } from "@/types/imageCarousel";
import { carouselOptionsSchema } from "@/validation/imageCarousel";
import CarouselControls from "./CarouselControls.astro";
import CarouselTrack from "./CarouselTrack.astro";

interface Props {
  items: CarouselItem[];
  options: Partial<CarouselOptions>;
}

const { items: suppliedItems, options: suppliedOptions } = Astro.props;
const options = carouselOptionsSchema.parse(suppliedOptions);
const items = suppliedItems.filter((item) => item.enabled);
const shouldRenderOffersCarousel = options.enabled && items.length > 0;
const hasMultipleOffers = items.length > 1;
const showArrows =
  hasMultipleOffers && options.manualNavigation && options.arrows;
const showDots = hasMultipleOffers && options.circles;
---

{/* Compose the track and controls under one isolated carousel host. */}
{shouldRenderOffersCarousel && (
  <offers-image-carousel
    id="offers-carousel"
    class="offers-carousel"
    role="region"
    aria-label="Предложения"
    data-count={items.length}
    data-autoplay={options.autoplay}
    data-interval={options.intervalMs}
    data-manual={options.manualNavigation}
    data-animation={options.animation}
    data-single={!hasMultipleOffers ? "true" : undefined}
  >
    <CarouselTrack
      items={items}
      options={options}
    />
    <CarouselControls
      dotCount={items.length}
      showArrows={showArrows}
      showDots={showDots}
      manualNavigation={options.manualNavigation}
    />
  </offers-image-carousel>
)}

<script>
  import "./offersImageCarouselRuntime";
</script>

<style>
  /* Keep one viewport while scaling image slots and arrow edges. */
  .offers-carousel {
    --arrow-size: clamp(44px, calc(30px + 5.66vw), 144px);
    --offers-slide-edge: calc(15px + 2.83vw);
    --arrow-inset: calc(var(--offers-slide-edge) - var(--arrow-size) / 2);
    --offers-slide-inset-y: 0%;
    --offers-slide-height: 100%;
    --offers-slide-width: calc(
      100cqi - var(--offers-slide-edge) - var(--offers-slide-edge)
    );
    position: relative;
    display: block;
    width: 100%;
    height: clamp(30.36rem, 47.5vw, 44.88rem);
    min-width: 0;
    overflow: hidden;
    touch-action: pan-y;
    container-type: inline-size;
    cursor: grab;
    background: #70938f;
  }

  /* Give a single offer the whole component frame. */
  .offers-carousel[data-single] {
    --offers-slide-edge: 0px;
    --offers-slide-width: 100cqi;
    --offers-slide-inset-y: 0%;
    --offers-slide-height: 100%;
  }

  /* Show the drag cursor while the pointer is down. */
  .offers-carousel[data-dragging] {
    cursor: grabbing;
  }

  /* Keep drag motion immediate and honor disabled track animation. */
  .offers-carousel[data-dragging] :global(.offers-track),
  .offers-carousel[data-recentering] :global(.offers-track),
  .offers-carousel[data-animation="false"] :global(.offers-track) {
    transition: none;
  }

  /* Prevent selecting captions while dragging the track. */
  .offers-carousel[data-swiping] {
    user-select: none;
    -webkit-user-select: none;
  }

  /* Separate the frame from the lower section in the light theme. */
  :global(html[data-theme="dark"]) .offers-carousel {
    background: #1c3b3b;
  }

  /* Match the dark frame before the theme script selects a palette. */
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme])) .offers-carousel {
      background: #1c3b3b;
    }
  }

  /* Keep the frame while showing neighbors on wider screens. */
  @media (min-width: 48rem) {
    .offers-carousel {
      --arrow-size: clamp(44px, calc(30px + 5.66vw), 144px);
      --offers-slide-inset-y: 5%;
      --offers-slide-height: 90%;
    }
  }

  /* Size tablet images close to 4:3 while respecting viewport height. */
  @media (min-width: 48rem) and (max-width: 63.999rem) {
    .offers-carousel {
      --offers-slide-inset-y: 1.6667%;
      --offers-slide-height: 96.6666%;
      height: min(calc(73.174vw - 1.455rem), calc(100svh - 7rem));
    }
  }

  /* Keep the desktop banner compact in a short viewport. */
  @media (min-width: 64rem) and (max-height: 30rem) {
    .offers-carousel {
      height: 26.4rem;
    }
  }

  /* Leave a slim frame edge around desktop images. */
  @media (min-width: 64rem) {
    .offers-carousel {
      --offers-slide-inset-y: 1%;
      --offers-slide-height: 98%;
    }
  }

  /* Fill the mobile frame and clip neighboring slots. */
  @media (max-width: 47.999rem) {
    .offers-carousel {
      --arrow-size: 44px;
      --arrow-inset: 8px;
      --offers-slide-edge: 0px;
      --offers-slide-width: 100cqi;
      height: min(36.666rem, calc(100svh - 7rem));
    }
  }

  /* Honor still-motion preferences for the track and arrows. */
  @media (prefers-reduced-motion: reduce) {
    .offers-carousel :global(.offers-track),
    .offers-carousel :global(.carousel-arrow) {
      transition: none;
    }
  }
</style>
