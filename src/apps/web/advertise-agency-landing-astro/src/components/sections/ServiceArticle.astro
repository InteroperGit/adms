---
// Render the static article for a required, validated service identifier.
// Unknown IDs fail the build; unapproved demo content remains noindex.
// Keep image, inquiry checklist and return/contact actions in reading order.

import Layout from '@/layouts/Layout.astro';
import ContentBlocks from '@/components/content/ContentBlocks.astro';
import Button from '@/components/ui/Button.astro';
import { services, visibleServices } from '@/content/services';
import { isServiceArticlePublished } from '@/content/service-publication';

// Caller-supplied data and presentation options for this component.
export interface Props {
  serviceId: string;
}

const service = services.items.find(
  (item) => item.id === Astro.props.serviceId,
);
if (!service) throw new Error(`Unknown service: ${Astro.props.serviceId}`);
const { article } = service;
// Index only when category, copy, image and article approvals all permit it.
const demo = !isServiceArticlePublished(services, service);
// A withheld catalog has no homepage anchor, so return to the homepage.
const catalogHref = visibleServices.length ? '/#services' : '/';
const catalogLabel = visibleServices.length ? 'Все услуги' : 'На главную';
---

{/*
  Keep image, inquiry checklist and return/contact actions in reading order.
*/}
<Layout
  title={article.title}
  description={article.description}
  noindex={demo}
>
  <article class="site-container service-article">
    <a class="service-back" href={catalogHref}>
      {catalogLabel}
    </a>
    <div class="service-heading">
      <h1>{service.name}</h1>

      {demo && <p class="service-demo">{services.demoNotice}</p>}
    </div>
    {/* Pass page approval and identity to the same renderer as projects. */}
    <div class="service-reading">
      <ContentBlocks
        blocks={article.content}
        context={{
          kind: 'service', serviceId: service.id,
          category: service.id, published: !demo,
        }}
      />
      <nav class="service-actions" aria-label="Действия по услуге">
        <Button href="/#order-inquiry">Обсудить проект</Button>
        <a class="service-back" href={catalogHref}>
          {catalogLabel}
        </a>
      </nav>
    </div>
  </article>
</Layout>

<style>
  /* Align article content with the shared page container. */
  .service-article {
    padding-block: clamp(2rem, 5vw, 4rem);
    overflow-wrap: anywhere;
  }

  /* Make return navigation recognizable and easy to activate. */
  .service-back {
    display: inline-block;
    min-height: 2.75rem;
    padding-block: 0.5rem;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Keep the introductory text narrower than the page container. */
  .service-heading {
    max-width: 56rem;
    margin-block: 1.5rem 2rem;
  }

  /* Lead with clear category lettering. */
  .service-heading h1 {
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.15;
    font-weight: 700;
  }

  /* Introduce the category with the first authored paragraph block. */
  .service-reading :global(.content-block:first-child p) {
    margin-top: 1.25rem;
    font-size: 1.25rem;
  }

  /* Identify sample content without mimicking an action button. */
  .service-demo {
    margin-top: 1rem;
    padding-left: 1rem;
    border-left: 3px solid var(--color-primary);
    color: var(--site-muted);
  }

  /* Constrain prose to a comfortable line length. */
  .service-reading {
    max-width: var(--site-reading-width);
  }

  /* Allow native navigation actions to wrap at enlarged text sizes. */
  .service-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 2.5rem;
  }

  /* Keep the inquiry button readable when its label wraps. */
  .service-actions :global(.btn) {
    height: auto;
    max-width: 100%;
    min-height: 2.75rem;
    padding-block: 0.75rem;
    white-space: normal;
  }
</style>
