---
import { site } from '@/content/site';
---

<section id="contacts" class="py-16 px-4 bg-base-200">
  <div class="container mx-auto">
    <h2 class="text-4xl font-bold text-center mb-12">Как нас найти</h2>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-1 space-y-4 p-6 rounded-3xl bg-base-100/50 shadow-inner backdrop-blur-sm">
        <div class="flex items-center gap-3">
          <span class="text-2xl">📍</span>
          <span>{site.address}</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-2xl">📞</span>
          <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="link link-hover">{site.phone}</a>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-2xl">✉️</span>
          <a href={`mailto:${site.email}`} class="link link-hover">{site.email}</a>
        </div>
        <div class="mt-6">
          <p class="font-semibold">Режим работы:</p>
          <p>{site.workHours}</p>
          <p>{site.workHoursWeekend}</p>
        </div>
      </div>
      <div class="lg:col-span-2">
        <!-- Карта (оставляем статичным iframe) -->
        <div class="w-full h-64 lg:h-80 rounded-xl overflow-hidden shadow-lg">
          <iframe
            src={site.mapSrc}
            width="100%"
            height="100%"
            frameborder="0"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>