---
// Render one solution's contextual carousel and source-rights caption.

// prettier-ignore
import ImageCarousel from
  "../../../ui/carousel/image-carousel/ImageCarousel.astro";
// prettier-ignore
import ImageCarouselSlide from
  "../../../ui/carousel/image-carousel/ImageCarouselSlide.astro";
import type { BusinessSolutionCarousel } from "@/types/businessSolutions";

interface Props {
  solutionId: string;
  carousel: BusinessSolutionCarousel;
}

const { solutionId, carousel } = Astro.props;
const SOLUTION_GALLERY_ASPECT_RATIO = 2.9;
---

{/* Pair each business type with contextual, rights-recorded media. */}
<figure class="solution-gallery">
  <ImageCarousel
    Item={ImageCarouselSlide}
    id={`business-solutions-${solutionId}`}
    label={carousel.itemLabel}
    itemLabel={carousel.itemLabel}
    items={carousel.items}
    options={{
      ...carousel.options,
      layout: "panel",
      aspectRatio: SOLUTION_GALLERY_ASPECT_RATIO,
    }}
  />
  <figcaption class="sr-only">
    {carousel.mediaSource} {carousel.mediaRights}
  </figcaption>
</figure>

<style>
  /* Keep the contextual gallery inside its solution panel. */
  .solution-gallery {
    min-width: 0;
    position: relative;
    margin: 0;
  }

  /* Keep media corners aligned with the surrounding solution panel. */
  .solution-gallery :global(.image-carousel) {
    overflow: hidden;
    border-radius: var(--radius-field);
  }

  /* Expose provenance without presenting media as project proof. */
  .solution-gallery figcaption {
    margin-top: 0.75rem;
    color: var(--site-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  /* Reclaim mobile space without returning images to their former height. */
  @media (max-width: 47.999rem) {
    /* Keep mobile artwork taller than the prior panel ratio. */
    .solution-gallery
      :global(.image-carousel[data-layout="panel"] .carousel-slide) {
      aspect-ratio: 2.3;
    }
  }
</style>
