---
// Render one business solution with its evidence and inquiry action.

import Button from "@/components/ui/Button.astro";
import Link from "@/components/ui/Link.astro";
import BusinessSolutionGallery from "./media/BusinessSolutionGallery.astro";
import type { BusinessSolutionItem } from "@/types/businessSolutions";

interface Props {
  item: BusinessSolutionItem;
}

const { item } = Astro.props;
---

<article
  class="solution-item"
  aria-labelledby={`solution-${item.id}`}
>
  <BusinessSolutionGallery
    solutionId={item.id}
    carousel={item.carousel}
  />
  <h3
    id={`solution-${item.id}`}
    class="solution-heading"
  >
    {item.title}
  </h3>
  <p class="solution-summary">{item.summary}</p>
  <div class="solution-copy">
    <div class="solution-task">
      <h4>Задача клиента</h4>
      <p>{item.customerTask}</p>
    </div>
    <div class="solution-approach">
      <h4>Подходящее решение</h4>
      <p>{item.solution}</p>
    </div>
    <div class="solution-example">
      <h4>{item.example.title}</h4>
      <p>{item.example.text}</p>
    </div>
  </div>
  {/* Omit attribution unless complete evidence metadata is available. */}
  <div class="solution-attribution">
    {item.attribution.customerName && item.attribution.evidence && (
      <>
        <p>
          Реализовано для: {item.attribution.customerName}.{" "}
          {item.attribution.evidence}
        </p>
        {item.attribution.href && (
          <Link href={item.attribution.href}>Смотреть проект</Link>
        )}
      </>
    )}
  </div>
  <Button
    href={item.inquiryHref}
    variant="primary"
    size="md"
    class="solution-inquiry"
    aria-label={item.inquiryLabel}
  >
    {item.inquiryLabel}
  </Button>
</article>

<style>
  /* Use a bordered panel to separate long, content-driven examples. */
  .solution-item {
    display: grid;
    grid-row: 1 / span var(--solution-section-count);
    grid-template-rows: subgrid;
    --solution-card-vertical-padding: 0.875rem;
    --solution-card-bottom-padding: 1.125rem;
    --solution-card-padding: clamp(1rem, 1.5vw, 1.25rem);
    min-width: 0;
    padding: var(--solution-card-vertical-padding) var(--solution-card-padding);
    padding-block-end: var(--solution-card-bottom-padding);
    border: 1px solid var(--site-control-border);
    border-radius: var(--radius-box);
    background: var(--color-base-100);
    overflow: hidden;
    overflow-wrap: anywhere;
  }

  /* Let the gallery reach the card's inside top and side edges. */
  .solution-item :global(.solution-gallery) {
    width: calc(
      100% + var(--solution-card-padding) + var(--solution-card-padding)
    );
    margin: calc(0px - var(--solution-card-vertical-padding))
      calc(0px - var(--solution-card-padding)) 0;
  }

  /* Keep titles on the shared carousel row. */
  .solution-heading {
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    font-weight: 700;
    margin: 0;
  }

  /* Align summaries across every card without clipping longer copy. */
  .solution-summary {
    margin: 0;
    color: var(--site-muted);
    line-height: 1.6;
  }

  /* Share the three problem/approach/example row heights across cards. */
  .solution-copy {
    display: grid;
    grid-row: 4 / span 3;
    grid-template-rows: subgrid;
    gap: 0.4rem;
    margin: 0;
  }

  /* Make the short labels easy to scan above their complete copy. */
  .solution-copy h4 {
    font-size: 1.05rem;
    font-weight: 700;
  }

  /* Preserve readable separation between labels and wrapped paragraphs. */
  .solution-copy p {
    margin-top: 0.4rem;
    color: var(--site-muted);
    line-height: 1.65;
  }

  /* Keep verified customer evidence distinct from reusable category copy. */
  .solution-attribution {
    min-width: 0;
    margin: 0;
    color: var(--site-muted);
  }

  /* Retain a visible cue for an available project evidence link. */
  .solution-attribution :global(a) {
    display: inline-block;
    margin-top: 0.5rem;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Keep the inquiry action reachable and wrapping at enlarged text sizes. */
  .solution-inquiry {
    align-self: center;
    justify-self: center;
    max-width: 100%;
    height: auto;
    min-height: 3rem;
    margin-top: 1rem;
    padding-block: 0.75rem;
    white-space: normal;
  }

  /* Compact mobile spacing and preserve complete copy and the bottom gap. */
  @media (max-width: 47.999rem) {
    /* Reduce top padding without changing the gallery's aligned edge. */
    .solution-item {
      --solution-card-vertical-padding: 0.5rem;
    }

    /* Tighten the spaces between the three stacked text sections. */
    .solution-copy {
      gap: 0.125rem;
    }

    /* Reduce supporting copy height while keeping comfortable line spacing. */
    .solution-summary {
      line-height: 1.45;
    }

    /* Tighten wrapped paragraphs and label separation on narrow screens. */
    .solution-copy p {
      margin-top: 0.25rem;
      line-height: 1.45;
    }

    /* Keep compact section labels readable while reducing their line boxes. */
    .solution-copy h4 {
      line-height: 1.25;
    }

    /* Preserve separation above the action with a smaller mobile margin. */
    .solution-inquiry {
      margin-top: 0.5rem;
    }
  }
</style>
