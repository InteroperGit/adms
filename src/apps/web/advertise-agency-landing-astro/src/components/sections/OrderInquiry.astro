---
// Render the configured inquiry form and accessible validation feedback.
// Fields start disabled until the protective submit handler is installed.
// Delivery stays disabled when no backend is configured; copy stays visible.

import Section from '@/components/ui/Section.astro';
import { orderInquiry as content } from '@/content/order-inquiry';
import { site } from '@/content/site';

// Keep input identity and native autocomplete stable across field copy.
const inputs = [
  { key: 'name', type: 'text', autocomplete: 'name' },
  { key: 'email', type: 'email', autocomplete: 'email' },
  { key: 'phone', type: 'tel', autocomplete: 'tel' },
] as const;
const privacy = site.legal.find((item) => item.href === '/privacy-policy');
---

{/*
  Delivery stays disabled when no backend is configured; copy stays visible.
*/}
<Section
  id="order-inquiry"
  title={content.title}
  subtitle={content.subtitle}
>
  <div class="inquiry">
    <form
      class="inquiry-form"
      method="post"
      data-inquiry
      data-enabled={String(content.submission.enabled)}
      data-endpoint={content.submission.endpoint}
      data-timeout={content.submission.timeoutMs}
      data-feedback={JSON.stringify(content.feedback)}
      aria-describedby="inquiry-required inquiry-status"
    >
      <p id="inquiry-required" class="inquiry-note inquiry-required">
        {content.requiredNote}
      </p>
      {/*
        Start protected; register submission before enabling input.
      */}
      <fieldset class="inquiry-fields" disabled>
        {inputs.map(({ key, type, autocomplete }) => {
          const field = content.fields[key];
          return (
            <div
              class:list={[
                'inquiry-field',
                { 'inquiry-phone': key === 'phone' },
              ]}
            >
              <label for={`inquiry-${key}`}>
                {field.label}{' '}
                {field.required && <span aria-hidden="true">*</span>}
              </label>
              <input
                id={`inquiry-${key}`}
                name={key}
                type={type}
                autocomplete={autocomplete}
                required={field.required}
                maxlength={field.maxLength}
                aria-describedby={`inquiry-${key}-hint inquiry-${key}-error`}
              />
              <p id={`inquiry-${key}-hint`} class="inquiry-note">
                {field.hint} (≤ {field.maxLength})
              </p>
              <p
                id={`inquiry-${key}-error`}
                class="inquiry-error"
                hidden
              ></p>
            </div>
          );
        })}
        {/* Associate the longer message with its hint and validation error. */}
        <div class="inquiry-field inquiry-message">
          <label for="inquiry-message">
            {content.fields.message.label} <span aria-hidden="true">*</span>
          </label>
          <textarea
            id="inquiry-message"
            name="message"
            rows="6"
            required
            maxlength={content.fields.message.maxLength}
            aria-describedby="inquiry-message-hint inquiry-message-error"
          ></textarea>
          <p id="inquiry-message-hint" class="inquiry-note">
            {content.fields.message.hint} (≤{' '}
            {content.fields.message.maxLength})
          </p>
          <p id="inquiry-message-error" class="inquiry-error" hidden></p>
        </div>
        {/*
          Keep the required native agreement and policy destination together.
        */}
        <div class="inquiry-consent">
          <label for="inquiry-consent" class="inquiry-consent-label">
            <input
              id="inquiry-consent"
              name="consent"
              type="checkbox"
              required
              aria-describedby="inquiry-consent-error"
            />
            <span>
              {content.consent.label} <span aria-hidden="true">*</span>
            </span>
          </label>
          <a class="inquiry-link" href={privacy?.href ?? '/privacy-policy'}>
            {content.privacyLabel}
          </a>
          <p id="inquiry-consent-error" class="inquiry-error" hidden></p>
        </div>
      </fieldset>
      {/*
        Delivery remains disabled unless configured and safely initialized.
      */}
      <button
        class="btn btn-primary site-button inquiry-submit"
        type="submit"
        disabled
        aria-describedby="inquiry-status"
      >
        {content.submitLabel}
      </button>
      {/*
        Polite feedback reports validation or delivery without replacing labels.
      */}
      <p
        id="inquiry-status"
        class="inquiry-status"
        role="status"
        aria-live="polite"
        aria-atomic="true"
      >
        {content.submission.enabled ? '' : content.feedback.unavailable}
      </p>
      <noscript>
        <p class="inquiry-note">{content.feedback.noJavaScript}</p>
      </noscript>
    </form>
  </div>
</Section>

<script>
  import { initializeInquiry } from './order-inquiry';

  // Initialize only inquiry forms; delivery and validation stay in the helper.
  document
    .querySelectorAll<HTMLFormElement>('[data-inquiry]')
    .forEach(initializeInquiry);
</script>

<style>
  /* A centered measure makes the form read as one focused writing area. */
  .inquiry {
    max-width: 56rem;
    margin-inline: auto;
    overflow-wrap: anywhere;
  }

  /* Distinguish the form surface from surrounding section content. */
  .inquiry-form {
    min-width: 0;
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    border: 1px solid var(--color-base-300);
    border-radius: var(--radius-panel);
    background: var(--color-base-200);
    box-shadow: var(--shadow-panel);
  }

  /* Required-field guidance introduces the form without competing labels. */
  .inquiry-required {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-base-300);
  }

  /* Keep native protected fieldset behavior within a responsive grid. */
  .inquiry-fields {
    min-width: 0;
    display: grid;
    gap: 1.5rem;
    border: 0;
    padding: 0;
    margin: 0;
  }

  /* Keep labels, controls, hints, and errors in a readable vertical rhythm. */
  .inquiry-field {
    min-width: 0;
    display: grid;
    gap: 0.625rem;
    align-content: start;
  }

  /* Strong labels help visitors scan the information they need to provide. */
  .inquiry-field label {
    font-weight: 600;
    color: var(--color-base-content);
  }

  /* The brand-colored required marker stays distinct from the field label. */
  .inquiry-field label span {
    color: var(--color-primary);
  }

  /* Contrasting surfaces and ample height identify writable controls. */
  .inquiry-field input,
  .inquiry-field textarea {
    min-width: 0;
    width: 100%;
    min-height: 3.25rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--site-control-border);
    border-radius: var(--radius-field);
    background: var(--color-base-100);
    color: var(--color-base-content);
    font: inherit;
  }

  /* A clear focus outline keeps the active field easy to locate. */
  .inquiry-field input:focus-visible,
  .inquiry-field textarea:focus-visible {
    border-color: var(--color-primary);
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  /* Let visitors enlarge the message vertically without widening the form. */
  .inquiry-field textarea {
    min-height: 10rem;
    resize: vertical;
  }

  /* Reinforce validation with a boundary and its associated error text. */
  .inquiry-field [aria-invalid='true'] {
    border: 2px solid var(--color-primary);
  }

  /* Hints stay secondary while meeting the shared theme contrast baseline. */
  .inquiry-note {
    color: var(--site-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  /* Error text remains legible and distinct in both themes. */
  .inquiry-error {
    color: var(--color-primary);
    font-weight: 600;
  }

  /* A separate agreement area marks the transition from writing to sending. */
  .inquiry-consent {
    grid-column: 1 / -1;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-base-300);
  }

  /* Keep the checkbox and wrapping agreement text one generous target. */
  .inquiry-consent-label {
    display: flex;
    gap: 0.75rem;
    align-items: start;
    min-height: 2.75rem;
  }

  /* Align the native checkbox with the first consent line. */
  .inquiry-consent-label input {
    flex: 0 0 auto;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.125rem;
    accent-color: var(--color-primary);
  }

  /* Align the related privacy link with the consent text. */
  .inquiry-link {
    display: flex;
    align-items: center;
    width: fit-content;
    max-width: calc(100% - 2.25rem);
    margin-left: 2.25rem;
    min-height: 2.75rem;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* A full-width mobile action makes the form's final step unmistakable. */
  .inquiry-submit {
    width: 100%;
    max-width: 100%;
    height: auto;
    min-height: 3.25rem;
    padding: 0.875rem 1.5rem;
    white-space: normal;
    font-size: 1rem;
  }

  /* Disabled sending stays readable and visibly unavailable. */
  .inquiry-submit:disabled {
    background: var(--color-base-300);
    color: var(--color-base-content);
    border-color: var(--site-control-border);
    opacity: 1;
    box-shadow: none;
  }

  /* Delivery feedback is a distinct, readable part of the form footer. */
  .inquiry-status {
    min-height: 1.6em;
    padding: 1rem;
    border: 1px solid var(--color-base-300);
    border-radius: var(--radius-field);
    background: var(--color-base-100);
    color: var(--site-muted);
  }

  /* Empty live feedback reserves room without showing an empty panel. */
  .inquiry-status:empty {
    padding: 0;
    border: 0;
    background: transparent;
  }

  /* Pair short contact fields only when their labels fit comfortably. */
  @media (min-width: 48rem) {
    /* Name and email share a row in the bounded form panel. */
    .inquiry-fields {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Phone and project description avoid an unfinished half-width row. */
    .inquiry-phone,
    .inquiry-message {
      grid-column: 1 / -1;
    }

    /* Keep the desktop submission action aligned to the form's left edge. */
    .inquiry-submit {
      width: fit-content;
      min-width: 14rem;
    }
  }
</style>
