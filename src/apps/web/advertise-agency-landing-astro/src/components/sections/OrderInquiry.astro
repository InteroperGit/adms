import Section from "@/components/ui/Section.astro";
import { orderInquiry as content } from "@/content/orderInquiry";
import OrderInquiryForm from "../forms/order-inquiry/OrderInquiryForm.astro";
---

<Section
  id="order-inquiry"
  title={content.title}
  subtitle={content.subtitle}
>
  <OrderInquiryForm content={content} />
</Section>
