---
// src/components/sections/Projects.astro
import type { Project } from '@/types';

export interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<section id="projects" class="py-16 px-4 bg-base-200">
  <div class="container mx-auto">
    <h2 class="text-4xl font-bold text-center mb-12">Наши проекты</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projects.map((p) => (
        <div class="card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow">
          <figure>
            <img src={p.image} alt={p.title} class="w-full h-48 object-cover" />
          </figure>
          <div class="card-body">
            <h3 class="card-title">{p.title}</h3>
            <p class="text-sm text-gray-500">Клиент: {p.client}</p>
            <p>{p.shortDescription}</p>
            <div class="card-actions justify-end mt-4">
              <a href={`/projects/${p.id}`} class="btn btn-primary btn-sm">Подробнее</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>