---
// src/components/sections/About.astro
import Section from '@/components/ui/Section.astro';
import { site } from '@/content/site';
import { about } from '@/content/about';
import { icons } from '@/content/icons';
---

<Section id="about" title={site.sections.about.title} background="default">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
    <div>
      <p class="text-lg leading-relaxed mb-4">{about.description1}</p>
      <p class="text-lg leading-relaxed">{about.description2}</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-8">
        {about.stats.map((stat) => (
          <div class="stat">
            <div class="stat-value text-primary">{stat.value}</div>
            <div class="stat-title">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
    <div class="flex justify-center">
      <div class="w-full max-w-sm aspect-square bg-primary/10 rounded-2xl flex items-center justify-center text-6xl text-primary">
        {icons.sparkles}
      </div>
    </div>
  </div>
</Section>