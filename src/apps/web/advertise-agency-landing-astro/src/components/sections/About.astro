---
// src/components/sections/About.astro
import Section from '@/components/ui/Section.astro';
import { site } from '@/content/site';
import { about } from '@/content/about';
import Button from '@/components/ui/Button.astro';
const projects = site.menu.find(item => item.href === '/#projects');
const contacts = site.menu.find(item => item.href === '/#contacts');
---

<Section id="about" background="default" class="opening">
  <div class="opening-introduction">
    <h2 class="site-section-title">{site.sections.about.title}</h2>
    <p class="opening-lead">{about.description1}</p>
    <p class="opening-detail">{about.description2}</p>
    <div class="opening-actions">
      {contacts && <Button href={contacts.href}>{site.sections.contacts.panelTitle}</Button>}
      {projects && <Button variant="outline" href={projects.href}>{site.sections.projects.title}</Button>}
    </div>
  </div>
  <dl class="opening-stats">
    {about.stats.map(stat => <div><dt>{stat.label}</dt><dd>{stat.value}</dd></div>)}
  </dl>
</Section>

<style>
  .opening-introduction { max-width: 56rem; overflow-wrap: anywhere; }
  .site-section-title { text-align: left; margin-bottom: 1.5rem; }
  .opening-lead { font-size: clamp(1.25rem, 2.4vw, 1.875rem); line-height: 1.45; max-width: 48ch; }
  .opening-detail { max-width: 64ch; margin-top: 1.25rem; color: var(--site-muted); font-size: 1.125rem; }
  .opening-actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }
  .opening-actions :global(a) { height: auto; min-height: 3rem; padding-block: 0.75rem; white-space: normal; max-width: 100%; }
  .opening-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--color-base-300); max-width: 56rem; }
  .opening-stats div { display: flex; flex-direction: column; min-width: 0; }
  .opening-stats dt { color: var(--site-muted); overflow-wrap: anywhere; }
  .opening-stats dd { order: -1; font-size: 2rem; line-height: 1.2; font-weight: 700; color: var(--color-brand); margin-bottom: 0.5rem; overflow-wrap: anywhere; }
  @media (max-width: 35rem) { .opening-stats { grid-template-columns: 1fr; gap: 1rem; } .opening-stats div { flex-direction: row; align-items: baseline; gap: 1rem; } .opening-stats dd { margin-bottom: 0; min-width: 5ch; } }
</style>
