---
// prettier-ignore
import type { ProductionAndGuaranteesContent } from
  "@/types/productionAndGuarantees";
import CardCarousel from "../../ui/carousel/card-carousel/CardCarousel.astro";
import GuidanceCard from "./GuidanceCard.astro";

interface Props {
  items: ProductionAndGuaranteesContent["guidance"];
}

const { items } = Astro.props;
---

<div class="production-guidance">
  <CardCarousel
    Item={GuidanceCard}
    items={items}
    label="Наши гарантии"
  />
</div>

<style>
  /* Restore the original guidance grid outside the mobile carousel layout. */
  @media (min-width: 48rem) {
    .production-guidance :global(.card-carousel-viewport) {
      cursor: auto;
      overflow: visible;
      scroll-snap-type: none;
    }

    .production-guidance :global(.card-carousel-track) {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
      gap: 1rem;
      min-width: 0;
    }

    .production-guidance :global(.card-carousel-track > *) {
      flex: initial;
      height: 100%;
      scroll-snap-align: none;
    }
  }
</style>
