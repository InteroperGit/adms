---
// Render configured introduction media with its approved focal points.

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { IntroductionPhoto as PhotoData } from "@/types/introduction";

interface Props {
  photo: PhotoData;
  original?: ImageMetadata;
}

const { photo, original } = Astro.props;
const focalPoint = (point: PhotoData["desktopFocalPoint"]) =>
  `${point.x}% ${point.y}%`;
---

<div
  class="introduction-photo"
  style={{
    "--desktop-focal-point": focalPoint(photo.desktopFocalPoint),
    "--mobile-focal-point": focalPoint(photo.mobileFocalPoint),
  }}
>
  {original ? (
    <Image
      src={original}
      alt={photo.alt}
      width={photo.width}
      height={photo.height}
      widths={[480, 768, 1200]}
      sizes="(min-width: 64rem) 46vw, 100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="introduction-image"
    />
  ) : (
    <img
      src={photo.src}
      alt={photo.alt}
      width={photo.width}
      height={photo.height}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="introduction-image"
    />
  )}
</div>

<style>
  /* Reserve a stable frame only when an actual photo is configured. */
  .introduction-photo {
    min-width: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-field);
    background: var(--color-base-200);
  }

  /* Preserve the approved desktop subject within the reserved frame. */
  .introduction-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--desktop-focal-point);
  }

  /* Use the separately editable mobile subject position. */
  @media (max-width: 63.999rem) {
    .introduction-image {
      object-position: var(--mobile-focal-point);
    }
  }
</style>
