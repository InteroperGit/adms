{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"],
      "@/data/content/site/*": ["./tests/fixtures/content/site/*"],
      "@/data/*": ["./data/*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "output", "coverage", "node_modules"]
}
