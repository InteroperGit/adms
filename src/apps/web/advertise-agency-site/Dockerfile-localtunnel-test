# Этап сборки
FROM node:20-alpine AS build

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

ARG NEXT_PUBLIC_STRAPI_URL

RUN test -n "$NEXT_PUBLIC_STRAPI_URL" || (echo "ERROR: NEXT_PUBLIC_STRAPI_URL is not set" && exit 1)

ENV NEXT_PUBLIC_STRAPI_URL=${NEXT_PUBLIC_STRAPI_URL}

COPY . .
RUN pnpm build

# Финальный образ
FROM node:20-alpine

RUN apk add --no-cache curl && \
    npm install -g localtunnel && \
    corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

COPY --from=build /app/.next ./.next
COPY --from=build /app/public ./public
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=build /app/next.config.ts ./next.config.ts
COPY --from=build /app/tsconfig.json ./tsconfig.json

RUN pnpm install --prod --frozen-lockfile

COPY scripts/entrypoint-localtunnel.sh /entrypoint-localtunnel.sh
RUN chmod +x /entrypoint-localtunnel.sh

EXPOSE 3000

CMD ["/entrypoint-localtunnel.sh"]
