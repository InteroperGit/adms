FROM node:20-alpine

RUN apk add --no-cache curl && \
    npm install -g localtunnel && \
    corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

COPY scripts/entrypoint-localtunnel.sh /entrypoint-localtunnel.sh
RUN chmod +x /entrypoint-localtunnel.sh

EXPOSE 3000

CMD ["/entrypoint-localtunnel.sh"]
