FROM node:20-alpine AS build

# Установка PNPM
RUN corepack enable && corepack prepare pnpm@latest --activate

# Создаем рабочую директорию
WORKDIR /app

# Копируем зависимости
COPY package.json pnpm-lock.yaml ./

# Устанавливаем зависимости
RUN pnpm install --frozen-lockfile

# Копируем весь проект
COPY . .

# Собираем Next.js приложение (src/app поддерживается по умолчанию)
RUN pnpm build

# Этап 2: Финальный образ для запуска
FROM node:20-alpine

# Установка curl и cloudflared
RUN apk add --no-cache curl && \
    wget https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64 -O /usr/local/bin/cloudflared && \
    chmod +x /usr/local/bin/cloudflared && \
    corepack enable && \
    corepack prepare pnpm@latest --activate


# Создаем рабочую директорию для запуска
WORKDIR /app

# Копируем только необходимые файлы из предыдущего этапа
COPY --from=build /app/.next /app/.next
COPY --from=build /app/public /app/public
COPY --from=build /app/package.json /app/package.json
COPY --from=build /app/pnpm-lock.yaml /app/pnpm-lock.yaml
COPY --from=build /app/next.config.ts .
COPY --from=build /app/tsconfig.json .
COPY --from=build /app/node_modules /app/node_modules

# Копируем скрипт запуска
COPY scripts/entrypoint-cloudflare.sh /entrypoint-cloudflare.sh
RUN chmod +x /entrypoint-cloudflare.sh

# Пробрасываем порт
EXPOSE 3000

CMD ["/entrypoint-cloudflare.sh"]