{
  "name": "advertise-agency-landing-core",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "tsc -b tsconfig.app.json && react-router build && vite-node scripts/postbuild-seo.ts && vite-node scripts/postbuild-cache.ts",
    "build:full": "rm -rf .ssg-cache && pnpm build",
    "test-incremental": "vite-node scripts/test-incremental.ts",
    "preview": "vite preview --outDir build/client",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\"",
    "validate": "vite-node scripts/validate.ts",
    "gen-schemas": "vite-node scripts/generate-json-schemas.ts",
    "new-client": "vite-node scripts/new-client.ts",
    "check-icons": "vite-node scripts/check-icons.ts",
    "analyze": "tsc -b tsconfig.app.json && react-router build --mode analyze",
    "typecheck": "tsc -b tsconfig.app.json --noEmit"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "@tailwindcss/vite>vite": "^8",
        "@react-router/dev>vite": "^8"
      }
    }
  },
  "dependencies": {
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-router/dev": "^7.13.1",
    "@react-router/node": "^7.13.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.576.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.13.1",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "isbot": "^5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.0",
    "vite-node": "^6.0.0"
  }
}
