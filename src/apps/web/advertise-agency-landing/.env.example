# Copy to .env and fill in values
# VITE_ prefix required for Vite to expose vars to the client

# SITE_URL=https://example.com  # Base URL prepended to every <loc> in sitemap.xml. Set in .env (SSR) or CI environment (SSG).

# ---------- .env.deploy (copy to .env.deploy and fill in values) ----------
# Deployment vars — gitignored, used by scripts/copyAssetsToS3.sh and scripts/copyContentToS3.sh

# Assets bucket (data/content/ and public/images/)
# ASSETS_S3_BUCKET=adms-assets
# ASSETS_S3_ACCESS_KEY=<beget-assets-access-key>
# ASSETS_S3_SECRET_KEY=<beget-assets-secret-key>

# Content bucket (build/client static output)
# CONTENT_S3_BUCKET=adms-content
# CONTENT_S3_ACCESS_KEY=<beget-content-access-key>
# CONTENT_S3_SECRET_KEY=<beget-content-secret-key>
