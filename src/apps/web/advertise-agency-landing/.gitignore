.env*
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Exception for scripts/build test files
!scripts/build

node_modules
dist
dist-ssr
*.local

# Vite
.vite-react-ssg-temp

# React Router — generated types directory
.react-router/

# Incremental SSG cache — persistent, gitignored
.ssg-cache/

# Vitest coverage output
coverage/

# Content — local only, not tracked in git
data/content/
!data/_schema/

# Public — all files synced to S3, not tracked in git
public/

# Generated — run pnpm gen-schemas to rebuild
data/_schema/schema/

# Playwright
test-results/
playwright-report/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
public/site.webmanifest
