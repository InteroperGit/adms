{
  "name": "advertise-agency-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "postbuild:seo": "vite-node scripts/postbuildSeo.ts",
    "postbuild:cache": "vite-node scripts/postbuildCache.ts",
    "postbuild:sitemap": "vite-node scripts/postbuildSitemap.ts",
    "postbuild:robots": "vite-node scripts/postbuildRobots.ts",
    "postbuild:buildManifest": "vite-node scripts/postBuildBuildManifest.ts",
    "postbuild": "pnpm postbuild:buildManifest && pnpm postbuild:seo && pnpm postbuild:cache && pnpm postbuild:sitemap && pnpm postbuild:robots",
    "build": "tsc -b tsconfig.app.json && react-router build && pnpm postbuild",
    "build:full": "rm -rf .ssg-cache && pnpm build",
    "test-incremental": "vite-node scripts/testIncremental.ts",
    "preview": "vite preview --outDir build/client",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\"",
    "validate": "vite-node scripts/validate.ts",
    "gen-schemas": "vite-node scripts/generateJsonSchemas.ts",
    "new-client": "vite-node scripts/newClient.ts",
    "check-icons": "vite-node scripts/checkIcons.ts",
    "pull:assets:S3": "bash scripts/pullAssetsFromD3.sh",
    "pull:assets:S3:win": "powershell -ExecutionPolicy Bypass -File scripts/pullAssetsFromD3.ps1",
    "copy:assets:S3": "bash scripts/copyAssetsToS3.sh",
    "copy:assets:S3:win": "powershell -ExecutionPolicy Bypass -File scripts/copyAssetsToS3.ps1",
    "copy:content:S3": "bash scripts/copyContentToS3.sh",
    "copy:content:S3:win": "powershell -ExecutionPolicy Bypass -File scripts/copyContentToS3.ps1",
    "copy:content:S3:win:verbose": "powershell -ExecutionPolicy Bypass -File scripts/copyContentToS3.ps1 -verbose",
    "deploy:assets:S3": "pnpm copy:assets:S3",
    "deploy:assets:S3:win": "pnpm copy:assets:S3:win",
    "deploy:content:S3": "pnpm build && pnpm copy:content:S3",
    "deploy:content:S3:win": "pnpm build && pnpm copy:content:S3:win",
    "deploy:content:S3:win:verbose": "pnpm build && pnpm copy:content:S3:win:verbose",
    "analyze": "tsc -b tsconfig.app.json && react-router build --mode analyze",
    "typecheck": "tsc -b tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "@tailwindcss/vite>vite": "^8",
        "@react-router/dev>vite": "^8"
      }
    }
  },
  "dependencies": {
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-router/dev": "^7.13.1",
    "@react-router/node": "^7.13.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5",
    "lucide-react": "^0.576.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.13.1",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.0.0",
    "prettier": "^3.8.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.0",
    "vite-node": "^6.0.0",
    "vitest": "^3"
  }
}
